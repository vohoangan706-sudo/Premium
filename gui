		local function setStatus(text, color)
			statusLabel.Text = text
			statusLabel.TextColor3 = color or DIM
		end

		local function prepare(inst)
			if inst:IsA("GuiObject") then inst.Active = true end
			if inst:IsA("TextBox") then inst.TextEditable = false end
			if inst:IsA("ScrollingFrame") then inst.ScrollingEnabled = false end
		end

		local function isDesignObject(inst)
			return inst ~= nil and inst:IsDescendantOf(designRoot) and PROPS[inst.ClassName] ~= nil
		end

		---------------------------------------------------------
		-- save / history
		---------------------------------------------------------
		local function serializeNode(inst)
			local data = {}
			for _, p in ipairs(PROPS[inst.ClassName]) do
				data[p.name] = toData(p, getProp(inst, p))
			end
			local kids = {}
			for _, child in ipairs(inst:GetChildren()) do
				if PROPS[child.ClassName] then table.insert(kids, serializeNode(child)) end
			end
			return { c = inst.ClassName, n = inst.Name, p = data, k = kids }
		end

		local function snapshot()
			local list = {}
			for _, child in ipairs(designRoot:GetChildren()) do
				if PROPS[child.ClassName] then table.insert(list, serializeNode(child)) end
			end
			return HttpService:JSONEncode(list)
		end

		local function pushHistory()
			local snap = snapshot()
			if history[historyIndex] == snap then return end
			for i = #history, historyIndex + 1, -1 do history[i] = nil end
			table.insert(history, snap)
			if #history > 60 then table.remove(history, 1) end
			historyIndex = #history
		end

		local hook -- defined below

		local function buildNode(node, parent)
			if type(node) ~= "table" or not PROPS[node.c] then return nil end
			local okNew, inst = pcall(Instance.new, node.c)
			if not okNew then return nil end
			inst.Name = tostring(node.n or node.c)
			for _, p in ipairs(PROPS[node.c]) do
				local d = node.p and node.p[p.name]
				if d ~= nil then pcall(function() setProp(inst, p, fromData(p, d)) end) end
			end
			prepare(inst)
			inst.Parent = parent
			if inst:IsA("GuiObject") then hook(inst) end
			for _, childNode in ipairs(node.k or {}) do buildNode(childNode, inst) end
			return inst
		end

		local function loadSnapshot(snap)
			selected = nil
			colorTarget = nil
			for _, child in ipairs(designRoot:GetChildren()) do child:Destroy() end
			local ok, list = pcall(HttpService.JSONDecode, HttpService, snap)
			if ok and type(list) == "table" then
				for _, node in ipairs(list) do buildNode(node, designRoot) end
			end
			refreshProps()
		end

		---------------------------------------------------------
		-- colour editor
		---------------------------------------------------------
		local function loadColorEditor()
			local c = Color3.fromRGB(255, 255, 255)
			if colorTarget and colorTarget.inst.Parent then
				c = getProp(colorTarget.inst, colorTarget.prop)
			end
			local r, g, b = to255(c.R), to255(c.G), to255(c.B)
			hexBox.Text = string.format("#%02X%02X%02X", r, g, b)
			rBox.Text, gBox.Text, bBox.Text = tostring(r), tostring(g), tostring(b)
		end

		local function applyColor(c)
			if not (colorTarget and colorTarget.inst.Parent) then
				setStatus("Pick a color property first (click a color row).")
				return
			end
			setProp(colorTarget.inst, colorTarget.prop, c)
			pushHistory()
			loadColorEditor()
			refreshProps()
		end

		connect(hexBox.FocusLost, function()
			local ok, c = pcall(Color3.fromHex, hexBox.Text)
			if ok and c then applyColor(c) else loadColorEditor() end
		end)

		local function rgbFocusLost()
			local r, g, b = tonumber(rBox.Text), tonumber(gBox.Text), tonumber(bBox.Text)
			if r and g and b then
				applyColor(Color3.fromRGB(math.clamp(r, 0, 255), math.clamp(g, 0, 255), math.clamp(b, 0, 255)))
			else
				loadColorEditor()
			end
		end
		connect(rBox.FocusLost, rgbFocusLost)
		connect(gBox.FocusLost, rgbFocusLost)
