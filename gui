		local function fmtNum(n)
			if math.abs(n - math.floor(n + 0.5)) < 0.0001 then
				return tostring(math.floor(n + 0.5))
			end
			local s = string.format("%.3f", n)
			s = s:gsub("0+$", "")
			s = s:gsub("%.$", "")
			return s
		end

		local function to255(x) return math.floor(x * 255 + 0.5) end

		local function fmtValue(p, v)
			local kind = p.type
			if kind == "udim2" then
				return "{" .. fmtNum(v.X.Scale) .. ", " .. fmtNum(v.X.Offset) .. "}, {" .. fmtNum(v.Y.Scale) .. ", " .. fmtNum(v.Y.Offset) .. "}"
			elseif kind == "vector2" then
				return "{" .. fmtNum(v.X) .. ", " .. fmtNum(v.Y) .. "}"
			elseif kind == "udim" then
				return "{" .. fmtNum(v.Scale) .. ", " .. fmtNum(v.Offset) .. "}"
			elseif kind == "color" then
				return "rgb(" .. to255(v.R) .. ", " .. to255(v.G) .. ", " .. to255(v.B) .. ")"
			elseif kind == "enum" then
				return v.Name
			elseif kind == "number" then
				return fmtNum(v)
			end
			return tostring(v)
		end

		local function numbersIn(text)
			local out = {}
			for piece in tostring(text):gmatch("-?%d*%.?%d+") do
				table.insert(out, tonumber(piece))
			end
			return out
		end

		-- turns what you typed into a value; nil means "not valid"
		local function parseValue(p, text)
			local kind = p.type
			if kind == "number" then return tonumber(text) end
			if kind == "string" then return text end
			local nums = numbersIn(text)
			if kind == "udim2" and #nums == 4 then return UDim2.new(nums[1], nums[2], nums[3], nums[4]) end
			if kind == "vector2" and #nums == 2 then return Vector2.new(nums[1], nums[2]) end
			if kind == "udim" and #nums == 2 then return UDim.new(nums[1], nums[2]) end
			return nil
		end

		local function toData(p, v)
			local kind = p.type
			if kind == "udim2" then return { v.X.Scale, v.X.Offset, v.Y.Scale, v.Y.Offset } end
			if kind == "vector2" then return { v.X, v.Y } end
			if kind == "udim" then return { v.Scale, v.Offset } end
			if kind == "color" then return { to255(v.R), to255(v.G), to255(v.B) } end
			if kind == "enum" then return v.Name end
			return v
		end

		local function fromData(p, d)
			local kind = p.type
			if kind == "udim2" then return UDim2.new(d[1], d[2], d[3], d[4]) end
			if kind == "vector2" then return Vector2.new(d[1], d[2]) end
			if kind == "udim" then return UDim.new(d[1], d[2]) end
			if kind == "color" then return Color3.fromRGB(d[1], d[2], d[3]) end
			if kind == "enum" then return Enum[p.enumName][d] end
			return d
		end

