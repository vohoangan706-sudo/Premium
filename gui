		local function isPress(input)
			return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
		end

		hook = function(inst)
			connect(inst.InputBegan, function(input)
				if not isPress(input) then return end
				selectInst(inst)
				if tool == "Move" then
					drag = { kind = "move", inst = inst, start = input.Position, pos = inst.Position }
				end
			end)
		end

		connect(canvasFrame.InputBegan, function(input)
			if isPress(input) and selected then
				selectInst(nil)
			end
		end)

		local HANDLES = {
			{ 0, 0, -1, -1 }, { 0.5, 0, 0, -1 }, { 1, 0, 1, -1 }, { 0, 0.5, -1, 0 },
			{ 1, 0.5, 1, 0 }, { 0, 1, -1, 1 }, { 0.5, 1, 0, 1 }, { 1, 1, 1, 1 },
		}
		local handleFrames = {}
		for _, info in ipairs(HANDLES) do
			local handle = make("Frame", {
				Size = UDim2.fromOffset(14, 14), Position = UDim2.new(info[1], -7, info[2], -7),
				BackgroundColor3 = EDGE, BorderSizePixel = 0, ZIndex = 53, Active = true, Visible = false,
			}, selBox)
			table.insert(handleFrames, handle)
			connect(handle.InputBegan, function(input)
				local inst = selected
				if inst and not inst:IsA("GuiObject") then inst = inst.Parent end
				if isPress(input) and inst and inst:IsA("GuiObject") then
					drag = {
						kind = "resize", inst = inst, start = input.Position,
						dir = Vector2.new(info[3], info[4]), pos = inst.Position,
						abs = inst.AbsoluteSize, anchor = inst.AnchorPoint,
					}
				end
			end)
		end

		connect(UserInputService.InputChanged, function(input)
			if not drag or not drag.inst.Parent then return end
			if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
			local dx = input.Position.X - drag.start.X
			local dy = input.Position.Y - drag.start.Y
			local inst = drag.inst
			if drag.kind == "move" then
				inst.Position = UDim2.new(drag.pos.X.Scale, drag.pos.X.Offset + dx, drag.pos.Y.Scale, drag.pos.Y.Offset + dy)
			else
				local newW = math.max(4, drag.abs.X + drag.dir.X * dx)
				local newH = math.max(4, drag.abs.Y + drag.dir.Y * dy)
				local grewW = newW - drag.abs.X
				local grewH = newH - drag.abs.Y
				local px, py = drag.pos.X.Offset, drag.pos.Y.Offset
				if drag.dir.X == 1 then
					px = px + drag.anchor.X * grewW
				elseif drag.dir.X == -1 then
					px = px - (1 - drag.anchor.X) * grewW
				end
				if drag.dir.Y == 1 then
					py = py + drag.anchor.Y * grewH
				elseif drag.dir.Y == -1 then
					py = py - (1 - drag.anchor.Y) * grewH
				end
				inst.Size = UDim2.fromOffset(newW, newH)
				inst.Position = UDim2.new(drag.pos.X.Scale, px, drag.pos.Y.Scale, py)
			end
		end)

		connect(UserInputService.InputEnded, function(input)
			if drag and isPress(input) then
				drag = nil
				pushHistory()
				refreshProps()
			end
		end)

