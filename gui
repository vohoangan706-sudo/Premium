		local function P(name, kind, extra)
			local entry = { name = name, type = kind }
			if extra then
				for key, value in pairs(extra) do entry[key] = value end
			end
			return entry
		end

		local function concat(...)
			local out = {}
			for _, list in ipairs({ ... }) do
				for _, item in ipairs(list) do table.insert(out, item) end
			end
			return out
		end

