		local function addElement(class)
			local isModifier = class:sub(1, 2) == "UI"
			local parent = designRoot

			if isModifier then
				local target = selected
				if target and not target:IsA("GuiObject") then target = target.Parent end
				if not target or not target:IsA("GuiObject") then
					setStatus("Select an element first, then add " .. class .. ".", Color3.fromRGB(255, 150, 150))
					return
				end
				local existing = target:FindFirstChildOfClass(class)
				if existing then
					selectInst(existing)
					setStatus(target.Name .. " already has a " .. class .. " (selected it).")
					return
				end
				local inst = Instance.new(class)
				inst.Parent = target
				pushHistory()
				selectInst(inst)
				setStatus("Added " .. class .. " to " .. target.Name .. ".")
				return
			end

			if selected and selected.Parent then
				local target = selected
				if not target:IsA("GuiObject") then target = target.Parent end
				if target and (target:IsA("Frame") or target:IsA("ScrollingFrame")) then parent = target end
			end

			local inst = Instance.new(class)
			for key, value in pairs(DEFAULTS[class] or {}) do inst[key] = value end
			inst.BorderSizePixel = 0
			local step = (placed % 8) * 18
			if parent == designRoot then
				inst.Position = UDim2.fromOffset(30 + step, 30 + step)
			else
				inst.Position = UDim2.fromOffset(10, 10)
			end
			placed = placed + 1
			prepare(inst)
			inst.Parent = parent
			hook(inst)
			pushHistory()
			selectInst(inst)
			setStatus("Added " .. class .. ". Tools: Move to drag, Resize for handles.")
		end

