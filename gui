				end
			end)
			selectAllButton.MouseButton1Click:Connect(function()
				codeBox:CaptureFocus()
				codeBox.CursorPosition = #codeBox.Text + 1
				codeBox.SelectionStart = 1
			end)
			closeCode.MouseButton1Click:Connect(function()
				window:Destroy()
				if codeWindow == window then codeWindow = nil end
			end)
		end

		local exporting = false
		connect(exportButton.MouseButton1Click, function()
			if exporting then return end
			if countDesign() == 0 then
				setStatus("Nothing to export yet. Add a Frame first.", Color3.fromRGB(255, 150, 150))
				return
			end
			exporting = true
			exportButton.Text = "Exporting..."
			realTask.spawn(function()
				for step = 1, 20 do
					if not alive then return end
					setStatus("Exporting... " .. (step * 5) .. "%", EDGE)
					realTask.wait(0.1)
				end
				local ok, result = pcall(generateCode)
				exporting = false
				exportButton.Text = "Export"
				if not alive then return end
				if ok then
					setStatus("Exported. Copy the code from the window.", GREEN)
					showCodeWindow(result)
				else
					setStatus("Export failed: " .. tostring(result), RED)
				end
			end)
		end)

		---------------------------------------------------------
		-- test (F5), minimize, close
		---------------------------------------------------------
		local testGui = nil

		local function stopTest()
			if testGui then
				testGui:Destroy()
				testGui = nil
			end
			chip.Visible = false
			main.Visible = true
		end

		local function startTest()
			if testGui then
				stopTest()
				return
			end
			testGui = make("ScreenGui", { Name = "GuiBuilderTest", ResetOnSpawn = false, DisplayOrder = 99 }, PlayerGui)
			for _, child in ipairs(designRoot:GetChildren()) do
				if PROPS[child.ClassName] then child:Clone().Parent = testGui end
			end
			for _, inst in ipairs(testGui:GetDescendants()) do
				if inst:IsA("TextBox") then inst.TextEditable = true end
				if inst:IsA("ScrollingFrame") then inst.ScrollingEnabled = true end
			end
			main.Visible = false
			chipMode = "test"
			chip.Text = "Stop Test (F5)"
			chip.Visible = true
		end

		connect(testButton.MouseButton1Click, startTest)
		connect(UserInputService.InputBegan, function(input, processed)
			if not processed and input.KeyCode == Enum.KeyCode.F5 and alive then startTest() end
		end)

		connect(minButton.MouseButton1Click, function()
			main.Visible = false
			chipMode = "min"
			chip.Text = "GuiBuilder (open)"
			chip.Visible = true
		end)

		connect(chip.MouseButton1Click, function()
			if chipMode == "test" then
				stopTest()
			else
				chip.Visible = false
				main.Visible = true
			end
		end)

		local function destroy()
			if not alive then return end
			alive = false
			for _, connection in ipairs(connections) do connection:Disconnect() end
			if testGui then testGui:Destroy() end
			gui:Destroy()
		end

		connect(closeButton.MouseButton1Click, destroy)

		pushHistory()
		refreshProps()
		loadColorEditor()

		return { isAlive = function() return alive end, destroy = destroy, show = function() chip.Visible = false main.Visible = true end }
	end

	openGuiBuilder = function()
		if activeBuilder and activeBuilder.isAlive() then
			activeBuilder.show()
			return
		end
		local ok, result = pcall(createGuiBuilder)
		if ok then
			activeBuilder = result
		else
			emit("GuiBuilder failed to open: " .. tostring(result), RED)
		end
	end

	local function closeGuiBuilder()
		if activeBuilder then
			activeBuilder.destroy()
			activeBuilder = nil
		end
	end


	local INSTALL_LINES = {
		"Reading package lists... Done",
		"Building dependency tree... Done",
		"The following NEW packages will be installed:",
		"  guibuilder",
		"Get:1 aether://repo/main guibuilder 1.0.0 [412 kB]",
		"Fetched 412 kB in 1s (412 kB/s)",
		"Selecting previously unselected package guibuilder.",
		"Unpacking guibuilder (1.0.0) ...",
		"Setting up guibuilder (1.0.0) ...",
		"Linking export engine (LocalScript) ... OK",
		"Installation complete. Opening GuiBuilder...",
	}

	local installing = false

	local function installGuiBuilder()
		if settings.installed then
			openGuiBuilder()
			return "GuiBuilder opened."
		end
		if installing then
			return "Install already in progress."
		end
		installing = true
		realTask.spawn(function()
			for _, line in ipairs(INSTALL_LINES) do
				addLine(line, AMBER)
				realTask.wait(0.12)
			end
			settings.installed = true
			saveSettings()
			installing = false
			openGuiBuilder()
		end)
		return "Installing guibuilder..."
	end

	-- keeps your saved project; only removes the install
	local function uninstallGuiBuilder()
		if not settings.installed then
			return "GuiBuilder isn't installed."
		end
		closeGuiBuilder()
		settings.installed = nil
		saveSettings()
		return "GuiBuilder uninstalled. (Your saved project is kept.)"
	end

	-- the panel owns the `pkg` command and hands `pkg install guibuilder` to us
	if registerPackage then
		registerPackage("guibuilder", installGuiBuilder, function() return uninstallGuiBuilder() end)
	else
		commands["pkg"] = function(args)
			if tostring(args[1] or ""):lower() == "install" and tostring(args[2] or ""):lower() == "guibuilder" then
				return installGuiBuilder()
			end
			return "Usage: pkg install guibuilder"
		end
	end
end

setupGuiBuilder()