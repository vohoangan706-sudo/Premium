		---------------------------------------------------------
		-- export: design -> LocalScript code
		---------------------------------------------------------
		local LUA_KEYWORDS = {}
		for word in ("and break do else elseif end false for function if in local nil not or repeat return then true until while continue export type"):gmatch("%S+") do
			LUA_KEYWORDS[word] = true
		end

		local function quote(text)
			text = tostring(text):gsub("\\", "\\\\"):gsub("\"", "\\\""):gsub("\n", "\\n"):gsub("\r", "")
			return "\"" .. text .. "\""
		end

		local function literal(p, v)
			local kind = p.type
			if kind == "udim2" then
				return "UDim2.new(" .. fmtNum(v.X.Scale) .. ", " .. fmtNum(v.X.Offset) .. ", " .. fmtNum(v.Y.Scale) .. ", " .. fmtNum(v.Y.Offset) .. ")"
			elseif kind == "vector2" then
				return "Vector2.new(" .. fmtNum(v.X) .. ", " .. fmtNum(v.Y) .. ")"
			elseif kind == "udim" then
				return "UDim.new(" .. fmtNum(v.Scale) .. ", " .. fmtNum(v.Offset) .. ")"
			elseif kind == "color" then
				return "Color3.fromRGB(" .. to255(v.R) .. ", " .. to255(v.G) .. ", " .. to255(v.B) .. ")"
			elseif kind == "enum" then
				return "Enum." .. p.enumName .. "." .. v.Name
			elseif kind == "string" then
				return quote(v)
			elseif kind == "number" then
				return fmtNum(v)
			end
			return tostring(v)
		end

		local function countDesign()
			local count = 0
			for _, inst in ipairs(designRoot:GetDescendants()) do
				if PROPS[inst.ClassName] then count = count + 1 end
			end
			return count
		end

		local function generateCode()
			local lines = {}
			local function add(text) table.insert(lines, text) end
			local used = { Players = true, player = true, screenGui = true }
			local defaults = {}

			local function defaultFor(class)
				if not defaults[class] then defaults[class] = Instance.new(class) end
				return defaults[class]
			end

			local function varName(inst)
				local base = inst.Name:gsub("[^%w_]", "_")
				if base == "" then base = inst.ClassName end
				if base:match("^%d") then base = "_" .. base end
				if LUA_KEYWORDS[base] then base = base .. "_" end
				local name, n = base, 1
				while used[name] do
					n = n + 1
					name = base .. n
				end
				used[name] = true
				return name
			end

			local function emitInstance(inst, parentVar)
				local var = varName(inst)
				local class = inst.ClassName
				local default = defaultFor(class)
				add("local " .. var .. " = Instance.new(\"" .. class .. "\")")
				add(var .. ".Name = " .. quote(inst.Name))
				for _, p in ipairs(PROPS[class]) do
					if not p.virtual then
						local v = getProp(inst, p)
						if literal(p, v) ~= literal(p, getProp(default, p)) then
							add(var .. "." .. p.name .. " = " .. literal(p, v))
						end
					end
				end
				if class == "UIGradient" then
					local first, second = PROPS.UIGradient[1], PROPS.UIGradient[2]
					add(var .. ".Color = ColorSequence.new(" .. literal(first, getProp(inst, first)) .. ", " .. literal(second, getProp(inst, second)) .. ")")
				end
				add(var .. ".Parent = " .. parentVar)
				add("")
				for _, child in ipairs(inst:GetChildren()) do
					if PROPS[child.ClassName] then emitInstance(child, var) end
				end
			end

			add("-- Generated by Aetherfinix GuiBuilder")
			add("-- Put this in a LocalScript (for example in StarterPlayerScripts).")
			add("")
			add("local Players = game:GetService(\"Players\")")
			add("local player = Players.LocalPlayer")
			add("")
			add("local screenGui = Instance.new(\"ScreenGui\")")
			add("screenGui.Name = \"GeneratedGui\"")
			add("screenGui.ResetOnSpawn = false")
			add("screenGui.Parent = player:WaitForChild(\"PlayerGui\")")
			add("")
			for _, child in ipairs(designRoot:GetChildren()) do
				if PROPS[child.ClassName] then emitInstance(child, "screenGui") end
			end

			for _, inst in pairs(defaults) do inst:Destroy() end
			return table.concat(lines, "\n")
		end

