		refreshProps = function()
			for _, child in ipairs(propsList:GetChildren()) do
				if not child:IsA("UIListLayout") then child:Destroy() end
			end
			if not selected or not selected.Parent then
				selected = nil
				propsHeader.Text = "Properties"
				makeLabel(propsList, "Nothing selected.", UDim2.new(1, -6, 0, 24), UDim2.new(0, 4, 0, 0), DIM, 12)
				return
			end

			propsHeader.Text = selected.ClassName
			local order = 0
			local function newRow(labelText)
				order = order + 1
				local row = make("Frame", { Size = UDim2.new(1, -6, 0, 26), BackgroundTransparency = 1, LayoutOrder = order }, propsList)
				makeLabel(row, labelText, UDim2.new(0.45, -2, 1, 0), UDim2.new(0, 2, 0, 0), TEXT, 12)
				return row
			end
			local function controlBox(row, text)
				return makeBox(row, UDim2.new(0.55, -2, 1, -2), UDim2.new(0.45, 0, 0, 1), text)
			end

			-- name
			local nameRow = newRow("Name")
			local nameBox = controlBox(nameRow, selected.Name)
			local target = selected
			connect(nameBox.FocusLost, function()
				if target.Parent and nameBox.Text ~= "" then
					target.Name = nameBox.Text
					pushHistory()
					refreshProps()
				end
			end)

			for _, p in ipairs(PROPS[selected.ClassName]) do
				local inst = selected
				local value = getProp(inst, p)
				local row = newRow(p.name)
				if p.type == "bool" then
					local toggle = makeButton(row, tostring(value), { Size = UDim2.new(0.55, -2, 1, -2), AutomaticSize = Enum.AutomaticSize.None, TextSize = 12, Color = value and FIELD_ON or FIELD })
					toggle.Position = UDim2.new(0.45, 0, 0, 1)
					connect(toggle.MouseButton1Click, function()
						setProp(inst, p, not getProp(inst, p))
						pushHistory()
						refreshProps()
					end)
				elseif p.type == "enum" then
					local cycle = makeButton(row, value.Name, { Size = UDim2.new(0.55, -2, 1, -2), AutomaticSize = Enum.AutomaticSize.None, TextSize = 12 })
					cycle.Position = UDim2.new(0.45, 0, 0, 1)
					connect(cycle.MouseButton1Click, function()
						local index = table.find(p.list, getProp(inst, p).Name) or 0
						index = index % #p.list + 1
						setProp(inst, p, Enum[p.enumName][p.list[index]])
						pushHistory()
						refreshProps()
					end)
				elseif p.type == "color" then
					local chosen = colorTarget and colorTarget.inst == inst and colorTarget.prop == p
					local swatch = make("TextButton", {
						Text = "", Size = UDim2.new(0, 24, 0, 20), Position = UDim2.new(0.45, 0, 0.5, -10),
						BackgroundColor3 = value, BorderSizePixel = 0, AutoButtonColor = false,
					}, row)
					round(swatch, 4)
					if chosen then make("UIStroke", { Color = EDGE, Thickness = 2 }, swatch) end
					local text = make("TextButton", {
						Text = fmtValue(p, value), Size = UDim2.new(0.55, -30, 1, -2), Position = UDim2.new(0.45, 28, 0, 1),
						BackgroundTransparency = 1, TextColor3 = TEXT, Font = Enum.Font.Code, TextSize = 11,
						TextXAlignment = Enum.TextXAlignment.Left,
					}, row)
					local function pick()
						colorTarget = { inst = inst, prop = p }
						loadColorEditor()
						refreshProps()
					end
					connect(swatch.MouseButton1Click, pick)
					connect(text.MouseButton1Click, pick)
				else
					local box = controlBox(row, fmtValue(p, value))
					connect(box.FocusLost, function()
						if not inst.Parent then return end
						local parsed = parseValue(p, box.Text)
						if parsed ~= nil then
							local ok = pcall(setProp, inst, p, parsed)
							if ok then pushHistory() end
						end
						refreshProps()
					end)
				end
			end

			-- children
			local kids = {}
			for _, child in ipairs(selected:GetChildren()) do
				if PROPS[child.ClassName] then table.insert(kids, child) end
			end
			if #kids > 0 then
				local header = newRow("Children (" .. #kids .. ")")
				header.Size = UDim2.new(1, -6, 0, 22)
				for _, child in ipairs(kids) do
					order = order + 1
					local childButton = makeButton(propsList, child.ClassName .. "  " .. child.Name, {
						Size = UDim2.new(1, -6, 0, 22), AutomaticSize = Enum.AutomaticSize.None, TextSize = 12, LayoutOrder = order,
					})
					childButton.TextXAlignment = Enum.TextXAlignment.Left
					connect(childButton.MouseButton1Click, function() selectInst(child) end)
				end
			end
		end

