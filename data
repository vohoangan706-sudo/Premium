		local propsScroll = makeScroll(right, UDim2.new(1, -8, 1, -88), UDim2.new(0, 4, 0, 64))
		make("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, propsScroll)
		local propsStatus = makeLabel(right, "", UDim2.new(1, -12, 0, 18), UDim2.new(0, 6, 1, -22), DIM, 11)

		local rebuildTree, refreshProps

		local function setPropsStatus(text, color)
			propsStatus.Text = text
			propsStatus.TextColor3 = color or DIM
		end

		local function hasChildren(inst)
			local ok, kids = pcall(inst.GetChildren, inst)
			return ok and #kids > 0
		end

		local function flatten(inst, depth, out)
			if #out >= MAX_ROWS then return end
			table.insert(out, { inst = inst, depth = depth })
			if expanded[inst] then
				local ok, kids = pcall(inst.GetChildren, inst)
				if ok then
					for index, kid in ipairs(kids) do
						if index > MAX_KIDS then
							table.insert(out, { more = #kids - MAX_KIDS, depth = depth + 1 })
							break
						end
						flatten(kid, depth + 1, out)
					end
				end
			end
		end

		local function selectNode(inst)
			selectedInst = inst
			refreshProps()
			rebuildTree()
		end

		local function passes(inst, query)
			local filter = FILTERS[filterIndex][2]
			if filter then
				local ok, result = pcall(filter, inst)
				if not (ok and result) then return false end
			end
			if query == "" then return true end
			local okName, name = pcall(function() return inst.Name:lower() end)
			if okName and name:find(query, 1, true) then return true end
			local okClass, class = pcall(function() return inst.ClassName:lower() end)
			return okClass and class:find(query, 1, true) ~= nil
		end

		rebuildTree = function()
			for _, child in ipairs(treeScroll:GetChildren()) do
				if not child:IsA("UIListLayout") then child:Destroy() end
			end
			local root = ROOTS[rootIndex]
			local rows = {}
			local query = searchBox.Text:lower()
			local flat = query ~= "" or filterIndex > 1

			if flat then
				local capped = false
				for _, inst in ipairs(root.descendants()) do
					if passes(inst, query) then
						table.insert(rows, { inst = inst, depth = 0, flat = true })
						if #rows >= MAX_RESULTS then
							capped = true
							break
						end
					end
				end
				treeStatus.Text = #rows .. " result(s) in " .. root.label .. (capped and (" (first " .. MAX_RESULTS .. ")") or "")
			else
				local kids = root.children()
				for index, kid in ipairs(kids) do
					if index > MAX_KIDS then
						table.insert(rows, { more = #kids - MAX_KIDS, depth = 0 })
						break
					end
					flatten(kid, 0, rows)
				end
				treeStatus.Text = root.label .. ": " .. #kids .. " top-level, " .. #rows .. " row(s) shown"
			end

			for index, row in ipairs(rows) do
				local line = make("Frame", { Size = UDim2.new(0, 620, 0, 22), BackgroundTransparency = 1, LayoutOrder = index }, treeScroll)
				if row.more then
					makeLabel(line, "... " .. row.more .. " more (use search)", UDim2.new(1, 0, 1, 0), UDim2.new(0, 10 + row.depth * 14, 0, 0), DIM, 12)
				else
					local inst = row.inst
					local indent = row.depth * 14
					if not row.flat and hasChildren(inst) then
						local arrow = makeButton(line, expanded[inst] and "-" or "+", {
							Size = UDim2.new(0, 20, 0, 20), AutomaticSize = Enum.AutomaticSize.None, TextSize = 12,
						})
						arrow.Position = UDim2.new(0, indent, 0, 1)
						arrow.MouseButton1Click:Connect(function()
							expanded[inst] = not expanded[inst]
							rebuildTree()
						end)
					end
					makeIcon(line, inst, UDim2.new(0, indent + 24, 0, 3))
					local isSelected = inst == selectedInst
					local text = inst.Name .. "  [" .. inst.ClassName .. "]"
					if row.flat then
						local okParent, parentName = pcall(function() return inst.Parent and inst.Parent.Name or "nil" end)
						text = text .. "  in " .. (okParent and parentName or "?")
					end
					local label = make("TextButton", {
						Size = UDim2.new(1, -(indent + 52), 1, 0), Position = UDim2.new(0, indent + 52, 0, 0),
						BackgroundColor3 = FIELD_ON, BackgroundTransparency = isSelected and 0 or 1, BorderSizePixel = 0,
						Text = text, TextColor3 = isSelected and TEXT or (REMOTE_CLASSES[inst.ClassName] and Color3.fromRGB(255, 150, 90) or AMBER),
						Font = Enum.Font.Code, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
					}, line)
					label.MouseButton1Click:Connect(function() selectNode(inst) end)
				end
			end
		end

		-- waits a moment after typing so big games don't stall on every key
		local function scheduleRebuild()
			searchToken = searchToken + 1
			local token = searchToken
			task.delay(0.45, function()
				if token == searchToken and win.frame.Parent then rebuildTree() end
			end)
		end

		local function propRow(name, value, order, inst, readOnly)
			local row = make("Frame", { Size = UDim2.new(1, -6, 0, 24), BackgroundTransparency = 1, LayoutOrder = order }, propsScroll)
			makeLabel(row, name, UDim2.new(0.38, -2, 1, 0), UDim2.new(0, 2, 0, 0), TEXT, 12)
			local kind = type(value)
			if readOnly or name == "ClassName" or name == "Parent" or (kind ~= "string" and kind ~= "number" and kind ~= "boolean") then
				makeLabel(row, tostring(value), UDim2.new(0.62, -4, 1, 0), UDim2.new(0.38, 0, 0, 0), DIM, 12)
			elseif kind == "boolean" then
				local toggle = makeButton(row, tostring(value), {
					Size = UDim2.new(0.62, -4, 1, -2), AutomaticSize = Enum.AutomaticSize.None, TextSize = 12,
					Color = value and FIELD_ON or FIELD,
				})
				toggle.Position = UDim2.new(0.38, 0, 0, 1)
				toggle.MouseButton1Click:Connect(function()
					local ok, err = pcall(function() inst[name] = not value end)
					if not ok then setPropsStatus(tostring(err), RED) end
					refreshProps()
				end)
			else
				local box = makeBox(row, UDim2.new(0.62, -4, 1, -2), UDim2.new(0.38, 0, 0, 1), tostring(value))
				box.TextSize = 12
				box.FocusLost:Connect(function()
					local newValue = box.Text
					if kind == "number" then newValue = tonumber(newValue) end
					if newValue == nil then
						refreshProps()
						return
					end
					local ok, err = pcall(function() inst[name] = newValue end)
					if ok then
						setPropsStatus("Set " .. name .. ".", GREEN)
					else
						setPropsStatus(tostring(err), RED)
					end
					refreshProps()
					rebuildTree()
				end)
			end
		end

		refreshProps = function()
			for _, child in ipairs(propsScroll:GetChildren()) do
				if not child:IsA("UIListLayout") then child:Destroy() end
			end
			local inst = selectedInst
			if not inst or not inst.Parent then
				selectedInst = nil
				pathBox.Text = ""
				return
			end
			pathBox.Text = pathOf(inst)
			local order = 0
			for _, name in ipairs(CANDIDATE_PROPS) do
				local ok, value = pcall(function() return inst[name] end)
				if ok and value ~= nil then
					order = order + 1
					if name == "Parent" then value = value:GetFullName() end
					propRow(name, value, order, inst)
				end
			end

			-- extra info
			local okKids, kids = pcall(inst.GetChildren, inst)
			if okKids then
				order = order + 1
				propRow("Children", #kids, order, inst, true)
			end
			local okDesc, descendants = pcall(inst.GetDescendants, inst)
			if okDesc then
				order = order + 1
				propRow("Descendants", #descendants, order, inst, true)
			end
			local okAttr, attributes = pcall(inst.GetAttributes, inst)
			if okAttr then
				local list = {}
				for key, value in pairs(attributes) do table.insert(list, key .. "=" .. tostring(value)) end
				table.sort(list)
				order = order + 1
				propRow("Attributes", #list > 0 and table.concat(list, ", ") or "(none)", order, inst, true)
			end
			local okTags, tags = pcall(CollectionService.GetTags, CollectionService, inst)
			if okTags then
				order = order + 1
				propRow("Tags", #tags > 0 and table.concat(tags, ", ") or "(none)", order, inst, true)
			end
			if REMOTE_CLASSES[inst.ClassName] then
				order = order + 1
				propRow("Note", "Remote/Bindable: copy its path to use it in your own scripts", order, inst, true)
			end
		end

		rootButton.MouseButton1Click:Connect(function()
			rootIndex = rootIndex % #ROOTS + 1
			rootButton.Text = "Root: " .. ROOTS[rootIndex].label
			selectedInst = nil
			refreshProps()
			rebuildTree()
		end)
		filterButton.MouseButton1Click:Connect(function()
			filterIndex = filterIndex % #FILTERS + 1
			filterButton.Text = "Show: " .. FILTERS[filterIndex][1]
			rebuildTree()
		end)
		searchBox:GetPropertyChangedSignal("Text"):Connect(scheduleRebuild)

		pickButton.MouseButton1Click:Connect(function()
			startPick(function(inst)
				if not win.frame.Parent then return end
				front(win)
				searchBox.Text = ""
				filterIndex = 1
				filterButton.Text = "Show: All"
				rootIndex = 1
				rootButton.Text = "Root: " .. ROOTS[1].label
				local parent = inst.Parent
				while parent and parent ~= game do
					expanded[parent] = true
					parent = parent.Parent
				end
				selectedInst = inst
				refreshProps()
				rebuildTree()
				setPropsStatus("Picked " .. inst.Name .. ".", GREEN)
			end)
		end)

		copyPathButton.MouseButton1Click:Connect(function()
			if not selectedInst then return end
			if copyText(pathOf(selectedInst)) then
				setPropsStatus("Path copied.", GREEN)
			else
				setPropsStatus("No clipboard here: tap the path box and copy it.", RED)
			end
		end)

		upButton.MouseButton1Click:Connect(function()
			if selectedInst and selectedInst.Parent and selectedInst.Parent ~= game then
				local parent = selectedInst.Parent
				expanded[parent] = true
				selectNode(parent)
			end
		end)

		gotoButton.MouseButton1Click:Connect(function()
			local inst = selectedInst
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if not (inst and hrp) then return end
			local ok, err = pcall(function()
				if inst:IsA("BasePart") then
					hrp.CFrame = inst.CFrame + Vector3.new(0, 5, 0)
				elseif inst:IsA("Model") then
					hrp.CFrame = inst:GetPivot() + Vector3.new(0, 5, 0)
				else
					error("only parts and models can be teleported to")
				end
			end)
			setPropsStatus(ok and "Teleported." or tostring(err), ok and GREEN or RED)
		end)

		local deleteArmed = false
		deleteButton.MouseButton1Click:Connect(function()
			if not selectedInst then return end
			if not deleteArmed then
				deleteArmed = true
				deleteButton.Text = "Sure?"
				task.delay(3, function()
					deleteArmed = false
					if deleteButton.Parent then deleteButton.Text = "Delete" end
				end)
				return
			end
			deleteArmed = false
			deleteButton.Text = "Delete"
			local ok, err = pcall(function() selectedInst:Destroy() end)
			selectedInst = nil
			setPropsStatus(ok and "Deleted (on your client)." or tostring(err), ok and GREEN or RED)
			refreshProps()
			rebuildTree()
		end)

		rebuildTree()
	end

