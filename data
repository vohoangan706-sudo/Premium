-- ======================================================================
--  Dataview  (standalone package for the Aetherfinix panel)
--  Host this file (raw URL) and put the URL in the panel's
--  PACKAGE_URLS.dataview slot. Then type:  pkg install dataview
--  After installing, these work in the {} editor:
--      Dv.Scripthub()   -- saved scripts: write, save, run, fetch from a URL
--      Dv.Explorer()    -- browse the game's instances and edit properties
--      Dv.Note()        -- notes (Dv.Note("quick text") adds one directly)
--      Dv.Close()       -- closes all Dataview windows
--  Running this file by itself does nothing: the panel loads it.
-- ======================================================================
local context = ...
if type(context) ~= "table" then
	warn("Dataview must be loaded by the Aetherfinix panel.")
	return
end

local player = context.player
local addLine = context.addLine
local commands = context.commands
local linuxHooks = context.linuxHooks
local registerPackage = context.registerPackage

local HttpService = game:GetService("HttpService")
local UserInputService = game:GetService("UserInputService")

local AMBER = Color3.fromRGB(255, 200, 0)
local BRIGHT = Color3.fromRGB(255, 220, 120)
local GREEN = Color3.fromRGB(150, 255, 150)
local RED = Color3.fromRGB(255, 150, 150)

-- everything Dataview saves (scripts, notes) lives in its own small file
local SETTINGS_FILE = "AetherfinixDataview.json"
local settings = {}
local canPersist = (type(writefile) == "function" and type(readfile) == "function")

if canPersist then
	local ok, raw = pcall(function()
		if type(isfile) == "function" and not isfile(SETTINGS_FILE) then return nil end
		return readfile(SETTINGS_FILE)
	end)
	if ok and type(raw) == "string" and raw ~= "" then
		local decoded, data = pcall(HttpService.JSONDecode, HttpService, raw)
		if decoded and type(data) == "table" then settings = data end
	end
end
if type(settings.scripts) ~= "table" then settings.scripts = {} end
if type(settings.notes) ~= "table" then settings.notes = {} end

local function saveSettings()
	if not canPersist then return end
	pcall(function() writefile(SETTINGS_FILE, HttpService:JSONEncode(settings)) end)
end

local function setupDataview()
	local PlayerGui = player:WaitForChild("PlayerGui")

	local BG = Color3.fromRGB(14, 14, 14)
	local PANEL = Color3.fromRGB(22, 20, 12)
	local EDGE = Color3.fromRGB(255, 200, 0)
	local TEXT = Color3.fromRGB(240, 235, 215)
	local DIM = Color3.fromRGB(150, 140, 110)
	local FIELD = Color3.fromRGB(38, 33, 16)
	local FIELD_ON = Color3.fromRGB(120, 90, 0)

	---------------------------------------------------------------
	-- small UI helpers
	---------------------------------------------------------------
	local function make(class, props, parent)
		local inst = Instance.new(class)
		for key, value in pairs(props) do inst[key] = value end
		inst.Parent = parent
		return inst
	end

	local function round(inst, radius)
		make("UICorner", { CornerRadius = UDim.new(0, radius or 4) }, inst)
	end

	local function makeButton(parent, text, props)
		props = props or {}
		local b = make("TextButton", {
			Size = props.Size or UDim2.new(0, 0, 0, 28),
			AutomaticSize = props.AutomaticSize or Enum.AutomaticSize.X,
			BackgroundColor3 = props.Color or FIELD,
			TextColor3 = TEXT, Font = Enum.Font.Code, TextSize = props.TextSize or 13,
			Text = text, BorderSizePixel = 0, LayoutOrder = props.LayoutOrder or 0,
		}, parent)
		round(b, 5)
		make("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, b)
		return b
	end

	local function makeBox(parent, size, position, text)
		local box = make("TextBox", {
			Size = size, Position = position, BackgroundColor3 = FIELD, TextColor3 = TEXT,
			PlaceholderColor3 = DIM, Font = Enum.Font.Code, TextSize = 13, ClearTextOnFocus = false,
			Text = text or "", TextXAlignment = Enum.TextXAlignment.Left, BorderSizePixel = 0,
		}, parent)
		round(box, 4)
		make("UIPadding", { PaddingLeft = UDim.new(0, 6) }, box)
		return box
	end

	local function makeLabel(parent, text, size, position, color, textSize)
		return make("TextLabel", {
			Size = size, Position = position, BackgroundTransparency = 1, Text = text,
			TextColor3 = color or TEXT, Font = Enum.Font.Code, TextSize = textSize or 13,
			TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
		}, parent)
	end

	local function makePanel(parent, size, position)
		local frame = make("Frame", { Size = size, Position = position, BackgroundColor3 = PANEL, BorderSizePixel = 0 }, parent)
		round(frame, 6)
		make("UIStroke", { Color = EDGE, Thickness = 1, Transparency = 0.5 }, frame)
		return frame
	end

	local function makeScroll(parent, size, position, direction)
		return make("ScrollingFrame", {
			Size = size, Position = position, BackgroundTransparency = 1, BorderSizePixel = 0,
			ScrollBarThickness = 4, CanvasSize = UDim2.new(0, 0, 0, 0),
			AutomaticCanvasSize = direction or Enum.AutomaticSize.Y,
		}, parent)
	end

	local function isPress(input)
		return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
	end

	local function joinArgs(...)
		local parts = {}
		for i = 1, select("#", ...) do parts[i] = tostring((select(i, ...))) end
		return table.concat(parts, "\t")
	end

	local function copyText(text)
		return type(setclipboard) == "function" and pcall(setclipboard, text)
	end

	---------------------------------------------------------------
	-- windows: every Dataview app fills the screen; "-" sends it to a
	-- small dock at the bottom, tap its chip to bring it back
	---------------------------------------------------------------
	local gui = nil
	local dock = nil
	local windows = {}
	local zCounter = 10

	local function getGui()
		if gui and gui.Parent then return gui end
		gui = make("ScreenGui", { Name = "AetherDataview", ResetOnSpawn = false, DisplayOrder = 90, ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, PlayerGui)
		return gui
	end

	local function getDock()
		getGui()
		if dock and dock.Parent then return dock end
		dock = make("Frame", {
			Name = "Dock", Size = UDim2.new(0, 0, 0, 30), AutomaticSize = Enum.AutomaticSize.X,
			AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -6),
			BackgroundTransparency = 1, ZIndex = 100000, Visible = false,
		}, gui)
		make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, dock)
		return dock
	end

	local function updateDock()
		if not (dock and dock.Parent) then return end
		local count = 0
		for _, child in ipairs(dock:GetChildren()) do
			if child:IsA("TextButton") then count = count + 1 end
		end
		dock.Visible = count > 0
	end

	local function front(win)
		zCounter = zCounter + 1
		win.frame.ZIndex = zCounter
	end

	local function createWindow(key, title)
		local frame = make("Frame", {
			Name = key, Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = BG, BorderSizePixel = 0, Active = true,
		}, getGui())
		make("UIStroke", { Color = EDGE, Thickness = 1.5 }, frame)

		local bar = make("Frame", { Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = Color3.fromRGB(40, 30, 0), BorderSizePixel = 0, Active = true }, frame)
		makeLabel(bar, title, UDim2.new(1, -80, 1, 0), UDim2.new(0, 10, 0, 0), EDGE, 14)

		local minButton = makeButton(bar, "-", { Size = UDim2.new(0, 28, 0, 22), AutomaticSize = Enum.AutomaticSize.None })
		minButton.Position = UDim2.new(1, -66, 0, 4)
		local closeButton = makeButton(bar, "X", { Size = UDim2.new(0, 28, 0, 22), AutomaticSize = Enum.AutomaticSize.None, Color = Color3.fromRGB(110, 35, 10) })
		closeButton.Position = UDim2.new(1, -34, 0, 4)

		local body = make("Frame", { Size = UDim2.new(1, 0, 1, -30), Position = UDim2.new(0, 0, 0, 30), BackgroundTransparency = 1 }, frame)

		local win = { frame = frame, body = body, key = key, chip = nil }
		windows[key] = win
		front(win)

		frame.InputBegan:Connect(function(input)
			if isPress(input) then front(win) end
		end)

		minButton.MouseButton1Click:Connect(function()
			frame.Visible = false
			if win.chip then win.chip:Destroy() end
			win.chip = makeButton(getDock(), title, { Color = FIELD_ON })
			win.chip.MouseButton1Click:Connect(function()
				win.chip:Destroy()
				win.chip = nil
				frame.Visible = true
				front(win)
				updateDock()
			end)
			updateDock()
		end)

		function win.close()
			windows[key] = nil
			if win.chip then win.chip:Destroy() end
			frame:Destroy()
			updateDock()
		end
		closeButton.MouseButton1Click:Connect(win.close)
		return win
	end

	local stopPick = nil

	local function closeAll()
		if stopPick then stopPick() end
		local list = {}
		for _, win in pairs(windows) do table.insert(list, win) end
		for _, win in ipairs(list) do win.close() end
	end

	---------------------------------------------------------------
	-- PICK MODE: hides every ScreenGui (this panel included), shows a
	-- blue box (mouse) or crosshair (touch); press anything to select it
	---------------------------------------------------------------
	local function startPick(onPicked)
		if stopPick then stopPick() end

		local hidden = {}
		local function hide(g)
			local ok, was = pcall(function() return g.Enabled end)
			if ok and was then
				table.insert(hidden, g)
				pcall(function() g.Enabled = false end)
			end
		end
		for _, child in ipairs(PlayerGui:GetChildren()) do
			if child:IsA("ScreenGui") then hide(child) end
		end
		if context.screenGui and context.screenGui:IsA("ScreenGui") then hide(context.screenGui) end

		local BLUE = Color3.fromRGB(60, 150, 255)
		local isMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
		local overlay = make("ScreenGui", {
			Name = "AetherPick", ResetOnSpawn = false, DisplayOrder = 2000000, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		}, PlayerGui)

		local capture = make("TextButton", {
			Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Active = true, ZIndex = 1,
		}, overlay)

		-- top bar: what is under the pointer + cancel
		local topBar = make("Frame", {
			Size = UDim2.new(1, -120, 0, 30), Position = UDim2.new(0, 60, 0, 6), BackgroundColor3 = BG,
			BackgroundTransparency = 0.15, BorderSizePixel = 0, ZIndex = 5,
		}, overlay)
		round(topBar, 6)
		make("UIStroke", { Color = BLUE, Thickness = 1.5 }, topBar)
		local info = makeLabel(topBar, isMobile and "Drag the crosshair, lift to select" or "Click a part to select it (Esc cancels)", UDim2.new(1, -90, 1, 0), UDim2.new(0, 8, 0, 0), TEXT, 12)
		info.ZIndex = 6
		local cancelButton = makeButton(topBar, "Cancel", { Size = UDim2.new(0, 70, 0, 22), AutomaticSize = Enum.AutomaticSize.None, TextSize = 12, Color = Color3.fromRGB(110, 35, 10) })
		cancelButton.Position = UDim2.new(1, -76, 0, 4)
		cancelButton.ZIndex = 6

		-- pointer: small blue box on PC, crosshair on touch
		local pointer = make("Frame", {
			Size = UDim2.new(0, 28, 0, 28), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1,
			Position = UDim2.new(0.5, 0, 0.5, 0), ZIndex = 4,
		}, overlay)
		if isMobile then
			local ring = make("Frame", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, ZIndex = 4 }, pointer)
			round(ring, 14)
			make("UIStroke", { Color = BLUE, Thickness = 2 }, ring)
			make("Frame", { Size = UDim2.new(0, 2, 0, 44), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), BackgroundColor3 = BLUE, BorderSizePixel = 0, ZIndex = 4 }, pointer)
			make("Frame", { Size = UDim2.new(0, 44, 0, 2), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), BackgroundColor3 = BLUE, BorderSizePixel = 0, ZIndex = 4 }, pointer)
		else
			pointer.Size = UDim2.new(0, 16, 0, 16)
			pointer.BackgroundTransparency = 0.7
			pointer.BackgroundColor3 = BLUE
			make("UIStroke", { Color = BLUE, Thickness = 2 }, pointer)
		end

		local box = make("SelectionBox", {
			Color3 = BLUE, LineThickness = 0.05, SurfaceColor3 = BLUE, SurfaceTransparency = 0.8,
		}, overlay)

		local target = nil
		local keyConnection = nil

		local function targetAt(pos)
			local camera = workspace.CurrentCamera
			if not camera then return nil end
			local ray = camera:ScreenPointToRay(pos.X, pos.Y)
			local ok, result = pcall(function() return workspace:Raycast(ray.Origin, ray.Direction * 5000) end)
			return ok and result and result.Instance or nil
		end

		local function moveTo(pos)
			pointer.Position = UDim2.new(0, pos.X, 0, pos.Y)
			target = targetAt(pos)
			box.Adornee = target
			if target then
				info.Text = target.Name .. "  [" .. target.ClassName .. "]"
			else
				info.Text = "Nothing here"
			end
		end

		local function stop()
			stopPick = nil
			if keyConnection then keyConnection:Disconnect() keyConnection = nil end
			for _, g in ipairs(hidden) do
				if g.Parent then pcall(function() g.Enabled = true end) end
			end
			overlay:Destroy()
		end
		stopPick = stop

		local function finish(pos)
			moveTo(pos)
			local hit = target
			if not hit then return end
			stop()
			onPicked(hit)
		end

		capture.InputChanged:Connect(function(input)
			local kind = input.UserInputType
			if kind == Enum.UserInputType.MouseMovement or kind == Enum.UserInputType.Touch then
				moveTo(Vector2.new(input.Position.X, input.Position.Y))
			end
		end)
		capture.InputBegan:Connect(function(input)
			local kind = input.UserInputType
			local pos = Vector2.new(input.Position.X, input.Position.Y)
			if kind == Enum.UserInputType.Touch then
				moveTo(pos)
			elseif kind == Enum.UserInputType.MouseButton1 then
				finish(pos)
			end
		end)
		capture.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch then
				finish(Vector2.new(input.Position.X, input.Position.Y))
			end
		end)
		cancelButton.MouseButton1Click:Connect(stop)
		keyConnection = UserInputService.InputBegan:Connect(function(input, processed)
			if input.KeyCode == Enum.KeyCode.Escape then stop() end
		end)

		-- start the pointer in the middle of the screen
		local size = overlay.AbsoluteSize
		moveTo(Vector2.new(size.X / 2, size.Y / 2))
	end

	---------------------------------------------------------------
	-- SCRIPTHUB
	---------------------------------------------------------------
	local function openScripthub()
		if windows.scripthub then front(windows.scripthub) return end
		local win = createWindow("scripthub", "Dataview - Scripthub")
		local body = win.body
		local scripts = settings.scripts
		local current = nil

		-- left: list
		local left = makePanel(body, UDim2.new(0.3, -6, 1, -8), UDim2.new(0, 4, 0, 4))
		local searchBox = makeBox(left, UDim2.new(1, -12, 0, 24), UDim2.new(0, 6, 0, 6), "")
		searchBox.PlaceholderText = "Search scripts..."
		local listScroll = makeScroll(left, UDim2.new(1, -8, 1, -76), UDim2.new(0, 4, 0, 34))
		make("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }, listScroll)
		local newButton = makeButton(left, "+ New script", { Size = UDim2.new(1, -12, 0, 28), AutomaticSize = Enum.AutomaticSize.None })
		newButton.Position = UDim2.new(0, 6, 1, -34)

		-- right: editor
		local right = make("Frame", { Size = UDim2.new(0.7, -4, 1, -8), Position = UDim2.new(0.3, 0, 0, 4), BackgroundTransparency = 1 }, body)
		local nameBox = makeBox(right, UDim2.new(1, 0, 0, 26), UDim2.new(0, 0, 0, 0), "")
		nameBox.PlaceholderText = "Script name"
		local urlBox = makeBox(right, UDim2.new(1, -66, 0, 26), UDim2.new(0, 0, 0, 30), "")
		urlBox.PlaceholderText = "Paste a raw URL to fetch a script..."
		local fetchButton = makeButton(right, "Fetch", { Size = UDim2.new(0, 60, 0, 26), AutomaticSize = Enum.AutomaticSize.None })
		fetchButton.Position = UDim2.new(1, -60, 0, 30)

		local editorFrame = make("ScrollingFrame", {
			Size = UDim2.new(1, 0, 1, -184), Position = UDim2.new(0, 0, 0, 60),
			BackgroundColor3 = Color3.fromRGB(10, 9, 5), BorderSizePixel = 0, ScrollBarThickness = 5,
			CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.XY,
			ScrollingDirection = Enum.ScrollingDirection.XY,
		}, right)
		round(editorFrame, 4)
		local editor = make("TextBox", {
			Size = UDim2.new(1, 0, 0, 200), AutomaticSize = Enum.AutomaticSize.XY, BackgroundTransparency = 1,
			TextColor3 = AMBER, Font = Enum.Font.Code, TextSize = 14, MultiLine = true, TextWrapped = false,
			ClearTextOnFocus = false, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
			PlaceholderText = "-- write or paste Lua here", PlaceholderColor3 = DIM, Text = "",
		}, editorFrame)
		make("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingTop = UDim.new(0, 4) }, editor)

		local outFrame = make("ScrollingFrame", {
			Size = UDim2.new(1, 0, 0, 80), Position = UDim2.new(0, 0, 1, -118),
			BackgroundColor3 = Color3.fromRGB(10, 9, 5), BorderSizePixel = 0, ScrollBarThickness = 4,
			CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		}, right)
		round(outFrame, 4)
		make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, outFrame)

		local buttonRow = make("Frame", { Size = UDim2.new(1, 0, 0, 30), Position = UDim2.new(0, 0, 1, -32), BackgroundTransparency = 1 }, right)
		make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 5), VerticalAlignment = Enum.VerticalAlignment.Center }, buttonRow)
		local saveButton = makeButton(buttonRow, "Save", { Color = FIELD_ON })
		local runButton = makeButton(buttonRow, "Run", { Color = FIELD_ON })
		local copyButton = makeButton(buttonRow, "Copy")
		local deleteButton = makeButton(buttonRow, "Delete", { Color = Color3.fromRGB(110, 35, 10) })

		local outCount = 0
		local function addOut(text, color)
			outCount = outCount + 1
			make("TextLabel", {
				Size = UDim2.new(1, -6, 0, 16), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
				Text = tostring(text), TextColor3 = color or AMBER, Font = Enum.Font.Code, TextSize = 12,
				TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = outCount,
			}, outFrame)
			local rows = {}
			for _, child in ipairs(outFrame:GetChildren()) do
				if child:IsA("TextLabel") then table.insert(rows, child) end
			end
			if #rows > 80 then rows[1]:Destroy() end
			outFrame.CanvasPosition = Vector2.new(0, 1e6)
		end

		local function refreshList()
			for _, child in ipairs(listScroll:GetChildren()) do
				if child:IsA("TextButton") then child:Destroy() end
			end
			local query = searchBox.Text:lower()
			for index, script in ipairs(scripts) do
				if query == "" or script.name:lower():find(query, 1, true) then
					local row = makeButton(listScroll, script.name, {
						Size = UDim2.new(1, -6, 0, 26), AutomaticSize = Enum.AutomaticSize.None,
						LayoutOrder = index, Color = (index == current) and FIELD_ON or FIELD,
					})
					row.TextXAlignment = Enum.TextXAlignment.Left
					row.MouseButton1Click:Connect(function()
						current = index
						nameBox.Text = script.name
						editor.Text = script.code
						refreshList()
					end)
				end
			end
		end

		searchBox:GetPropertyChangedSignal("Text"):Connect(refreshList)

		newButton.MouseButton1Click:Connect(function()
			current = nil
			nameBox.Text = ""
			editor.Text = ""
			refreshList()
		end)

		saveButton.MouseButton1Click:Connect(function()
			local name = nameBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
			if name == "" then name = "Untitled" end
			if current and scripts[current] then
				scripts[current].name = name
				scripts[current].code = editor.Text
			else
				table.insert(scripts, { name = name, code = editor.Text })
				current = #scripts
			end
			saveSettings()
			refreshList()
			addOut("Saved '" .. name .. "'" .. (canPersist and "." or " (memory only: no writefile)."), GREEN)
		end)

		deleteButton.MouseButton1Click:Connect(function()
			if current and scripts[current] then
				local name = scripts[current].name
				table.remove(scripts, current)
				current = nil
				nameBox.Text = ""
				editor.Text = ""
				saveSettings()
				refreshList()
				addOut("Deleted '" .. name .. "'.", BRIGHT)
			end
		end)

		copyButton.MouseButton1Click:Connect(function()
			if copyText(editor.Text) then
				addOut("Copied to clipboard.", GREEN)
			else
				addOut("No clipboard here: select the text in the editor and copy it.", RED)
			end
		end)

		fetchButton.MouseButton1Click:Connect(function()
			local url = urlBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
			if url == "" then return end
			addOut("Fetching...", BRIGHT)
			task.spawn(function()
				local ok, result = pcall(function() return game:HttpGet(url) end)
				if ok and type(result) == "string" then
					editor.Text = result
					if nameBox.Text == "" then nameBox.Text = url:match("([^/]+)$") or "Fetched script" end
					addOut("Fetched " .. #result .. " characters. Press Save to keep it.", GREEN)
				else
					addOut("Fetch failed: " .. tostring(result), RED)
				end
			end)
		end)

		runButton.MouseButton1Click:Connect(function()
			local code = editor.Text
			if not code:match("%S") then
				addOut("Nothing to run.", RED)
				return
			end
			addOut("Running...", BRIGHT)
			task.spawn(function()
				local ok, fn, compileErr = pcall(loadstring, code)
				if not ok then
					addOut("loadstring unavailable: " .. tostring(fn), RED)
					return
				end
				if type(fn) ~= "function" then
					addOut("Compile error: " .. tostring(compileErr), RED)
					return
				end
				pcall(function()
					local env = setmetatable({
						print = function(...) addOut(joinArgs(...), AMBER) end,
						warn = function(...) addOut(joinArgs(...), BRIGHT) end,
					}, { __index = getfenv(fn) })
					setfenv(fn, env)
				end)
				local runOk, runErr = pcall(fn)
				if runOk then addOut("Done.", GREEN) else addOut("Error: " .. tostring(runErr), RED) end
			end)
		end)

		refreshList()
	end

	---------------------------------------------------------------
	-- EXPLORER
	---------------------------------------------------------------
	local LUA_KEYWORDS = {}
	for word in ("and break do else elseif end false for function if in local nil not or repeat return then true until while continue"):gmatch("%S+") do
		LUA_KEYWORDS[word] = true
	end

	local function pathOf(inst)
		local chain = {}
		local cur = inst
		while cur and cur ~= game do
			table.insert(chain, 1, cur)
			cur = cur.Parent
		end
		if cur ~= game then return "(not in the game tree)" end
		local out = "game"
		for index, node in ipairs(chain) do
			local isService = false
			if index == 1 then
				local ok, service = pcall(game.GetService, game, node.ClassName)
				isService = ok and service == node
			end
			if isService then
				out = out .. ":GetService(\"" .. node.ClassName .. "\")"
			elseif node.Name:match("^[%a_][%w_]*$") and not LUA_KEYWORDS[node.Name] then
				out = out .. "." .. node.Name
			else
				out = out .. "[\"" .. node.Name:gsub("\\", "\\\\"):gsub("\"", "\\\"") .. "\"]"
			end
		end
		return out
	end

	-- class icons: a small coloured tag with letters, so RemoteEvents,
	-- scripts, parts, GUIs and so on are easy to tell apart at a glance
