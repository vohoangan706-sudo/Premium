	local function openExplorer()
		if windows.explorer then front(windows.explorer) return end
		local win = createWindow("explorer", "Dataview - Explorer", 0.82, 0.82)
		local body = win.body

		local rootIndex = 1
		local expanded = {}
		local selectedInst = nil
		local MAX_ROWS = 400
		local MAX_KIDS = 150

		-- left: tree
		local left = makePanel(body, UDim2.new(0.52, -6, 1, -8), UDim2.new(0, 4, 0, 4))
		local rootButton = makeButton(left, ROOTS[1][1], { Size = UDim2.new(0.42, -8, 0, 24), AutomaticSize = Enum.AutomaticSize.None, TextSize = 12 })
		rootButton.Position = UDim2.new(0, 6, 0, 6)
		local searchBox = makeBox(left, UDim2.new(0.58, -8, 0, 24), UDim2.new(0.42, 2, 0, 6), "")
		searchBox.PlaceholderText = "Search names..."
		local treeScroll = makeScroll(left, UDim2.new(1, -8, 1, -62), UDim2.new(0, 4, 0, 34), Enum.AutomaticSize.XY)
		treeScroll.ScrollingDirection = Enum.ScrollingDirection.XY
		make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, treeScroll)
		local treeStatus = makeLabel(left, "", UDim2.new(1, -12, 0, 18), UDim2.new(0, 6, 1, -22), DIM, 11)

		-- right: properties
		local right = makePanel(body, UDim2.new(0.48, -4, 1, -8), UDim2.new(0.52, 2, 0, 4))
		local pathBox = makeBox(right, UDim2.new(1, -12, 0, 24), UDim2.new(0, 6, 0, 6), "")
		pathBox.PlaceholderText = "Select something to see its path"
		pathBox.TextEditable = true
		pathBox.TextSize = 11
		local actionRow = make("Frame", { Size = UDim2.new(1, -12, 0, 26), Position = UDim2.new(0, 6, 0, 34), BackgroundTransparency = 1 }, right)
		make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4), VerticalAlignment = Enum.VerticalAlignment.Center }, actionRow)
		local copyPathButton = makeButton(actionRow, "Copy path", { Size = UDim2.new(0, 0, 0, 24), TextSize = 12 })
		local upButton = makeButton(actionRow, "Up", { Size = UDim2.new(0, 0, 0, 24), TextSize = 12 })
		local gotoButton = makeButton(actionRow, "Go to", { Size = UDim2.new(0, 0, 0, 24), TextSize = 12 })
		local deleteButton = makeButton(actionRow, "Delete", { Size = UDim2.new(0, 0, 0, 24), TextSize = 12, Color = Color3.fromRGB(110, 35, 10) })
		local propsScroll = makeScroll(right, UDim2.new(1, -8, 1, -88), UDim2.new(0, 4, 0, 64))
		make("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, propsScroll)
		local propsStatus = makeLabel(right, "", UDim2.new(1, -12, 0, 18), UDim2.new(0, 6, 1, -22), DIM, 11)

		local rebuildTree, refreshProps

		local function setPropsStatus(text, color)
			propsStatus.Text = text
			propsStatus.TextColor3 = color or DIM
		end

		local function hasChildren(inst)
			local ok, kids = pcall(inst.GetChildren, inst)
			return ok and #kids > 0
		end

		local function flatten(inst, depth, out)
			if #out >= MAX_ROWS then return end
			table.insert(out, { inst = inst, depth = depth })
			if expanded[inst] then
				local ok, kids = pcall(inst.GetChildren, inst)
				if ok then
					for index, kid in ipairs(kids) do
						if index > MAX_KIDS then
							table.insert(out, { more = #kids - MAX_KIDS, depth = depth + 1 })
							break
						end
						flatten(kid, depth + 1, out)
					end
				end
			end
		end

		local function selectNode(inst)
			selectedInst = inst
			refreshProps()
			rebuildTree()
		end

		rebuildTree = function()
			for _, child in ipairs(treeScroll:GetChildren()) do
				if not child:IsA("UIListLayout") then child:Destroy() end
			end
			local root = ROOTS[rootIndex][2]()
			local rows = {}
			local query = searchBox.Text:lower()
			if query ~= "" then
				local ok, all = pcall(root.GetDescendants, root)
				if ok then
					for _, inst in ipairs(all) do
						if inst.Name:lower():find(query, 1, true) then
							table.insert(rows, { inst = inst, depth = 0, flat = true })
							if #rows >= 200 then break end
						end
					end
				end
				treeStatus.Text = #rows .. " match(es)" .. (#rows >= 200 and " (showing the first 200)" or "")
			else
				local ok, kids = pcall(root.GetChildren, root)
				if ok then
					for index, kid in ipairs(kids) do
						if index > MAX_KIDS then
							table.insert(rows, { more = #kids - MAX_KIDS, depth = 0 })
							break
						end
						flatten(kid, 0, rows)
					end
				end
				treeStatus.Text = ROOTS[rootIndex][1] .. ": " .. #rows .. " row(s) shown"
			end

			for index, row in ipairs(rows) do
				local line = make("Frame", { Size = UDim2.new(0, 560, 0, 22), BackgroundTransparency = 1, LayoutOrder = index }, treeScroll)
				if row.more then
					makeLabel(line, "... " .. row.more .. " more", UDim2.new(1, 0, 1, 0), UDim2.new(0, 10 + row.depth * 14, 0, 0), DIM, 12)
				else
					local inst = row.inst
					local indent = row.depth * 14
					if not row.flat and hasChildren(inst) then
						local arrow = makeButton(line, expanded[inst] and "-" or "+", {
							Size = UDim2.new(0, 20, 0, 20), AutomaticSize = Enum.AutomaticSize.None, TextSize = 12,
						})
						arrow.Position = UDim2.new(0, indent, 0, 1)
						arrow.MouseButton1Click:Connect(function()
							expanded[inst] = not expanded[inst]
							rebuildTree()
						end)
					end
					local isSelected = inst == selectedInst
					local label = make("TextButton", {
						Size = UDim2.new(0, 400, 1, 0), Position = UDim2.new(0, indent + 24, 0, 0),
						BackgroundColor3 = FIELD_ON, BackgroundTransparency = isSelected and 0 or 1, BorderSizePixel = 0,
						Text = inst.Name .. "  [" .. inst.ClassName .. "]", TextColor3 = isSelected and TEXT or AMBER,
						Font = Enum.Font.Code, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
					}, line)
					label.MouseButton1Click:Connect(function() selectNode(inst) end)
				end
			end
		end

		local function propRow(name, value, order, inst)
			local row = make("Frame", { Size = UDim2.new(1, -6, 0, 24), BackgroundTransparency = 1, LayoutOrder = order }, propsScroll)
			makeLabel(row, name, UDim2.new(0.38, -2, 1, 0), UDim2.new(0, 2, 0, 0), TEXT, 12)
			local kind = type(value)
			if name == "ClassName" or name == "Parent" or name == "Children" or (kind ~= "string" and kind ~= "number" and kind ~= "boolean") then
				makeLabel(row, tostring(value), UDim2.new(0.62, -4, 1, 0), UDim2.new(0.38, 0, 0, 0), DIM, 12)
			elseif kind == "boolean" then
				local toggle = makeButton(row, tostring(value), {
					Size = UDim2.new(0.62, -4, 1, -2), AutomaticSize = Enum.AutomaticSize.None, TextSize = 12,
					Color = value and FIELD_ON or FIELD,
				})
				toggle.Position = UDim2.new(0.38, 0, 0, 1)
				toggle.MouseButton1Click:Connect(function()
					local ok, err = pcall(function() inst[name] = not value end)
					if not ok then setPropsStatus(tostring(err), RED) end
					refreshProps()
				end)
			else
				local box = makeBox(row, UDim2.new(0.62, -4, 1, -2), UDim2.new(0.38, 0, 0, 1), tostring(value))
				box.TextSize = 12
				box.FocusLost:Connect(function()
					local newValue = box.Text
					if kind == "number" then newValue = tonumber(newValue) end
					if newValue == nil then
						refreshProps()
						return
					end
					local ok, err = pcall(function() inst[name] = newValue end)
					if ok then
						setPropsStatus("Set " .. name .. ".", GREEN)
					else
						setPropsStatus(tostring(err), RED)
					end
					refreshProps()
					rebuildTree()
				end)
			end
		end

		refreshProps = function()
			for _, child in ipairs(propsScroll:GetChildren()) do
				if not child:IsA("UIListLayout") then child:Destroy() end
			end
			local inst = selectedInst
			if not inst or not inst.Parent then
				selectedInst = nil
				pathBox.Text = ""
				return
			end
			pathBox.Text = pathOf(inst)
			local order = 0
			for _, name in ipairs(CANDIDATE_PROPS) do
				local ok, value = pcall(function() return inst[name] end)
				if ok and value ~= nil then
					order = order + 1
					if name == "Parent" then value = value:GetFullName() end
					propRow(name, value, order, inst)
				end
			end
			local ok, kids = pcall(inst.GetChildren, inst)
			if ok then
				order = order + 1
				propRow("Children", #kids, order, inst)
			end
		end

		rootButton.MouseButton1Click:Connect(function()
			rootIndex = rootIndex % #ROOTS + 1
			rootButton.Text = ROOTS[rootIndex][1]
			selectedInst = nil
			refreshProps()
			rebuildTree()
		end)
		searchBox:GetPropertyChangedSignal("Text"):Connect(rebuildTree)

		copyPathButton.MouseButton1Click:Connect(function()
			if not selectedInst then return end
			if copyText(pathOf(selectedInst)) then
				setPropsStatus("Path copied.", GREEN)
			else
				setPropsStatus("No clipboard here: tap the path box and copy it.", RED)
			end
		end)

		upButton.MouseButton1Click:Connect(function()
			if selectedInst and selectedInst.Parent and selectedInst.Parent ~= game then
				local parent = selectedInst.Parent
				expanded[parent] = true
				selectNode(parent)
			end
		end)

		gotoButton.MouseButton1Click:Connect(function()
			local inst = selectedInst
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if not (inst and hrp) then return end
			local ok, err = pcall(function()
				if inst:IsA("BasePart") then
					hrp.CFrame = inst.CFrame + Vector3.new(0, 5, 0)
				elseif inst:IsA("Model") then
					hrp.CFrame = inst:GetPivot() + Vector3.new(0, 5, 0)
				else
					error("only parts and models can be teleported to")
				end
			end)
			setPropsStatus(ok and "Teleported." or tostring(err), ok and GREEN or RED)
		end)

		local deleteArmed = false
		deleteButton.MouseButton1Click:Connect(function()
			if not selectedInst then return end
			if not deleteArmed then
				deleteArmed = true
				deleteButton.Text = "Sure?"
				task.delay(3, function()
					deleteArmed = false
					if deleteButton.Parent then deleteButton.Text = "Delete" end
				end)
				return
			end
			deleteArmed = false
			deleteButton.Text = "Delete"
			local ok, err = pcall(function() selectedInst:Destroy() end)
			selectedInst = nil
			setPropsStatus(ok and "Deleted (on your client)." or tostring(err), ok and GREEN or RED)
			refreshProps()
			rebuildTree()
		end)

		rebuildTree()
	end

	---------------------------------------------------------------
	-- NOTES
	---------------------------------------------------------------
	local function openNotes()
		if windows.notes then front(windows.notes) return end
		local win = createWindow("notes", "Dataview - Notes", 0.6, 0.72)
		local body = win.body
		local notes = settings.notes
		local current = nil
		local saveToken = 0

		local left = makePanel(body, UDim2.new(0.34, -6, 1, -8), UDim2.new(0, 4, 0, 4))
		local listScroll = makeScroll(left, UDim2.new(1, -8, 1, -44), UDim2.new(0, 4, 0, 4))
		make("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }, listScroll)
		local newButton = makeButton(left, "+ New note", { Size = UDim2.new(1, -12, 0, 28), AutomaticSize = Enum.AutomaticSize.None })
		newButton.Position = UDim2.new(0, 6, 1, -34)

		local right = make("Frame", { Size = UDim2.new(0.66, -4, 1, -8), Position = UDim2.new(0.34, 0, 0, 4), BackgroundTransparency = 1 }, body)
		local titleBox = makeBox(right, UDim2.new(1, 0, 0, 26), UDim2.new(0, 0, 0, 0), "")
		titleBox.PlaceholderText = "Title"
		local bodyScroll = make("ScrollingFrame", {
			Size = UDim2.new(1, 0, 1, -98), Position = UDim2.new(0, 0, 0, 30),
			BackgroundColor3 = Color3.fromRGB(10, 9, 5), BorderSizePixel = 0, ScrollBarThickness = 5,
			CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		}, right)
		round(bodyScroll, 4)
		local bodyBox = make("TextBox", {
			Size = UDim2.new(1, 0, 0, 200), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
			TextColor3 = TEXT, Font = Enum.Font.Code, TextSize = 14, MultiLine = true, TextWrapped = true,
			ClearTextOnFocus = false, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
			PlaceholderText = "Write your note here...", PlaceholderColor3 = DIM, Text = "",
		}, bodyScroll)
		make("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingTop = UDim.new(0, 4), PaddingRight = UDim.new(0, 6) }, bodyBox)

		local buttonRow = make("Frame", { Size = UDim2.new(1, 0, 0, 30), Position = UDim2.new(0, 0, 1, -64), BackgroundTransparency = 1 }, right)
		make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 5), VerticalAlignment = Enum.VerticalAlignment.Center }, buttonRow)
		local copyButton = makeButton(buttonRow, "Copy")
		local deleteButton = makeButton(buttonRow, "Delete", { Color = Color3.fromRGB(110, 35, 10) })
		local status = makeLabel(right, "", UDim2.new(1, 0, 0, 18), UDim2.new(0, 0, 1, -22), DIM, 12)

		local refreshList

		local function setStatus(text, color)
			status.Text = text
			status.TextColor3 = color or DIM
		end

		local function commit()
			if not current or not notes[current] then return end
			notes[current].title = titleBox.Text
			notes[current].body = bodyBox.Text
			saveSettings()
			refreshList()
			setStatus(canPersist and "Saved." or "Saved (memory only: no writefile).", GREEN)
		end

		-- saves a moment after you stop typing
		local function scheduleSave()
			saveToken = saveToken + 1
			local token = saveToken
			task.delay(1.2, function()
				if token == saveToken then commit() end
			end)
		end

		refreshList = function()
			for _, child in ipairs(listScroll:GetChildren()) do
				if child:IsA("TextButton") then child:Destroy() end
			end
			for index, note in ipairs(notes) do
				local title = (note.title and note.title ~= "") and note.title or "Untitled"
				local row = makeButton(listScroll, title, {
					Size = UDim2.new(1, -6, 0, 26), AutomaticSize = Enum.AutomaticSize.None,
					LayoutOrder = index, Color = (index == current) and FIELD_ON or FIELD,
				})
				row.TextXAlignment = Enum.TextXAlignment.Left
				row.MouseButton1Click:Connect(function()
					current = index
					titleBox.Text = note.title or ""
					bodyBox.Text = note.body or ""
					refreshList()
				end)
			end
		end

		local function newNote()
			table.insert(notes, { title = "New note", body = "" })
			current = #notes
			titleBox.Text = "New note"
			bodyBox.Text = ""
			saveSettings()
			refreshList()
		end

		titleBox:GetPropertyChangedSignal("Text"):Connect(function()
			if current then scheduleSave() end
		end)
		bodyBox:GetPropertyChangedSignal("Text"):Connect(function()
			if current then scheduleSave() end
		end)

		newButton.MouseButton1Click:Connect(newNote)

		copyButton.MouseButton1Click:Connect(function()
			if copyText(bodyBox.Text) then
				setStatus("Copied.", GREEN)
			else
				setStatus("No clipboard here: select the text and copy it.", RED)
			end
		end)

		deleteButton.MouseButton1Click:Connect(function()
			if current and notes[current] then
				table.remove(notes, current)
				current = nil
				titleBox.Text = ""
				bodyBox.Text = ""
				saveSettings()
				refreshList()
				setStatus("Deleted.", BRIGHT)
			end
		end)

		if #notes == 0 then
			newNote()
		else
			current = #notes
			titleBox.Text = notes[current].title or ""
			bodyBox.Text = notes[current].body or ""
			refreshList()
		end
	end

	---------------------------------------------------------------
	-- the Dv API (used from the {} editor)
	---------------------------------------------------------------
	local Dv = {}

	function Dv.Scripthub() openScripthub() end
	function Dv.Explorer() openExplorer() end

	-- Dv.Note() opens the notes app; Dv.Note("text") saves a new note first
	function Dv.Note(text)
		if text ~= nil then
			local content = tostring(text)
			table.insert(settings.notes, { title = content:sub(1, 24), body = content })
			saveSettings()
			if windows.notes then windows.notes.close() end
		end
		openNotes()
	end

	function Dv.Close() closeAll() end

	local function enableGlobals()
		linuxHooks.extraGlobals = linuxHooks.extraGlobals or {}
		linuxHooks.extraGlobals.Dv = Dv
	end

	local function disableGlobals()
		if linuxHooks.extraGlobals then linuxHooks.extraGlobals.Dv = nil end
	end

	---------------------------------------------------------------
	-- `pkg install dataview` / `pkg uninstall dataview`
	---------------------------------------------------------------
	local INSTALL_LINES = {
		"Reading package lists... Done",
		"Building dependency tree... Done",
		"The following NEW packages will be installed:",
		"  dataview",
		"Get:1 aether://repo/main dataview 1.0.0 [688 kB]",
		"Fetched 688 kB in 1s (688 kB/s)",
		"Selecting previously unselected package dataview.",
		"Unpacking dataview (1.0.0) ...",
		"Setting up dataview (1.0.0) ...",
		"Linking Dv.Scripthub, Dv.Explorer, Dv.Note ... OK",
		"Installation complete.",
	}

	local installing = false

	local function installDataview()
		if settings.installed then
			return "Dataview is already installed. Use Dv.Scripthub(), Dv.Explorer() or Dv.Note() in {} mode."
		end
		if installing then
			return "Install already in progress."
		end
		installing = true
		task.spawn(function()
			for _, line in ipairs(INSTALL_LINES) do
				addLine(line, AMBER)
				task.wait(0.12)
			end
			settings.installed = true
			saveSettings()
			enableGlobals()
			installing = false
			addLine("Dataview ready. In {} mode: Dv.Scripthub()  Dv.Explorer()  Dv.Note()", GREEN)
		end)
		return "Installing dataview..."
	end

	-- keeps your saved scripts and notes; only removes the install
	local function uninstallDataview()
		if not settings.installed then
			return "Dataview isn't installed."
		end
		closeAll()
		settings.installed = nil
		saveSettings()
		disableGlobals()
		return "Dataview uninstalled. (Your saved scripts and notes are kept.)"
	end

	if settings.installed then
		enableGlobals() -- installed earlier: Dv is available right away
	end

	-- the panel owns the `pkg` command and hands `pkg install dataview` to us
	if registerPackage then
		registerPackage("dataview", installDataview, uninstallDataview)
	else
		commands["pkg"] = function(args)
			if tostring(args[1] or ""):lower() == "install" and tostring(args[2] or ""):lower() == "dataview" then
				return installDataview()
			end
			return "Usage: pkg install dataview"
		end
	end
end

setupDataview()