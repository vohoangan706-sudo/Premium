		local searchBox = makeBox(left, UDim2.new(1, -12, 0, 24), UDim2.new(0, 6, 0, 34), "")
		searchBox.PlaceholderText = "Search names or class (RemoteEvent, Part...)"
		local treeScroll = makeScroll(left, UDim2.new(1, -8, 1, -92), UDim2.new(0, 4, 0, 62), Enum.AutomaticSize.XY)
