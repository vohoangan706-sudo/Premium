		local searchBox = makeBox(left, UDim2.new(1, -12, 0, 24), UDim2.new(0, 6, 0, 6), "")
		searchBox.PlaceholderText = "Search scripts..."
		local listScroll = makeScroll(left, UDim2.new(1, -8, 1, -76), UDim2.new(0, 4, 0, 34))
		make("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }, listScroll)
		local newButton = makeButton(left, "+ New script", { Size = UDim2.new(1, -12, 0, 28), AutomaticSize = Enum.AutomaticSize.None })
		newButton.Position = UDim2.new(0, 6, 1, -34)

		-- right: editor
		local right = make("Frame", { Size = UDim2.new(0.7, -4, 1, -8), Position = UDim2.new(0.3, 0, 0, 4), BackgroundTransparency = 1 }, body)
		local nameBox = makeBox(right, UDim2.new(1, 0, 0, 26), UDim2.new(0, 0, 0, 0), "")
		nameBox.PlaceholderText = "Script name"
		local urlBox = makeBox(right, UDim2.new(1, -66, 0, 26), UDim2.new(0, 0, 0, 30), "")
		urlBox.PlaceholderText = "Paste a raw URL to fetch a script..."
		local fetchButton = makeButton(right, "Fetch", { Size = UDim2.new(0, 60, 0, 26), AutomaticSize = Enum.AutomaticSize.None })
		fetchButton.Position = UDim2.new(1, -60, 0, 30)

		local editorFrame = make("ScrollingFrame", {
			Size = UDim2.new(1, 0, 1, -184), Position = UDim2.new(0, 0, 0, 60),
			BackgroundColor3 = Color3.fromRGB(10, 9, 5), BorderSizePixel = 0, ScrollBarThickness = 5,
			CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.XY,
			ScrollingDirection = Enum.ScrollingDirection.XY,
		}, right)
		round(editorFrame, 4)
		local editor = make("TextBox", {
			Size = UDim2.new(1, 0, 0, 200), AutomaticSize = Enum.AutomaticSize.XY, BackgroundTransparency = 1,
			TextColor3 = AMBER, Font = Enum.Font.Code, TextSize = 14, MultiLine = true, TextWrapped = false,
			ClearTextOnFocus = false, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
			PlaceholderText = "-- write or paste Lua here", PlaceholderColor3 = DIM, Text = "",
		}, editorFrame)
		make("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingTop = UDim.new(0, 4) }, editor)

		local outFrame = make("ScrollingFrame", {
			Size = UDim2.new(1, 0, 0, 80), Position = UDim2.new(0, 0, 1, -118),
			BackgroundColor3 = Color3.fromRGB(10, 9, 5), BorderSizePixel = 0, ScrollBarThickness = 4,
			CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		}, right)
		round(outFrame, 4)
		make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, outFrame)

		local buttonRow = make("Frame", { Size = UDim2.new(1, 0, 0, 30), Position = UDim2.new(0, 0, 1, -32), BackgroundTransparency = 1 }, right)
		make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 5), VerticalAlignment = Enum.VerticalAlignment.Center }, buttonRow)
		local saveButton = makeButton(buttonRow, "Save", { Color = FIELD_ON })
		local runButton = makeButton(buttonRow, "Run", { Color = FIELD_ON })
		local copyButton = makeButton(buttonRow, "Copy")
		local deleteButton = makeButton(buttonRow, "Delete", { Color = Color3.fromRGB(110, 35, 10) })

		local outCount = 0
		local function addOut(text, color)
			outCount = outCount + 1
			make("TextLabel", {
				Size = UDim2.new(1, -6, 0, 16), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
				Text = tostring(text), TextColor3 = color or AMBER, Font = Enum.Font.Code, TextSize = 12,
				TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = outCount,
			}, outFrame)
			local rows = {}
			for _, child in ipairs(outFrame:GetChildren()) do
				if child:IsA("TextLabel") then table.insert(rows, child) end
			end
			if #rows > 80 then rows[1]:Destroy() end
			outFrame.CanvasPosition = Vector2.new(0, 1e6)
		end

		local function refreshList()
			for _, child in ipairs(listScroll:GetChildren()) do
				if child:IsA("TextButton") then child:Destroy() end
			end
			local query = searchBox.Text:lower()
			for index, script in ipairs(scripts) do
				if query == "" or script.name:lower():find(query, 1, true) then
					local row = makeButton(listScroll, script.name, {
						Size = UDim2.new(1, -6, 0, 26), AutomaticSize = Enum.AutomaticSize.None,
						LayoutOrder = index, Color = (index == current) and FIELD_ON or FIELD,
					})
					row.TextXAlignment = Enum.TextXAlignment.Left
					row.MouseButton1Click:Connect(function()
						current = index
						nameBox.Text = script.name
						editor.Text = script.code
						refreshList()
					end)
				end
			end
		end

		searchBox:GetPropertyChangedSignal("Text"):Connect(refreshList)

		newButton.MouseButton1Click:Connect(function()
			current = nil
			nameBox.Text = ""
			editor.Text = ""
			refreshList()
		end)

		saveButton.MouseButton1Click:Connect(function()
			local name = nameBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
			if name == "" then name = "Untitled" end
			if current and scripts[current] then
				scripts[current].name = name
				scripts[current].code = editor.Text
			else
				table.insert(scripts, { name = name, code = editor.Text })
				current = #scripts
			end
			saveSettings()
			refreshList()
			addOut("Saved '" .. name .. "'" .. (canPersist and "." or " (memory only: no writefile)."), GREEN)
		end)

		deleteButton.MouseButton1Click:Connect(function()
			if current and scripts[current] then
				local name = scripts[current].name
				table.remove(scripts, current)
				current = nil
				nameBox.Text = ""
				editor.Text = ""
				saveSettings()
				refreshList()
				addOut("Deleted '" .. name .. "'.", BRIGHT)
			end
		end)

		copyButton.MouseButton1Click:Connect(function()
			if copyText(editor.Text) then
				addOut("Copied to clipboard.", GREEN)
			else
				addOut("No clipboard here: select the text in the editor and copy it.", RED)
			end
		end)

		fetchButton.MouseButton1Click:Connect(function()
			local url = urlBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
			if url == "" then return end
			addOut("Fetching...", BRIGHT)
			task.spawn(function()
				local ok, result = pcall(function() return game:HttpGet(url) end)
				if ok and type(result) == "string" then
					editor.Text = result
					if nameBox.Text == "" then nameBox.Text = url:match("([^/]+)$") or "Fetched script" end
					addOut("Fetched " .. #result .. " characters. Press Save to keep it.", GREEN)
				else
					addOut("Fetch failed: " .. tostring(result), RED)
				end
			end)
		end)

		runButton.MouseButton1Click:Connect(function()
			local code = editor.Text
			if not code:match("%S") then
				addOut("Nothing to run.", RED)
				return
			end
			addOut("Running...", BRIGHT)
			task.spawn(function()
				local ok, fn, compileErr = pcall(loadstring, code)
				if not ok then
					addOut("loadstring unavailable: " .. tostring(fn), RED)
					return
				end
				if type(fn) ~= "function" then
					addOut("Compile error: " .. tostring(compileErr), RED)
					return
				end
				pcall(function()
					local env = setmetatable({
						print = function(...) addOut(joinArgs(...), AMBER) end,
						warn = function(...) addOut(joinArgs(...), BRIGHT) end,
					}, { __index = getfenv(fn) })
					setfenv(fn, env)
				end)
				local runOk, runErr = pcall(fn)
				if runOk then addOut("Done.", GREEN) else addOut("Error: " .. tostring(runErr), RED) end
			end)
		end)

		refreshList()
	end

	---------------------------------------------------------------
	-- EXPLORER
	---------------------------------------------------------------
	local LUA_KEYWORDS = {}
	for word in ("and break do else elseif end false for function if in local nil not or repeat return then true until while continue"):gmatch("%S+") do
		LUA_KEYWORDS[word] = true
	end

	local function pathOf(inst)
		local chain = {}
		local cur = inst
		while cur and cur ~= game do
			table.insert(chain, 1, cur)
			cur = cur.Parent
		end
		if cur ~= game then return "(not in the game tree)" end
		local out = "game"
		for index, node in ipairs(chain) do
			local isService = false
			if index == 1 then
				local ok, service = pcall(game.GetService, game, node.ClassName)
				isService = ok and service == node
			end
			if isService then
				out = out .. ":GetService(\"" .. node.ClassName .. "\")"
			elseif node.Name:match("^[%a_][%w_]*$") and not LUA_KEYWORDS[node.Name] then
				out = out .. "." .. node.Name
			else
				out = out .. "[\"" .. node.Name:gsub("\\", "\\\\"):gsub("\"", "\\\"") .. "\"]"
			end
		end
		return out
	end

	local ROOTS = {
		{ "Workspace", function() return workspace end },
		{ "Players", function() return game:GetService("Players") end },
		{ "ReplicatedStorage", function() return game:GetService("ReplicatedStorage") end },
		{ "Lighting", function() return game:GetService("Lighting") end },
		{ "StarterGui", function() return game:GetService("StarterGui") end },
		{ "PlayerGui", function() return PlayerGui end },
		{ "game", function() return game end },
	}

