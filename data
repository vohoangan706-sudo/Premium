		local treeStatus = makeLabel(left, "", UDim2.new(1, -12, 0, 18), UDim2.new(0, 6, 1, -22), DIM, 11)

		-- right: properties
		local right = makePanel(body, UDim2.new(0.48, -4, 1, -8), UDim2.new(0.52, 2, 0, 4))
		local pathBox = makeBox(right, UDim2.new(1, -12, 0, 24), UDim2.new(0, 6, 0, 6), "")
