	local REMOTE_CLASSES = { RemoteEvent = true, UnreliableRemoteEvent = true, RemoteFunction = true, BindableEvent = true, BindableFunction = true }

	local function iconFor(inst)
		local info = ICON_BY_CLASS[inst.ClassName]
		if info then return info[1], info[2] end
		local function is(class)
			local ok, result = pcall(inst.IsA, inst, class)
			return ok and result
		end
		if is("LuaSourceContainer") then return "S", Color3.fromRGB(70, 160, 90) end
		if is("BasePart") then return "P", Color3.fromRGB(120, 150, 200) end
		if is("LayerCollector") then return "UI", Color3.fromRGB(100, 190, 230) end
		if is("GuiObject") then return "Gu", Color3.fromRGB(90, 170, 210) end
		if is("ValueBase") then return "V", Color3.fromRGB(200, 190, 110) end
		if is("Constraint") then return "Cn", Color3.fromRGB(160, 140, 200) end
		if is("JointInstance") then return "Jn", Color3.fromRGB(160, 140, 200) end
		if is("Light") then return "Lt", Color3.fromRGB(240, 220, 120) end
		if inst.Parent == game then return "Sv", Color3.fromRGB(200, 170, 80) end
		return "?", Color3.fromRGB(110, 110, 110)
	end

	local function makeIcon(parent, inst, position)
		local text, color = iconFor(inst)
		local icon = make("Frame", { Size = UDim2.new(0, 24, 0, 16), Position = position, BackgroundColor3 = color, BorderSizePixel = 0 }, parent)
		round(icon, 3)
		make("TextLabel", {
			Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = text, TextSize = 10,
			Font = Enum.Font.Code, TextColor3 = Color3.fromRGB(15, 15, 15),
		}, icon)
		return icon
	end

	local function instRoot(label, getInst)
		return {
			label = label,
			children = function()
				local ok, list = pcall(function() return getInst():GetChildren() end)
				return ok and list or {}
			end,
			descendants = function()
				local ok, list = pcall(function() return getInst():GetDescendants() end)
				return ok and list or {}
			end,
		}
	end

	local function listRoot(label, getList)
		local function safe()
			local ok, list = pcall(getList)
			return (ok and type(list) == "table") and list or {}
		end
		return { label = label, children = safe, descendants = safe }
	end

	local ROOTS = {}
	do
		local everything = {
			label = "Everything",
			children = function()
				local out = {}
				for _, inst in ipairs(game:GetChildren()) do table.insert(out, inst) end
				if type(getnilinstances) == "function" then
					local ok, nils = pcall(getnilinstances)
					if ok and type(nils) == "table" then
						for _, inst in ipairs(nils) do table.insert(out, inst) end
					end
				end
				return out
			end,
			descendants = function()
				local out = {}
				local ok, all = pcall(function() return game:GetDescendants() end)
				if ok then
					for _, inst in ipairs(all) do table.insert(out, inst) end
				end
				if type(getnilinstances) == "function" then
					local ok2, nils = pcall(getnilinstances)
					if ok2 and type(nils) == "table" then
						for _, inst in ipairs(nils) do
							table.insert(out, inst)
							local ok3, below = pcall(inst.GetDescendants, inst)
							if ok3 then
								for _, child in ipairs(below) do table.insert(out, child) end
							end
						end
					end
				end
				return out
			end,
		}
		table.insert(ROOTS, everything)
		table.insert(ROOTS, instRoot("Game (services)", function() return game end))
		for _, name in ipairs({ "Workspace", "Players", "ReplicatedStorage", "ReplicatedFirst", "Lighting", "StarterGui", "StarterPack", "StarterPlayer", "SoundService", "Teams", "Chat", "CoreGui" }) do
			table.insert(ROOTS, instRoot(name, function() return game:GetService(name) end))
		end
		table.insert(ROOTS, instRoot("PlayerGui", function() return PlayerGui end))
		table.insert(ROOTS, instRoot("My Character", function() return player.Character end))
		if type(getnilinstances) == "function" then table.insert(ROOTS, listRoot("Nil instances", getnilinstances)) end
		if type(getloadedmodules) == "function" then table.insert(ROOTS, listRoot("Loaded modules", getloadedmodules)) end
		if type(getscripts) == "function" then table.insert(ROOTS, listRoot("All scripts", getscripts)) end
	end

	local FILTERS = {
		{ "All", nil },
		{ "Remotes", function(i) return REMOTE_CLASSES[i.ClassName] == true end },
		{ "Scripts", function(i) return i:IsA("LuaSourceContainer") end },
		{ "GUI", function(i) return i:IsA("GuiObject") or i:IsA("LayerCollector") end },
		{ "Parts", function(i) return i:IsA("BasePart") end },
		{ "Models", function(i) return i:IsA("Model") end },
		{ "Values", function(i) return i:IsA("ValueBase") end },
		{ "Sounds", function(i) return i:IsA("Sound") end },
		{ "Animations", function(i) return i:IsA("Animation") end },
		{ "Players", function(i) return i:IsA("Player") or i:IsA("Humanoid") end },
	}

	-- properties tried on whatever you select; only the ones that exist show up
	local CANDIDATE_PROPS = {
		"Name", "ClassName", "Parent", "Visible", "Enabled", "Text", "Value", "Position", "Size", "CFrame",
		"Orientation", "Anchored", "CanCollide", "CanTouch", "CanQuery", "Transparency", "Color", "Material",
		"Massless", "BackgroundColor3", "BackgroundTransparency", "TextColor3", "ZIndex", "Image",
		"Health", "MaxHealth", "WalkSpeed", "JumpPower", "JumpHeight", "HipHeight",
		"Volume", "Playing", "Looped", "SoundId", "Brightness", "Range", "Ambient", "ClockTime", "FieldOfView",
		"Disabled", "RunContext", "Archivable",
	}

	local function openExplorer()
		if windows.explorer then front(windows.explorer) return end
		local win = createWindow("explorer", "Dataview - Explorer")
		local body = win.body
		local CollectionService = game:GetService("CollectionService")

		local rootIndex = 1
		local filterIndex = 1
		local expanded = {}
		local selectedInst = nil
		local MAX_ROWS = 600
		local MAX_KIDS = 200
		local MAX_RESULTS = 500
		local searchToken = 0

		-- left: tree / results
		local left = makePanel(body, UDim2.new(0.52, -6, 1, -8), UDim2.new(0, 4, 0, 4))
		local rootButton = makeButton(left, "Root: " .. ROOTS[1].label, { Size = UDim2.new(0.5, -8, 0, 24), AutomaticSize = Enum.AutomaticSize.None, TextSize = 12 })
		rootButton.Position = UDim2.new(0, 6, 0, 6)
