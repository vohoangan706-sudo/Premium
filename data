-- ======================================================================
--  Dataview  (standalone package for the Aetherfinix panel)
--  Host this file (raw URL) and put the URL in the panel's
--  PACKAGE_URLS.dataview slot. Then type:  pkg install dataview
--  After installing, these work in the {} editor:
--      Dv.Scripthub()   -- saved scripts: write, save, run, fetch from a URL
--      Dv.Explorer()    -- browse the game's instances and edit properties
--      Dv.Note()        -- notes (Dv.Note("quick text") adds one directly)
--      Dv.Close()       -- closes all Dataview windows
--  Running this file by itself does nothing: the panel loads it.
-- ======================================================================
local context = ...
if type(context) ~= "table" then
	warn("Dataview must be loaded by the Aetherfinix panel.")
	return
end

local player = context.player
local addLine = context.addLine
local commands = context.commands
local linuxHooks = context.linuxHooks
local registerPackage = context.registerPackage

local HttpService = game:GetService("HttpService")
local UserInputService = game:GetService("UserInputService")

local AMBER = Color3.fromRGB(255, 200, 0)
local BRIGHT = Color3.fromRGB(255, 220, 120)
local GREEN = Color3.fromRGB(150, 255, 150)
local RED = Color3.fromRGB(255, 150, 150)

-- everything Dataview saves (scripts, notes) lives in its own small file
local SETTINGS_FILE = "AetherfinixDataview.json"
local settings = {}
local canPersist = (type(writefile) == "function" and type(readfile) == "function")

if canPersist then
	local ok, raw = pcall(function()
		if type(isfile) == "function" and not isfile(SETTINGS_FILE) then return nil end
		return readfile(SETTINGS_FILE)
	end)
	if ok and type(raw) == "string" and raw ~= "" then
		local decoded, data = pcall(HttpService.JSONDecode, HttpService, raw)
		if decoded and type(data) == "table" then settings = data end
	end
end
if type(settings.scripts) ~= "table" then settings.scripts = {} end
if type(settings.notes) ~= "table" then settings.notes = {} end

local function saveSettings()
	if not canPersist then return end
	pcall(function() writefile(SETTINGS_FILE, HttpService:JSONEncode(settings)) end)
end

local function setupDataview()
	local PlayerGui = player:WaitForChild("PlayerGui")

	local BG = Color3.fromRGB(14, 14, 14)
	local PANEL = Color3.fromRGB(22, 20, 12)
	local EDGE = Color3.fromRGB(255, 200, 0)
	local TEXT = Color3.fromRGB(240, 235, 215)
	local DIM = Color3.fromRGB(150, 140, 110)
	local FIELD = Color3.fromRGB(38, 33, 16)
	local FIELD_ON = Color3.fromRGB(120, 90, 0)

	---------------------------------------------------------------
	-- small UI helpers
	---------------------------------------------------------------
	local function make(class, props, parent)
		local inst = Instance.new(class)
		for key, value in pairs(props) do inst[key] = value end
		inst.Parent = parent
		return inst
	end

	local function round(inst, radius)
		make("UICorner", { CornerRadius = UDim.new(0, radius or 4) }, inst)
	end

	local function makeButton(parent, text, props)
		props = props or {}
		local b = make("TextButton", {
			Size = props.Size or UDim2.new(0, 0, 0, 28),
			AutomaticSize = props.AutomaticSize or Enum.AutomaticSize.X,
			BackgroundColor3 = props.Color or FIELD,
			TextColor3 = TEXT, Font = Enum.Font.Code, TextSize = props.TextSize or 13,
			Text = text, BorderSizePixel = 0, LayoutOrder = props.LayoutOrder or 0,
		}, parent)
		round(b, 5)
		make("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, b)
		return b
	end

	local function makeBox(parent, size, position, text)
		local box = make("TextBox", {
			Size = size, Position = position, BackgroundColor3 = FIELD, TextColor3 = TEXT,
			PlaceholderColor3 = DIM, Font = Enum.Font.Code, TextSize = 13, ClearTextOnFocus = false,
			Text = text or "", TextXAlignment = Enum.TextXAlignment.Left, BorderSizePixel = 0,
		}, parent)
		round(box, 4)
		make("UIPadding", { PaddingLeft = UDim.new(0, 6) }, box)
		return box
	end

	local function makeLabel(parent, text, size, position, color, textSize)
		return make("TextLabel", {
			Size = size, Position = position, BackgroundTransparency = 1, Text = text,
			TextColor3 = color or TEXT, Font = Enum.Font.Code, TextSize = textSize or 13,
			TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
		}, parent)
	end

	local function makePanel(parent, size, position)
		local frame = make("Frame", { Size = size, Position = position, BackgroundColor3 = PANEL, BorderSizePixel = 0 }, parent)
		round(frame, 6)
		make("UIStroke", { Color = EDGE, Thickness = 1, Transparency = 0.5 }, frame)
		return frame
	end

	local function makeScroll(parent, size, position, direction)
		return make("ScrollingFrame", {
			Size = size, Position = position, BackgroundTransparency = 1, BorderSizePixel = 0,
			ScrollBarThickness = 4, CanvasSize = UDim2.new(0, 0, 0, 0),
			AutomaticCanvasSize = direction or Enum.AutomaticSize.Y,
		}, parent)
	end

	local function isPress(input)
		return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
	end

	local function joinArgs(...)
		local parts = {}
		for i = 1, select("#", ...) do parts[i] = tostring((select(i, ...))) end
		return table.concat(parts, "\t")
	end

	local function copyText(text)
		return type(setclipboard) == "function" and pcall(setclipboard, text)
	end

	---------------------------------------------------------------
	-- windows (draggable, minimize, close, click to bring to front)
	---------------------------------------------------------------
	local gui = nil
	local windows = {}
	local zCounter = 10
	local drag = nil

	local function getGui()
		if gui and gui.Parent then return gui end
		gui = make("ScreenGui", { Name = "AetherDataview", ResetOnSpawn = false, DisplayOrder = 90 }, PlayerGui)
		return gui
	end

	local function front(win)
		zCounter = zCounter + 1
		win.frame.ZIndex = zCounter
	end

	local function createWindow(key, title, width, height)
		local count = 0
		for _ in pairs(windows) do count = count + 1 end

		local frame = make("Frame", {
			Name = key, Size = UDim2.new(width, 0, height, 0),
			Position = UDim2.new((1 - width) / 2, count * 18, (1 - height) / 2, count * 18),
			BackgroundColor3 = BG, BorderSizePixel = 0, Active = true,
		}, getGui())
		round(frame, 8)
		make("UIStroke", { Color = EDGE, Thickness = 1.5 }, frame)

		local bar = make("Frame", { Size = UDim2.new(1, 0, 0, 28), BackgroundColor3 = Color3.fromRGB(40, 30, 0), BorderSizePixel = 0, Active = true }, frame)
		round(bar, 8)
		makeLabel(bar, title, UDim2.new(1, -70, 1, 0), UDim2.new(0, 10, 0, 0), EDGE, 14)

		local minButton = makeButton(bar, "-", { Size = UDim2.new(0, 24, 0, 20), AutomaticSize = Enum.AutomaticSize.None })
		minButton.Position = UDim2.new(1, -56, 0, 4)
		local closeButton = makeButton(bar, "X", { Size = UDim2.new(0, 24, 0, 20), AutomaticSize = Enum.AutomaticSize.None, Color = Color3.fromRGB(110, 35, 10) })
		closeButton.Position = UDim2.new(1, -28, 0, 4)

		local body = make("Frame", { Size = UDim2.new(1, 0, 1, -28), Position = UDim2.new(0, 0, 0, 28), BackgroundTransparency = 1 }, frame)

		local win = { frame = frame, body = body, key = key }
		windows[key] = win
		front(win)

		bar.InputBegan:Connect(function(input)
			if isPress(input) then
				front(win)
				drag = { frame = frame, start = input.Position, pos = frame.Position }
			end
		end)
		frame.InputBegan:Connect(function(input)
			if isPress(input) then front(win) end
		end)

		local collapsed = false
		minButton.MouseButton1Click:Connect(function()
			collapsed = not collapsed
			body.Visible = not collapsed
			frame.Size = collapsed and UDim2.new(width, 0, 0, 28) or UDim2.new(width, 0, height, 0)
		end)

		function win.close()
			windows[key] = nil
			frame:Destroy()
		end
		closeButton.MouseButton1Click:Connect(win.close)
		return win
	end

	UserInputService.InputChanged:Connect(function(input)
		if drag and drag.frame.Parent and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local dx = input.Position.X - drag.start.X
			local dy = input.Position.Y - drag.start.Y
			drag.frame.Position = UDim2.new(drag.pos.X.Scale, drag.pos.X.Offset + dx, drag.pos.Y.Scale, drag.pos.Y.Offset + dy)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if drag and isPress(input) then drag = nil end
	end)

	local function closeAll()
		local list = {}
		for _, win in pairs(windows) do table.insert(list, win) end
		for _, win in ipairs(list) do win.close() end
	end

	---------------------------------------------------------------
	-- SCRIPTHUB
	---------------------------------------------------------------
	local function openScripthub()
		if windows.scripthub then front(windows.scripthub) return end
		local win = createWindow("scripthub", "Dataview - Scripthub", 0.76, 0.8)
		local body = win.body
		local scripts = settings.scripts
		local current = nil

		-- left: list
