local animConn

local function hookCharacter(char)
	if animConn then animConn:Disconnect() animConn = nil end

	local hum = char:WaitForChild("Humanoid", 5)
	if not hum then return end

	animConn = hum.AnimationPlayed:Connect(function(track)
		if not running then return end
		if not track.Animation.AnimationId:match("18896229321") then return end
		if char:GetAttribute("Character") ~= "Purple" then return end
		if not char:GetAttribute("Ulted") then return end   -- normal slot-2 use must not trigger the ult routine
		task.spawn(runTwinFangs, track)
	end)
end

local charConn

------------------------------------------------------------------
-- phases
------------------------------------------------------------------
local function farmPhase()
	local target, targetAt, lastUlt, lastMove, lastDash, moveIdx = nil, 0, 0, 0, 0, 1

	while running do
		local char = localPlayer.Character
		local hum, myRoot = humOf(char), rootOf(char)

		if not hum or not myRoot or hum.Health <= 0 then
			unlink()
			setPhase("Waiting to spawn...")
			task.wait(0.5)

		elseif char:GetAttribute("Ulted") then
			return true

		else
			if tick() - lastUlt >= CFG.ULT_TRY_EVERY then
				pressKey(CFG.ULT_KEY)
				lastUlt = tick()
			end

			if CFG.USE_MOVES then
				if tick() - lastDash >= CFG.DASH_EVERY then
					pressKey(CFG.DASH_KEY)
					lastDash = tick()
				end

				if tick() - lastMove >= CFG.MOVE_EVERY then
					lastMove = tick()
					for _ = 1, #CFG.FARM_SLOTS do
						local slot = CFG.FARM_SLOTS[moveIdx]
						moveIdx = moveIdx % #CFG.FARM_SLOTS + 1
						if moveReady(slot) then
							pressKey(SLOT_KEYS[slot])
							break
						end
					end
				end
			end

			if not target or not hittable(target) or tick() - targetAt >= CFG.TARGET_TIME then
				local prev = target
				target = pickFarmTarget(prev) or pickFarmTarget(nil)
				targetAt = tick()
				unlink()
			end

			if target then
				local tRoot = rootOf(target.Character)
				if tRoot and (linkTheir ~= tRoot or linkMy ~= myRoot) then
					link(myRoot, tRoot, hum)
				end
				setSpectate(target)
				setPhase("Hitting " .. target.DisplayName .. " (building ult)")
			else
				unlink()
				setPhase("No targets, waiting...")
			end

			task.wait(0.1)
		end
	end

	return false
end

local function ultPhase()
	unlink()
	glueHome, glueHomeRoot = nil, nil   -- the ult takes over from here
	setPhase("Ult on - using Twin Fangs")

	-- decide now who will get Twin Fangs first and spectate them
	plannedQueue = twinTargetList()
	if plannedQueue[1] then setSpectate(plannedQueue[1]) end

	local deadline = tick() + 8
	while running and not twinBusy and tick() < deadline do
		local c = localPlayer.Character
		if not c or not c:GetAttribute("Ulted") then break end
		pressKey(CFG.MOVE_KEY)
		task.wait(0.25)
	end

	while twinBusy do
		task.wait(0.2)
	end
end

local function mainLoop()
	while running do
		local ok, err = pcall(function()
			if farmPhase() then
				ultPhase()
			end
		end)

		if not ok then
			warn("[AutoTwinFangs] " .. tostring(err))
			task.wait(1)
		end
	end
end

-- M1 forever: its own loop, independent of the farm loop. It pauses while the ult is on
-- (or Twin Fangs is running) and starts again by itself when the ult ends.
local function m1Loop()
	while running do
		local c = localPlayer.Character
		local hum = humOf(c)
		if c and hum and hum.Health > 0 and not c:GetAttribute("Ulted") and not twinBusy and not escaping then
			click()
			task.wait(CFG.M1_INTERVAL)
		else
			task.wait(0.1)
		end
	end
end

-- ult about to end -> press key 4.
-- The game only tells us "Ulted" is on or off, not the time left, so it uses the ult length:
-- CFG.ULT_DURATION if you set it, otherwise the length it measured on the previous ult
-- (so the very first ult, with nothing measured yet, gets no key press).
local ultLearned = nil

-- slot press that works on PC (keyboard) and mobile (on-screen hotbar button)
local function pressSlotKey(code)
	pcall(pressKey, code)
	pcall(function()
		local slot = tostring(({[Enum.KeyCode.One]=1,[Enum.KeyCode.Two]=2,[Enum.KeyCode.Three]=3,[Enum.KeyCode.Four]=4})[code] or "")
		local btn = localPlayer.PlayerGui.Hotbar.Backpack.Hotbar[slot]
		local targets = {btn, btn:FindFirstChild("Base")}
		for _, g in ipairs(targets) do
			if g and g:IsA("GuiButton") then
				for _, sig in ipairs({"MouseButton1Down","MouseButton1Click","Activated","MouseButton1Up"}) do
					if firesignal then pcall(firesignal, g[sig]) end
				end
			end
		end
	end)
end

local function ultEndLoop()
	local prev, startT, startChar, pressed = false, 0, nil, false

	while running do
		local c = localPlayer.Character
		local ulted = (c and c:GetAttribute("Ulted")) and true or false

		if ulted and not prev then
			startT, startChar, pressed = tick(), c, false
		elseif prev and not ulted then
			-- ult ended: remember how long it lasted (only if same character, still alive, not cut short)
			local hum = humOf(c)
			local dur = tick() - startT
			if c == startChar and hum and hum.Health > 0 and dur >= 3 then
				ultLearned = dur
			end
		end

		if ulted and not pressed then
			local dur = (CFG.ULT_DURATION and CFG.ULT_DURATION > 0) and CFG.ULT_DURATION or ultLearned
			if dur and tick() - startT >= dur - CFG.ULT_END_LEAD then
				pressed = true
				setPhase("Ult ending - pressing 4")
				task.spawn(function()
					for _ = 1, 3 do   -- a few tries in case the first one is swallowed
						pressSlotKey(CFG.ULT_END_KEY)
						task.wait(0.3)
					end
				end)
			end
		end

		prev = ulted
		task.wait(0.05)
	end
end

local function startBot()
	if running then return end
	running = true

	if localPlayer.Character then
		task.spawn(hookCharacter, localPlayer.Character)
	end

	charConn = localPlayer.CharacterAdded:Connect(function(char)
		task.wait(0.1)
		hookCharacter(char)
	end)

	task.spawn(mainLoop)
	task.spawn(m1Loop)
	task.spawn(ultEndLoop)
end

local function stopBot()
	running = false
	if charConn then charConn:Disconnect() charConn = nil end
	unlink()
	restoreHome()
	clearSpectate()
	setPhase("Stopped")
end

------------------------------------------------------------------
-- invisible (taken from the original script)
-- every Heartbeat it plays a frozen animation (71181015443030 at 13.45s,
-- huge weight) and stops it again in RenderStepped; your own body shows at 50%
------------------------------------------------------------------
local invisOn   = false
local invisBusy = false
local invisTrack
local invisBeat, invisCharConn
local dimConns = {}

local function dimPart(part)
	if not part:IsA("BasePart") then return end
	if part.Name == "HumanoidRootPart" then return end
	if part.Transparency == 1 then return end
	if part.Name:lower():find("hitbox") then return end

	part.LocalTransparencyModifier = 0.5
	table.insert(dimConns, part:GetPropertyChangedSignal("LocalTransparencyModifier"):Connect(function()
		if invisOn and part.LocalTransparencyModifier ~= 0.5 then
			part.LocalTransparencyModifier = 0.5
		end
	end))
end

local function dimCharacter(char)
	for _, d in ipairs(char:GetDescendants()) do
		dimPart(d)
	end

	table.insert(dimConns, char.DescendantAdded:Connect(function(d)
		if invisOn then dimPart(d) end
	end))
end

local function stopInvisTrack()
	if invisTrack then
		pcall(function()
			if invisTrack.IsPlaying then invisTrack:Stop() end
			invisTrack:Destroy()
		end)
		invisTrack = nil
	end
end

local function invisStep()
	if not invisOn or invisBusy then return end

	local char = localPlayer.Character
	local hum  = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local animator = hum and hum:FindFirstChildOfClass("Animator")
	if not hum or not root or not animator then return end
	if hum.Health <= 0 then return end

	invisBusy = true

	pcall(function()
		local velocity = root.Velocity

		local anim = Instance.new("Animation")
		anim.AnimationId = "rbxassetid://71181015443030"
		invisTrack = animator:LoadAnimation(anim)
		invisTrack.Priority = Enum.AnimationPriority.Action4
		invisTrack:Play()
		invisTrack:AdjustSpeed(0)
		invisTrack:AdjustWeight(2e9)
		invisTrack.TimePosition = 13.45

		RunService.RenderStepped:Wait()

		stopInvisTrack()
		root.Velocity = velocity
	end)

	invisBusy = false
end

local function setInvisible(on)
	if on == invisOn then return end
	invisOn = on

	if on then
		if localPlayer.Character then dimCharacter(localPlayer.Character) end

		invisCharConn = localPlayer.CharacterAdded:Connect(function(char)
			task.wait(0.1)
			if invisOn then dimCharacter(char) end
		end)

		invisBeat = RunService.Heartbeat:Connect(invisStep)
	else
		if invisBeat then invisBeat:Disconnect() invisBeat = nil end
		if invisCharConn then invisCharConn:Disconnect() invisCharConn = nil end

		for _, c in ipairs(dimConns) do
			pcall(function() c:Disconnect() end)
		end
		dimConns = {}

		stopInvisTrack()

		local char = localPlayer.Character
		if char then
			for _, d in ipairs(char:GetDescendants()) do
				if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
					d.LocalTransparencyModifier = 0
				end
			end
		end
	end
end

