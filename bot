getgenv().TFStop = function()
	stopBot()
	if animConn then animConn:Disconnect() animConn = nil end
	if voidCharConn then voidCharConn:Disconnect() voidCharConn = nil end
	if voidHealthConn then voidHealthConn:Disconnect() voidHealthConn = nil end
	if voidFollowConn then voidFollowConn:Disconnect() voidFollowConn = nil end
	if fallenConn then fallenConn:Disconnect() fallenConn = nil end
	pcall(function() voidPart:Destroy() end)
	pcall(function() if voidPlatform then voidPlatform:Destroy() end end)
	pcall(function() workspace.FallenPartsDestroyHeight = -500 end)
	setInvisible(false)
	gui:Destroy()
end

setInvisible(true)     -- auto invisible on execute (antivoid is already installed above)
