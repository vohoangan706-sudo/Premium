local function mkButton(right, y)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(0.5, -18, 0, 32)
	b.Position = right and UDim2.new(0.5, 6, 0, y) or UDim2.new(0, 12, 0, y)
	b.BackgroundColor3 = FILL
	b.BorderSizePixel = 0
	b.Font = FONT
	b.TextSize = 13
	b.TextColor3 = GOLD
	b.AutoButtonColor = true
	b.Parent = main
	round(b, 6)
	return b
end

local function paintToggle(btn, text, on)
	btn.Text = text .. (on and ": ON" or ": OFF")
	btn.BackgroundColor3 = on and FILL_ON or FILL
	btn.TextColor3 = on and BG or GOLD
end

