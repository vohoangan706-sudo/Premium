local function pressKey(code)
	pcall(function()
		VirtualInputManager:SendKeyEvent(true, code, false, game)
		task.wait(0.05)
		VirtualInputManager:SendKeyEvent(false, code, false, game)
	end)
end

-- plain left mouse click (M1) through VirtualInputManager only: no executor mouse1click,
-- no mouse-move event (those were the new calls added last time). Short hold, screen center.
local function click()
	local cam = workspace.CurrentCamera
	local size = cam and cam.ViewportSize or Vector2.new(800, 600)
	local x, y = size.X / 2, size.Y / 2
	pcall(function()
		VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
		task.wait(0.03)
		VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
	end)
end

local SLOT_KEYS = { Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four }

-- a hotbar slot shows a "Cooldown" child under Base while it is cooling down
local function moveReady(slot)
	local ok, ready = pcall(function()
		local base = localPlayer.PlayerGui.Hotbar.Backpack.Hotbar[tostring(slot)].Base
		return base:FindFirstChild("Cooldown") == nil
	end)
	if ok then return ready end
	return true   -- hotbar not found: just try it
end

------------------------------------------------------------------
-- targeting (immunity checks ported from the original; friends skipped by default)
------------------------------------------------------------------
local IMMUNE = { "ForceField", "AbsoluteImmortal", "BeingGrabbed", "HunterCounter", "AtomicCounter", "forcefield", "Counter" }

local friendCache = {}
local function isFriend(p)
	if friendCache[p.UserId] == nil then
		local ok, res = pcall(function() return localPlayer:IsFriendsWith(p.UserId) end)
		friendCache[p.UserId] = (ok and res) and true or false
	end
	return friendCache[p.UserId]
end

local function hittable(p)
	if p == localPlayer then return false end
	if not CFG.HIT_FRIENDS and isFriend(p) then return false end

	local c = p.Character
	local hum, root = humOf(c), rootOf(c)
	if not hum or not root or hum.Health <= 0 then return false end

	for _, name in ipairs(IMMUNE) do
		if c:FindFirstChild(name) then return false end
	end
	if c:FindFirstChildWhichIsA("ForceField") then return false end
	if hasAnim(hum, "15128849047") then return false end
	if c:GetAttribute("Ulted") and c:GetAttribute("Character") == "Batter" then return false end

	local pos = root.Position
	if pos.X < CFG.MINX or pos.X > CFG.MAXX or pos.Z < CFG.MINZ or pos.Z > CFG.MAXZ then
		return false
	end

	return true
end

local function isStunned(p)
	local hum = humOf(p.Character)
	return hum and (hasAnim(hum, "18896222853") or hasAnim(hum, "137434257516014")) or false
end

-- farm: lowest-health hittable player (same idea as the original picker)
local function pickFarmTarget(avoid)
	local best, bestHp = nil, math.huge
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= avoid and hittable(p) then
			local hp = humOf(p.Character).Health
			if hp < bestHp then
				best, bestHp = p, hp
			end
		end
	end
	return best
end

-- twin fangs: EVERY player with a body except you and friends, whatever their character,
-- immunity or state (shuffled so nobody is always last)
local function twinTargetList()
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= localPlayer and not isFriend(p) and rootOf(p.Character) and humOf(p.Character) then
			table.insert(list, p)
		end
	end
	for i = #list, 2, -1 do
		local j = math.random(i)
		list[i], list[j] = list[j], list[i]
	end
	return list
end

-- glass platform at -777y so you rest there instead of falling to -10000y
local voidPlatform
local function ensureVoidPlatform()
	if voidPlatform and voidPlatform.Parent then return end
	local platform = Instance.new("Part")
	platform.Name = "TwinFangsVoidPlatform"
	platform.Size = Vector3.new(2048, 10, 2048)
	platform.Position = CFG.VOID_POS - Vector3.new(0, platform.Size.Y / 2, 0)
	platform.Anchored = true
	platform.CanCollide = true
	platform.Material = Enum.Material.Glass
	platform.Color = Color3.fromRGB(210, 235, 255)
	platform.Transparency = 0.55
	platform.Reflectance = 0.15
	platform.Parent = workspace
	voidPlatform = platform
end

------------------------------------------------------------------
-- twin fangs routine (runs when the Twin Fangs animation plays)
------------------------------------------------------------------
local function runTwinFangs(track)
	if twinBusy then return end
	twinBusy = true
	setPhase("Twin Fangs")

	local startedAt = tick()
	local myRoot0 = rootOf(localPlayer.Character)
	local savedCF = myRoot0 and myRoot0.CFrame
	local cutoff = false
	local keepVel = true
	local deadline = startedAt + 3

	-- cutoff: animation passes 70/30 s, stops, or CUTOFF_TIME (1.85 s, hard limit) pass
	task.spawn(function()
		while true do
			task.wait()
			local past = (not track.IsPlaying) or track.TimePosition >= 70 / 30 or tick() - startedAt >= CFG.CUTOFF_TIME
			if past then break end
		end
		cutoff = true
	end)

	-- keep your velocity at zero while linked
	task.spawn(function()
		while keepVel do
			local r = rootOf(localPlayer.Character)
			if r then
				r.AssemblyLinearVelocity  = Vector3.zero
				r.AssemblyAngularVelocity = Vector3.zero
			end
			RunService.Heartbeat:Wait()
		end
	end)

	-- hit everyone: link, wait for their hit animation (max PER_TARGET_MAX s), next.
	-- HARD limit: the whole hit phase ends at CUTOFF_TIME, the time left is shared between
	-- the remaining players so everyone gets a turn as far as the time allows.
	local queue = twinTargetList()
	local hardEnd = startedAt + CFG.CUTOFF_TIME

	for idx, target in ipairs(queue) do
		if not running or cutoff or tick() >= hardEnd then break end

		local tChar = target.Character
		local tRoot, tHum = rootOf(tChar), humOf(tChar)
		local mChar = localPlayer.Character
		local mRoot = rootOf(mChar)

		if tRoot and tHum and mRoot then
			local left = #queue - idx + 1
			local per = math.clamp((hardEnd - tick()) / left, 0.05, CFG.PER_TARGET_MAX)

			link(mRoot, tRoot, humOf(mChar))

			local hit = false
			local animator = tHum:FindFirstChildOfClass("Animator")
			local conn = (animator and animator.AnimationPlayed or tHum.AnimationPlayed):Connect(function(tr)
				local id = tr.Animation.AnimationId
				if id:match("18896222853") or id:match("137434257516014") then
					hit = true
				end
			end)

			local t0 = tick()
			while running and not hit and not cutoff and tick() - t0 < per and tick() < hardEnd do
				RunService.Heartbeat:Wait()
			end

			conn:Disconnect()
			if hit then stats.hits += 1 end
		end
	end

	unlink()
	keepVel = false

	-- drop to the void at the cutoff
	local waitUntil = tick() + 3
	while running and not cutoff and tick() < waitUntil do
		task.wait()
	end

	-- anchor at -777y (zero velocity every Heartbeat) instead of dropping to -10000y
	setPhase("Anchored at -777y")
	ensureVoidPlatform()
	local function pose()
		local r = rootOf(localPlayer.Character)
		if not r then return end
		r.AssemblyLinearVelocity  = Vector3.zero
		r.AssemblyAngularVelocity = Vector3.zero
		r.CFrame = CFrame.new(CFG.VOID_POS)
	end
	pose()
	local poseConn = RunService.Heartbeat:Connect(pose)

	-- come back once the delay passed and the ult is over (always runs, even after Stop)
	local t1 = tick()
	while running and tick() - t1 < CFG.RETURN_DELAY do
		task.wait(0.1)
	end

	local lim = tick() + 6
	while running do
		local c = localPlayer.Character
		if not c or not c:GetAttribute("Ulted") or tick() >= lim then break end
		task.wait(0.2)
	end

	poseConn:Disconnect()

	local r2 = rootOf(localPlayer.Character)
	if r2 and savedCF then
		r2.CFrame = savedCF
		zero(r2)
	end

	stats.ults += 1
	twinBusy = false
end

------------------------------------------------------------------
-- hook the Twin Fangs animation on your character
------------------------------------------------------------------
local animConn

local function hookCharacter(char)
	if animConn then animConn:Disconnect() animConn = nil end

	local hum = char:WaitForChild("Humanoid", 5)
	if not hum then return end

	animConn = hum.AnimationPlayed:Connect(function(track)
		if not running then return end
		if not track.Animation.AnimationId:match("18896229321") then return end
		if char:GetAttribute("Character") ~= "Purple" then return end
		if not char:GetAttribute("Ulted") then return end   -- normal slot-2 use must not trigger the ult routine
		task.spawn(runTwinFangs, track)
	end)
end

local charConn

------------------------------------------------------------------
-- phases
------------------------------------------------------------------
local function farmPhase()
	local target, targetAt, lastUlt, lastMove, lastDash, moveIdx = nil, 0, 0, 0, 0, 1

	while running do
		local char = localPlayer.Character
		local hum, myRoot = humOf(char), rootOf(char)

		if not hum or not myRoot or hum.Health <= 0 then
			unlink()
			setPhase("Waiting to spawn...")
			task.wait(0.5)

		elseif char:GetAttribute("Ulted") then
			return true

		else
			if tick() - lastUlt >= CFG.ULT_TRY_EVERY then
				pressKey(CFG.ULT_KEY)
				lastUlt = tick()
			end

			if CFG.USE_MOVES then
				if tick() - lastDash >= CFG.DASH_EVERY then
					pressKey(CFG.DASH_KEY)
					lastDash = tick()
				end

				if tick() - lastMove >= CFG.MOVE_EVERY then
					lastMove = tick()
					for _ = 1, #CFG.FARM_SLOTS do
						local slot = CFG.FARM_SLOTS[moveIdx]
						moveIdx = moveIdx % #CFG.FARM_SLOTS + 1
						if moveReady(slot) then
							pressKey(SLOT_KEYS[slot])
							break
						end
					end
				end
			end

			if not target or not hittable(target) or tick() - targetAt >= CFG.TARGET_TIME then
				local prev = target
				target = pickFarmTarget(prev) or pickFarmTarget(nil)
				targetAt = tick()
				unlink()
			end

			if target then
				local tRoot = rootOf(target.Character)
				if tRoot and (linkTheir ~= tRoot or linkMy ~= myRoot) then
					link(myRoot, tRoot, hum)
				end
				setPhase("Hitting " .. target.DisplayName .. " (building ult)")
				click()
			else
				unlink()
				setPhase("No targets, waiting...")
			end

			task.wait(0.1)
		end
	end

	return false
end

local function ultPhase()
	unlink()
	setPhase("Ult on - using Twin Fangs")

	local deadline = tick() + 8
	while running and not twinBusy and tick() < deadline do
		local c = localPlayer.Character
		if not c or not c:GetAttribute("Ulted") then break end
		pressKey(CFG.MOVE_KEY)
		task.wait(0.25)
	end

	while twinBusy do
		task.wait(0.2)
	end
end

local function mainLoop()
	while running do
		local ok, err = pcall(function()
			if farmPhase() then
				ultPhase()
			end
		end)

		if not ok then
			warn("[AutoTwinFangs] " .. tostring(err))
			task.wait(1)
		end
	end
end

local function startBot()
	if running then return end
	running = true

	if localPlayer.Character then
		task.spawn(hookCharacter, localPlayer.Character)
	end

	charConn = localPlayer.CharacterAdded:Connect(function(char)
		task.wait(0.1)
		hookCharacter(char)
	end)

	task.spawn(mainLoop)
end

local function stopBot()
	running = false
	if charConn then charConn:Disconnect() charConn = nil end
	unlink()
	setPhase("Stopped")
end

------------------------------------------------------------------
-- invisible (taken from the original script)
-- every Heartbeat it plays a frozen animation (71181015443030 at 13.45s,
-- huge weight) and stops it again in RenderStepped; your own body shows at 50%
------------------------------------------------------------------
local invisOn   = false
local invisBusy = false
local invisTrack
local invisBeat, invisCharConn
local dimConns = {}

local function dimPart(part)
	if not part:IsA("BasePart") then return end
	if part.Name == "HumanoidRootPart" then return end
	if part.Transparency == 1 then return end
	if part.Name:lower():find("hitbox") then return end

	part.LocalTransparencyModifier = 0.5
	table.insert(dimConns, part:GetPropertyChangedSignal("LocalTransparencyModifier"):Connect(function()
		if invisOn and part.LocalTransparencyModifier ~= 0.5 then
			part.LocalTransparencyModifier = 0.5
		end
	end))
end

local function dimCharacter(char)
	for _, d in ipairs(char:GetDescendants()) do
		dimPart(d)
	end

	table.insert(dimConns, char.DescendantAdded:Connect(function(d)
		if invisOn then dimPart(d) end
	end))
end

local function stopInvisTrack()
	if invisTrack then
		pcall(function()
			if invisTrack.IsPlaying then invisTrack:Stop() end
			invisTrack:Destroy()
		end)
		invisTrack = nil
	end
end

local function invisStep()
	if not invisOn or invisBusy then return end

	local char = localPlayer.Character
	local hum  = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local animator = hum and hum:FindFirstChildOfClass("Animator")
	if not hum or not root or not animator then return end
	if hum.Health <= 0 then return end

	invisBusy = true

	pcall(function()
		local velocity = root.Velocity

		local anim = Instance.new("Animation")
		anim.AnimationId = "rbxassetid://71181015443030"
		invisTrack = animator:LoadAnimation(anim)
		invisTrack.Priority = Enum.AnimationPriority.Action4
		invisTrack:Play()
		invisTrack:AdjustSpeed(0)
		invisTrack:AdjustWeight(2e9)
		invisTrack.TimePosition = 13.45

		RunService.RenderStepped:Wait()

		stopInvisTrack()
		root.Velocity = velocity
	end)

	invisBusy = false
end

local function setInvisible(on)
	if on == invisOn then return end
	invisOn = on

	if on then
		if localPlayer.Character then dimCharacter(localPlayer.Character) end

		invisCharConn = localPlayer.CharacterAdded:Connect(function(char)
			task.wait(0.1)
			if invisOn then dimCharacter(char) end
		end)

		invisBeat = RunService.Heartbeat:Connect(invisStep)
	else
		if invisBeat then invisBeat:Disconnect() invisBeat = nil end
		if invisCharConn then invisCharConn:Disconnect() invisCharConn = nil end

		for _, c in ipairs(dimConns) do
			pcall(function() c:Disconnect() end)
		end
		dimConns = {}

		stopInvisTrack()

		local char = localPlayer.Character
		if char then
			for _, d in ipairs(char:GetDescendants()) do
				if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
					d.LocalTransparencyModifier = 0
				end
			end
		end
	end
end

