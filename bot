------------------------------------------------------------------
-- twin fangs routine (runs when the Twin Fangs animation plays)
------------------------------------------------------------------
local function runTwinFangs(track)
	if twinBusy then return end
	twinBusy = true
	setPhase("Twin Fangs")

	local startedAt = tick()
	local myRoot0 = rootOf(localPlayer.Character)
	local savedCF = myRoot0 and myRoot0.CFrame
	local cutoff = false
	local keepVel = true
	local deadline = startedAt + 3

	-- cutoff: animation passes 70/30 s, stops, or CUTOFF_TIME (1.85 s, hard limit) pass
	task.spawn(function()
		while true do
			task.wait()
			local past = (not track.IsPlaying) or track.TimePosition >= 70 / 30 or tick() - startedAt >= CFG.CUTOFF_TIME
			if past then break end
		end
		cutoff = true
	end)

	-- keep your velocity at zero while linked
	task.spawn(function()
		while keepVel do
			local r = rootOf(localPlayer.Character)
			if r then
				r.AssemblyLinearVelocity  = Vector3.zero
				r.AssemblyAngularVelocity = Vector3.zero
			end
			RunService.Heartbeat:Wait()
		end
	end)

	-- hit everyone: link, wait for their hit animation (max PER_TARGET_MAX s), next.
	-- HARD limit: the whole hit phase ends at CUTOFF_TIME, the time left is shared between
	-- the remaining players so everyone gets a turn as far as the time allows.
	local queue = {}
	local inQueue = {}
	for _, p in ipairs(plannedQueue or {}) do
		if p.Parent and rootOf(p.Character) and humOf(p.Character) then
			table.insert(queue, p)
			inQueue[p] = true
		end
	end
	for _, p in ipairs(twinTargetList()) do      -- anyone who joined since, so nobody is missed
		if not inQueue[p] then table.insert(queue, p) end
	end
	plannedQueue = nil
	local hardEnd = startedAt + CFG.CUTOFF_TIME

	for idx, target in ipairs(queue) do
		if not running or cutoff or tick() >= hardEnd then break end
		-- camera stays on the ONE player picked in ultPhase (no switching between targets)

		local tChar = target.Character
		local tRoot, tHum = rootOf(tChar), humOf(tChar)
		local mChar = localPlayer.Character
		local mRoot = rootOf(mChar)

		if tRoot and tHum and mRoot then
			local left = #queue - idx + 1
			local per = math.clamp((hardEnd - tick()) / left, 0.05, CFG.PER_TARGET_MAX)

			link(mRoot, tRoot, humOf(mChar))

			local hit = false
			local animator = tHum:FindFirstChildOfClass("Animator")
			local conn = (animator and animator.AnimationPlayed or tHum.AnimationPlayed):Connect(function(tr)
				local id = tr.Animation.AnimationId
				if id:match("18896222853") or id:match("137434257516014") then
					hit = true
				end
			end)

			local t0 = tick()
			while running and not hit and not cutoff and tick() - t0 < per and tick() < hardEnd do
				RunService.Heartbeat:Wait()
			end

			conn:Disconnect()
			if hit then stats.hits += 1 end
		end
	end

	unlink()
	keepVel = false

	-- drop to the void at the cutoff
	local waitUntil = tick() + 3
	while running and not cutoff and tick() < waitUntil do
		task.wait()
	end

	-- anchor at the chosen height (default -501y, zero velocity every Heartbeat) instead of dropping to -10000y
	setPhase("Anchored at " .. math.floor(CFG.VOID_POS.Y + 0.5) .. "y")
	ensureVoidPlatform()
	local function pose()
		local r = rootOf(localPlayer.Character)
		if not r then return end
		r.AssemblyLinearVelocity  = Vector3.zero
		r.AssemblyAngularVelocity = Vector3.zero
		r.CFrame = CFrame.new(CFG.VOID_POS)
	end
	pose()
	local poseConn = RunService.Heartbeat:Connect(pose)

	-- come back once the delay passed and the ult is over (always runs, even after Stop)
	local t1 = tick()
	while running and tick() - t1 < CFG.RETURN_DELAY do
		task.wait(0.1)
	end

	local lim = tick() + 6
	while running do
		local c = localPlayer.Character
		if not c or not c:GetAttribute("Ulted") or tick() >= lim then break end
		task.wait(0.2)
	end

	poseConn:Disconnect()

	-- for safety go to -555y instead of returning to where you were
	local r2 = rootOf(localPlayer.Character)
	if r2 then
		r2.CFrame = CFrame.new(CFG.VOID_POS.X, CFG.SAFE_Y, CFG.VOID_POS.Z)
		zero(r2)
	end

	stats.ults += 1
	twinBusy = false
end

------------------------------------------------------------------
-- escape: someone plays the trigger animation on you -> teleport + anchored at -501y for 10s
-- Detected the moment the animation starts (AnimationPlayed on every other player), only when
-- that player is within ESCAPE_RANGE of you. After ESCAPE_TIME you go back to where you were.
-- Ignored while Twin Fangs is running (you are anchored down there anyway).
------------------------------------------------------------------
local escConns, escPlatform = {}, nil
local escapeAlive = true

local function ensureEscPlatform()
	if escPlatform and escPlatform.Parent then return end
	local pl = Instance.new("Part")
	pl.Name = "TFEscapePlatform"
	pl.Size = Vector3.new(2048, 10, 2048)
	pl.Position = Vector3.new(0, CFG.ESCAPE_Y - 3 - pl.Size.Y / 2, 0)
	pl.Anchored = true
	pl.CanCollide = true
	pl.Material = Enum.Material.Glass
	pl.Color = Color3.fromRGB(210, 235, 255)
	pl.Transparency = 0.55
	pl.Parent = workspace
	escPlatform = pl
end

local function escape()
	if escaping or twinBusy or not CFG.ESCAPE_ON then return end
	local char = localPlayer.Character
	local root, hum = rootOf(char), humOf(char)
	if not root or not hum or hum.Health <= 0 then return end

	escaping = true
	local backCF = (glueHome and glueHomeRoot == root) and glueHome or root.CFrame
	unlink()
	ensureEscPlatform()

	local target = Vector3.new(0, CFG.ESCAPE_Y, 0)
	local function pose()
		local r = rootOf(localPlayer.Character)
		if not r then return end
		r.AssemblyLinearVelocity  = Vector3.zero
		r.AssemblyAngularVelocity = Vector3.zero
		r.CFrame = CFrame.new(target)
	end
	setPhase("ESCAPE: anchored at " .. CFG.ESCAPE_Y .. "y for " .. CFG.ESCAPE_TIME .. "s")
	pose()
	local conn = RunService.Heartbeat:Connect(pose)

	local t0 = tick()
	while escapeAlive and running and tick() - t0 < CFG.ESCAPE_TIME do
		task.wait(0.1)
	end
	conn:Disconnect()

	local r2 = rootOf(localPlayer.Character)
	if r2 and escapeAlive then
		r2.CFrame = backCF
		zero(r2)
	end
	escaping = false
end

local function watchChar(char)
	local hum = char:WaitForChild("Humanoid", 5)
	if not hum then return end
	local animator = hum:FindFirstChildOfClass("Animator")
	local sig = animator and animator.AnimationPlayed or hum.AnimationPlayed
	table.insert(escConns, sig:Connect(function(tr)
		if not escapeAlive or not CFG.ESCAPE_ON then return end
		if not tostring(tr.Animation.AnimationId):match(CFG.ESCAPE_ANIM) then return end
		local r, mine = rootOf(char), rootOf(localPlayer.Character)
		if r and mine and (r.Position - mine.Position).Magnitude <= CFG.ESCAPE_RANGE then
			task.spawn(escape)
		end
	end))
end

local function watchPlayer(p)
	if p == localPlayer then return end
	if p.Character then task.spawn(watchChar, p.Character) end
	table.insert(escConns, p.CharacterAdded:Connect(function(c) task.spawn(watchChar, c) end))
end

for _, p in ipairs(Players:GetPlayers()) do watchPlayer(p) end
table.insert(escConns, Players.PlayerAdded:Connect(watchPlayer))

