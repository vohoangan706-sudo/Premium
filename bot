	if voidHealthConn then voidHealthConn:Disconnect() voidHealthConn = nil end
	if voidFollowConn then voidFollowConn:Disconnect() voidFollowConn = nil end

	voidFollowConn = RunService.RenderStepped:Connect(function()
		local r = char:FindFirstChild("HumanoidRootPart")
		if r then
			voidHealth = hum.Health
			voidPart.CFrame = CFrame.new(r.Position.X, -10008, r.Position.Z)
		end
	end)

	voidHealthConn = hum.HealthChanged:Connect(function(h)
		local r = char:FindFirstChild("HumanoidRootPart")
		if h <= 0 and r and r.CFrame.Y <= 0 then
			hum.Health = voidHealth
		end
	end)
end

