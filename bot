------------------------------------------------------------------
-- auto spectate
-- Re-applied every frame AFTER the game's camera script (BindToRenderStep at Camera+1),
-- so the game / your own character can't pull the camera back.
------------------------------------------------------------------
local specPlayer
local specBeat, specRender
local plannedQueue          -- players picked in advance to get Twin Fangs (spectated during the ult)

-- We drive the camera CFrame ourselves (Scriptable) instead of only changing CameraSubject:
-- if the game's camera script doesn't follow CameraSubject, the camera just never moved.
local function specApply()
	local cam = workspace.CurrentCamera
	if not cam then return end

	local char = specPlayer and specPlayer.Character
	local hrp = char and rootOf(char)
	if not hrp or not hrp.Parent then
		-- target gone: hand the camera back to your own character
		local own = humOf(localPlayer.Character)
		if own then
			if cam.CameraType ~= Enum.CameraType.Custom then cam.CameraType = Enum.CameraType.Custom end
			if cam.CameraSubject ~= own then cam.CameraSubject = own end
		end
		return
	end

	local hum = humOf(char)
	if hum and cam.CameraSubject ~= hum then cam.CameraSubject = hum end
	if cam.CameraType ~= Enum.CameraType.Scriptable then cam.CameraType = Enum.CameraType.Scriptable end

	local focus = hrp.Position + Vector3.new(0, 2, 0)
	local pos = focus - hrp.CFrame.LookVector * CFG.SPECTATE_DIST + Vector3.new(0, 5, 0)
	cam.CFrame = CFrame.lookAt(pos, focus)
end

local function unbindSpec()
	pcall(function() RunService:UnbindFromRenderStep("TFSpectate") end)
	if specBeat   then specBeat:Disconnect()   specBeat   = nil end
	if specRender then specRender:Disconnect() specRender = nil end
end

local function setSpectate(player)
	if not CFG.SPECTATE or not player or player == localPlayer then return end
	if specPlayer == player and specBeat then return end
	specPlayer = player

	unbindSpec()
	-- three layers so the game can't win: last in the render step, plus RenderStepped and Heartbeat
	local okBind = pcall(function()
		RunService:BindToRenderStep("TFSpectate", 99999, specApply)   -- far after Last (2000): nothing else can run after us
	end)
	if not okBind then
		specRender = RunService.RenderStepped:Connect(specApply)
	end
	specBeat = RunService.Heartbeat:Connect(specApply)
	specApply()
end

local function clearSpectate()
	specPlayer = nil
	unbindSpec()

	local cam = workspace.CurrentCamera
	local hum = humOf(localPlayer.Character)
	if cam and hum then
		pcall(function()
			cam.CameraSubject = hum
			cam.CameraType = Enum.CameraType.Custom
		end)
	end
end

------------------------------------------------------------------
-- anti-hit (rebuilt from what the original does, see notes)
-- When you get hit you are ragdolled: a "Ragdoll" / "RagdollSim" object appears in your
-- character. While that lasts, the server is shown your root far away (desync), and your
-- real position is put back before every frame is drawn, so you see nothing odd.
-- Not active while Twin Fangs is running, when you are dead, or when an ExtraHitbox exists.
------------------------------------------------------------------
local ragdolled = false
local antiCharConn, antiAddConn, antiRemConn, antiHealthConn, antiBeat, antiRender
local hitUntil = 0     -- desync is on until this time after a health loss
local antiRealCF

local function hasRagdoll(char)
	if not char then return false end
	return char:FindFirstChild("Ragdoll", true) ~= nil or char:FindFirstChild("RagdollSim", true) ~= nil
end

local function antiStop()
	if antiAddConn then antiAddConn:Disconnect() antiAddConn = nil end
	if antiRemConn then antiRemConn:Disconnect() antiRemConn = nil end
	if antiHealthConn then antiHealthConn:Disconnect() antiHealthConn = nil end
	ragdolled = false
end

local function antiWatch(char)
	antiStop()
	if not char then return end

	local hum = char:WaitForChild("Humanoid", 5)
	if not hum then return end

	antiAddConn = char.DescendantAdded:Connect(function(d)
		if (d.Name == "Ragdoll" or d.Name == "RagdollSim")
			and hum.Health > 0 and not char:FindFirstChild("ExtraHitbox") then
			ragdolled = true
		end
	end)

	antiRemConn = char.DescendantRemoving:Connect(function(d)
		if d.Name == "Ragdoll" or d.Name == "RagdollSim" then
			task.defer(function()
				if not hasRagdoll(char) then ragdolled = false end
			end)
		end
	end)

	if hasRagdoll(char) and hum.Health > 0 then ragdolled = true end

	-- any health loss at all (even 1 hp) counts as being hit
	local lastHealth = hum.Health
	antiHealthConn = hum.HealthChanged:Connect(function(h)
		if h < lastHealth and h > 0 then
			hitUntil = tick() + CFG.ANTI_HIT_HOLD
		end
		lastHealth = h
	end)
end

local function antiStart()
	if antiBeat then return end

	antiWatch(localPlayer.Character)
	antiCharConn = localPlayer.CharacterAdded:Connect(function(char)
		task.wait(0.1)
		antiWatch(char)
	end)

	-- after physics: show the server the fake position
	antiBeat = RunService.Heartbeat:Connect(function()
		if not CFG.ANTI_HIT or twinBusy or escaping then return end
		if not ragdolled and tick() >= hitUntil then return end
		local root = rootOf(localPlayer.Character)
		local hum = humOf(localPlayer.Character)
		if not root or not hum or hum.Health <= 0 then return end

		antiRealCF = root.CFrame
		root.CFrame = CFrame.new(CFG.DESYNC_POS)
	end)

	-- before the frame is drawn: put your real position back
	antiRender = RunService.RenderStepped:Connect(function()
		if antiRealCF then
			local root = rootOf(localPlayer.Character)
			if root then root.CFrame = antiRealCF end
			antiRealCF = nil
		end
	end)
end

local function antiShutdown()
	if antiBeat then antiBeat:Disconnect() antiBeat = nil end
	if antiRender then antiRender:Disconnect() antiRender = nil end
	if antiCharConn then antiCharConn:Disconnect() antiCharConn = nil end
	antiStop()
	if antiRealCF then
		local root = rootOf(localPlayer.Character)
		if root then root.CFrame = antiRealCF end
		antiRealCF = nil
	end
end

antiStart()

------------------------------------------------------------------
-- targeting (immunity checks ported from the original; friends skipped by default)
------------------------------------------------------------------
local IMMUNE = { "ForceField", "AbsoluteImmortal", "BeingGrabbed", "HunterCounter", "AtomicCounter", "forcefield", "Counter" }

-- Friend lookups are web calls that can block for a second or more, which froze the farm
-- loop whenever a new player showed up. Now they run in the background; until the answer
-- is known the player is treated as a friend (= skipped), so nothing ever waits.
local friendCache, friendPending = {}, {}

local function lookupFriend(p)
	if friendPending[p.UserId] then return end
	friendPending[p.UserId] = true
	task.spawn(function()
		local ok, res = pcall(function() return localPlayer:IsFriendsWith(p.UserId) end)
		friendCache[p.UserId] = (ok and res) and true or false
		friendPending[p.UserId] = nil
	end)
end

local function isFriend(p)
	local v = friendCache[p.UserId]
	if v == nil then
		lookupFriend(p)
		return true
	end
	return v
end

for _, p in ipairs(Players:GetPlayers()) do
	if p ~= localPlayer then lookupFriend(p) end
end
local friendAddConn = Players.PlayerAdded:Connect(function(p) lookupFriend(p) end)

local function hittable(p)
	if p == localPlayer then return false end
	if not CFG.HIT_FRIENDS and isFriend(p) then return false end

	local c = p.Character
	local hum, root = humOf(c), rootOf(c)
	if not hum or not root or hum.Health <= 0 then return false end

	for _, name in ipairs(IMMUNE) do
		if c:FindFirstChild(name) then return false end
	end
	if c:FindFirstChildWhichIsA("ForceField") then return false end
	if hasAnim(hum, "15128849047") then return false end
	if c:GetAttribute("Ulted") and c:GetAttribute("Character") == "Batter" then return false end

	local pos = root.Position
	if pos.X < CFG.MINX or pos.X > CFG.MAXX or pos.Z < CFG.MINZ or pos.Z > CFG.MAXZ then
		return false
	end

	return true
end

local function isStunned(p)
	local hum = humOf(p.Character)
	return hum and (hasAnim(hum, "18896222853") or hasAnim(hum, "137434257516014")) or false
end

-- farm: lowest-health hittable player (same idea as the original picker)
local function pickFarmTarget(avoid)
	local best, bestHp = nil, math.huge
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= avoid and hittable(p) then
			local hp = humOf(p.Character).Health
			if hp < bestHp then
				best, bestHp = p, hp
			end
		end
	end
	return best
end

-- twin fangs: EVERY player with a body except you and friends, whatever their character,
-- immunity or state (shuffled so nobody is always last)
local function twinTargetList()
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= localPlayer and not isFriend(p) and rootOf(p.Character) and humOf(p.Character) then
			table.insert(list, p)
		end
	end
	for i = #list, 2, -1 do
		local j = math.random(i)
		list[i], list[j] = list[j], list[i]
	end
	return list
end

