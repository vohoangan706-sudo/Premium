--[[
  AUTO TWIN FANGS FARM  (own panel, starts as soon as you execute it)

  Loop:
    1. FARM   - glue (PhysicsRepRootPart) to a player and spam M1 + dash + moves 1-4 to build the ult.
                Every few seconds it also presses the ult key; when the ult goes
                off your character gets the "Ulted" attribute and the loop moves on.
    2. ULT    - once the ult is on, it presses the Twin Fangs key (2). The Project Yielding
                routine then runs when the Twin Fangs animation plays: glue to each hittable
                player in turn until their hit animation (max PER_TARGET_MAX s), then at the
                animation cutoff get anchored at -777y (no more -10000y drop).
    3. RETURN - after RETURN_DELAY s in the void (and once the ult is over) go back to where you were.
    4. REPEAT - back to step 1.

  On execute it also turns ON: antivoid (void immunity) and invisibility.

  Friends are skipped: they are never glued, hit or orbited (CFG.HIT_FRIENDS = false).
  The panel's "Hit friends" button is locked OFF and cannot be turned on.

  Things I could not verify (change them in CFG if wrong):
    - ULT_KEY = G, MOVE_KEY = 2 and DASH_KEY = Q are default keybinds I'm assuming
    - the ult-ready signal is unknown, so it just tries the ult key every ULT_TRY_EVERY s
  Needs an executor with: getgenv, sethiddenproperty, VirtualInputManager access.
  Character must be "Purple" (the Twin Fangs character), same as the original.
]]

if getgenv().TFStop then pcall(getgenv().TFStop) end   -- re-run safe

local Players             = game:GetService("Players")
local RunService          = game:GetService("RunService")
local HttpService         = game:GetService("HttpService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local localPlayer         = Players.LocalPlayer

------------------------------------------------------------------
-- settings
------------------------------------------------------------------
local CFG = {
	ULT_KEY        = Enum.KeyCode.G,      -- ultimate key
	HIT_FRIENDS    = false,               -- LOCKED: friends are always skipped (the panel button cannot turn this on)
	TARGET_TIME    = 6,                   -- farm: seconds on one target before switching
	ULT_TRY_EVERY  = 2,                   -- farm: press the ult key this often
	USE_MOVES      = true,                -- farm: also use dash + abilities
	FARM_SLOTS     = { 1, 2, 3, 4 },      -- farm: ability keys to use (1 to 4)
	MOVE_EVERY     = 0.6,                 -- farm: try the next ability this often
	DASH_KEY       = Enum.KeyCode.Q,      -- dash key
	DASH_EVERY     = 2.5,                 -- farm: dash this often
	MOVE_KEY       = Enum.KeyCode.Two,    -- Twin Fangs move (slot 2 while ulted)
	PER_TARGET_MAX = 0.4,                 -- twin fangs: max seconds per target
	CUTOFF_TIME    = 1.85,                -- HARD limit: seconds after Twin Fangs starts, then you are anchored at -777y
	RETURN_DELAY   = 3,                   -- seconds anchored at -777y before coming back
	VOID_POS       = Vector3.new(0, -777, 0),   -- where you get anchored after the grab
	MINX = -500, MAXX = 800, MINZ = -600, MAXZ = 700,   -- arena bounds (from the original)
}

