-- Shutdown: stop everything, destroy the panel AND the toggle button, and once that is
-- finished teleport you up to 500y.
local shuttingDown = false
shutdownBtn.MouseButton1Click:Connect(function()
	if shuttingDown then return end
	shuttingDown = true
	shutdownBtn.Text = "Shutting down..."

	task.spawn(function()
		-- 1) stop the bot, but keep antivoid up until a running Twin Fangs cast has brought you back
		stopBot()
		local t0 = tick()
		while twinBusy and tick() - t0 < 10 do
			task.wait(0.1)
		end

		-- 2) full shutdown: restores everything and destroys the panel and the toggle button
		pcall(function() getgenv().TFStop() end)

		-- 3) shutdown finished: teleport up to 500y
		local r = rootOf(localPlayer.Character)
		if r then
			r.AssemblyLinearVelocity  = Vector3.zero
			r.AssemblyAngularVelocity = Vector3.zero
			r.CFrame = CFrame.new(r.Position.X, 500, r.Position.Z)
		end
	end)
end)

