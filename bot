------------------------------------------------------------------
-- glue (PhysicsRepRootPart link)
------------------------------------------------------------------
local linkMy, linkTheir
local linkBeat, linkRot

local function unlink()
	if linkBeat then linkBeat:Disconnect() linkBeat = nil end
	if linkRot  then linkRot:Disconnect()  linkRot  = nil end

	setRep(linkMy, nil)
	setRep(linkTheir, nil)

	if linkMy and linkMy.Parent then
		linkMy.CFrame = CFrame.new(linkMy.Position)
		zero(linkMy)
		local hum = linkMy.Parent:FindFirstChildOfClass("Humanoid")
		if hum then pcall(function() hum.AutoRotate = true end) end
	end

	linkMy, linkTheir = nil, nil
end

local function link(a, b, hum)
	unlink()
	linkMy, linkTheir = a, b

	if hum then
		linkRot = RunService.RenderStepped:Connect(function()
			if hum.Parent then pcall(function() hum.AutoRotate = false end) end
		end)
	end

	a.CFrame = CFrame.new(0, 0, 5)
	zero(a)
	setRep(a, a)
	setRep(a, b)

	linkBeat = RunService.Heartbeat:Connect(function()
		if not a.Parent or not b.Parent then
			unlink()
			return
		end
		a.CFrame = CFrame.new(0, 0, 5)
		zero(a)
		setRep(a, b)
	end)
end

