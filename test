--[[
  VOID KILL panel  -  one button: "Suiryu void"
  Tap players in the list to select them ("Selected: N", saved in getgenv().SelectedPlayers as [UserId] = true).
  Press "Suiryu void" and it runs the Twin Fangs void ONCE on the selected players:
    antivoid turns on  >  press 2 until Twin Fangs starts (needs your ult + the Purple character)  >
    glue (your own HumanoidRootPart orbit-sweeps GLUE_GAP studs around each target, super fast, every
    Heartbeat, re-aimed at their LIVE position every frame so it keeps up even while they run - no
    PhysicsRepRootPart trick) to each selected player, 0.3s each (tween then orbit), ending early if their hit
    animation plays, hard limit 2s total from the start of Twin Fangs  >  tween (noclip) to -1000y onto a custom platform, 3s.
  Press it again for another run. The x closes the panel and turns antivoid off.
]]

if getgenv().SuiryuVoidStop then pcall(getgenv().SuiryuVoidStop) end

local Players       = game:GetService("Players")
local TweenService  = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local VIM        = game:GetService("VirtualInputManager")
local me         = Players.LocalPlayer

getgenv().SelectedPlayers = getgenv().SelectedPlayers or {}
local Selected = getgenv().SelectedPlayers

local function root(c) return c and c:FindFirstChild("HumanoidRootPart") end
local function hum(c)  return c and c:FindFirstChildOfClass("Humanoid") end

local function zero(p)
	p.AssemblyLinearVelocity, p.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
end

local function setRep(p, v)
	if sethiddenproperty and p and p.Parent then pcall(sethiddenproperty, p, "PhysicsRepRootPart", v) end
end

------------------------------------------------------------------
-- antivoid (turns on when the function starts)
------------------------------------------------------------------
local voidOn = false
local voidPart, voidFollowConn, voidHealthConn, voidCharConn, voidFallenConn
local voidHealth = 100

local function hookVoid(char)
	if not char then return end
	local h = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 3)
	local r = char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 3)
	if not h or not r or not voidOn then return end

	voidHealth = h.Health
	if voidHealthConn then voidHealthConn:Disconnect() voidHealthConn = nil end
	if voidFollowConn then voidFollowConn:Disconnect() voidFollowConn = nil end

	voidFollowConn = RunService.RenderStepped:Connect(function()
		local rr = char:FindFirstChild("HumanoidRootPart")
		if rr and voidPart then
			voidHealth = h.Health
			voidPart.CFrame = CFrame.new(rr.Position.X, -10008, rr.Position.Z)
		end
	end)

	voidHealthConn = h.HealthChanged:Connect(function(hp)
		local rr = char:FindFirstChild("HumanoidRootPart")
		if hp <= 0 and rr and rr.CFrame.Y <= 0 then h.Health = voidHealth end
	end)
end

local function setAntivoid(on)
	if on == voidOn then return end
	voidOn = on

	if on then
		workspace.FallenPartsDestroyHeight = (0/0)
		voidFallenConn = workspace:GetPropertyChangedSignal("FallenPartsDestroyHeight"):Connect(function()
			local v = workspace.FallenPartsDestroyHeight
			if voidOn and v == v then workspace.FallenPartsDestroyHeight = (0/0) end
		end)

		voidPart = Instance.new("Part")
		voidPart.Name = HttpService:GenerateGUID()
		voidPart.CFrame = CFrame.new(0, -10008, 0)
		voidPart.Anchored = true
		voidPart.Size = Vector3.new(2048, 10, 2048)
		voidPart.Transparency = 0.5
		voidPart.CanCollide = true
		voidPart.Parent = workspace

		task.spawn(hookVoid, me.Character)
		voidCharConn = me.CharacterAdded:Connect(function(char)
			task.wait(0.1)
			hookVoid(char)
		end)
	else
		if voidFallenConn then voidFallenConn:Disconnect() voidFallenConn = nil end
		if voidCharConn then voidCharConn:Disconnect() voidCharConn = nil end
		if voidHealthConn then voidHealthConn:Disconnect() voidHealthConn = nil end
		if voidFollowConn then voidFollowConn:Disconnect() voidFollowConn = nil end
		pcall(function() if voidPart then voidPart:Destroy() end end)
		voidPart = nil
		pcall(function() workspace.FallenPartsDestroyHeight = -500 end)
	end
end

------------------------------------------------------------------
-- Suiryu void = Twin Fangs void, once
------------------------------------------------------------------
local VOID_Y = -1000
local GLUE_GAP = 3                          -- orbit radius (studs) around the target
local PER_TARGET = 0.3                      -- window per target: tween first, orbit sweep for the rest
local DROP_TIME = 0.05                     -- tween time down to VOID_Y (super fast)
local TWEEN_TIME = 0.15                     -- tween time per target
local ORBIT_SPEED = 30                      -- radians/second - how fast you sweep around them
local platform
local function ensurePlatform()
	if platform and platform.Parent then return end
	local p = Instance.new("Part")
	p.Name = "SuiryuVoidPlatform"
	p.Size = Vector3.new(2048, 10, 2048)
	p.Position = Vector3.new(0, VOID_Y - 5, 0)
	p.Anchored = true
	p.CanCollide = true
	p.Material = Enum.Material.Glass
	p.Color = Color3.fromRGB(210, 235, 255)
	p.Transparency = 0.55
	p.Parent = workspace
	platform = p
end

local busy = false
local setStatus = function() end

local function suiryuVoid()
	if busy then return end
	busy = true
	setAntivoid(true)                      -- auto antivoid when the function starts
	ensurePlatform()

	local ok, err = pcall(function()
		local char = me.Character
		local h, r = hum(char), root(char)
		if not h or not r then setStatus("No character") return end

		-- press 2 until the Twin Fangs animation plays (max 8s)
		setStatus("Pressing 2 ...")
		local track
		local conn = h.AnimationPlayed:Connect(function(t)
			if t.Animation.AnimationId:match("18896229321") then track = t end
		end)
		local giveUp = tick() + 8
		while not track and tick() < giveUp do
			VIM:SendKeyEvent(true, Enum.KeyCode.Two, false, game)
			task.wait(0.05)
			VIM:SendKeyEvent(false, Enum.KeyCode.Two, false, game)
			task.wait(0.2)
		end
		conn:Disconnect()
		if not track then setStatus("Twin Fangs did not start (ult ready? Purple?)") return end

		local startedAt = tick()
		local hardEnd = startedAt + 2

		-- selected players, shuffled
		local queue = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= me and Selected[p.UserId] and root(p.Character) and hum(p.Character) then table.insert(queue, p) end
		end
		for i = #queue, 2, -1 do
			local j = math.random(i)
			queue[i], queue[j] = queue[j], queue[i]
		end
		setStatus("Twin Fangs: " .. #queue .. " target(s)")

		local beat
		local function stopOrbit()
			if beat then beat:Disconnect() beat = nil end
		end

		for i, target in ipairs(queue) do
			if tick() >= hardEnd or not track.IsPlaying or track.TimePosition >= 70 / 30 then break end
			local tRoot, tHum = root(target.Character), hum(target.Character)
			r = root(me.Character)
			if tRoot and tHum and r then
				local per = math.min(PER_TARGET, hardEnd - tick())

				stopOrbit()
				local t0 = tick()   -- the 0.3s window covers tween + orbit
				-- 1) fastest tween onto the target
				pcall(function()
					local goal = tRoot.CFrame * CFrame.new(0, 0, GLUE_GAP)
					local tw = TweenService:Create(r, TweenInfo.new(TWEEN_TIME, Enum.EasingStyle.Linear), {CFrame = goal})
					tw:Play()
					local tt = tick()
					while tw.PlaybackState == Enum.PlaybackState.Playing and tick() - tt < TWEEN_TIME + 0.03 do RunService.Heartbeat:Wait() end
					tw:Cancel()
				end)
				-- 2) orbit sweep for the rest of the window
				local angle = 0
				local lastT = tick()
				beat = RunService.Heartbeat:Connect(function()
					local now = tick()
					local dt = now - lastT
					lastT = now
					angle += ORBIT_SPEED * dt

					local rr = root(me.Character)
					if not rr or not tRoot.Parent then return end
					local center = tRoot.Position           -- their LIVE position: keeps up even while they run
					local offset = Vector3.new(math.cos(angle), 0, math.sin(angle)) * GLUE_GAP
					local pos = center + offset
					rr.CFrame = CFrame.new(pos, center)      -- also faces the target while sweeping around them
					zero(rr)
				end)

				local hit = false
				local c2 = tHum.AnimationPlayed:Connect(function(t)
					local id = t.Animation.AnimationId
					if id:match("18896222853") or id:match("137434257516014") then hit = true end
				end)
				while not hit and tick() - t0 < per and tick() < hardEnd do RunService.Heartbeat:Wait() end
				c2:Disconnect()
			end
		end
		stopOrbit()

		-- let the 2s limit pass
		while tick() < hardEnd and track.IsPlaying do task.wait() end

		-- then tween super fast down to -1000y (noclip) onto our own platform, stay 3s
		setStatus("Tweening to " .. VOID_Y .. "y")
		ensurePlatform()
		local noclip = RunService.Stepped:Connect(function()
			local c = me.Character
			if not c then return end
			for _, d in ipairs(c:GetDescendants()) do
				if d:IsA("BasePart") then d.CanCollide = false end
			end
		end)
		local rr = root(me.Character)
		if rr then
			pcall(function()
				local tw = TweenService:Create(rr, TweenInfo.new(DROP_TIME, Enum.EasingStyle.Linear), {CFrame = CFrame.new(rr.Position.X, VOID_Y + 3, rr.Position.Z)})
				tw:Play()
				local tt = tick()
				while tw.PlaybackState == Enum.PlaybackState.Playing and tick() - tt < DROP_TIME + 0.1 do RunService.Heartbeat:Wait() end
				tw:Cancel()
			end)
			rr = root(me.Character)
			if rr then zero(rr) end
		end
		noclip:Disconnect()
		task.wait(3)
		setStatus("Done")
	end)

	if not ok then setStatus("Error: " .. tostring(err)) end
	busy = false
end

