	for _, player in pairs(Players:GetPlayers()) do
		task.spawn(fn18, player)
	end

	table.insert(fullConns, Players.PlayerAdded:Connect(function(player)
		if player == localPlayer then
			return
		end

		task.spawn(function()
			local now = tick()

			while true do
				RunService.RenderStepped:Wait()
				if not (player:GetAttribute("PreloadDone") or tick() >= now + 30) then
					continue
				end
				break
			end

			if player and player.Parent then
				if player.Character then
					task.spawn(fn17, player, player.Character)
				end

				tbl5[player] = player.CharacterAdded:Connect(function(character)
					task.spawn(fn17, player, character)
				end)
			end
		end)
	end))

	table.insert(fullConns, Players.PlayerRemoving:Connect(function(player)
		if tbl4[player] then
			pcall(function()
				tbl4[player]:Disconnect()
			end)

			tbl4[player] = nil
		end

		if tbl5[player] then
			pcall(function()
				tbl5[player]:Disconnect()
			end)

			tbl5[player] = nil
		end
	end))
task.spawn(function()
		while not stopped do
			if getgenv().desync then
				local now = tick()
	
				repeat
					task.wait()
				until tick() - now >= 20 or not getgenv().desync
	
				getgenv().desync = nil
			end
	
			RunService.RenderStepped:Wait()
		end
	end)
	-- the original's death-counter module also gave tbl4/tbl5 their locals: they are declared above
	getgenv().FullAntiHitStop = function()
		stopped = true
		flag3 = false
		getgenv().desync = nil
		getgenv().FullAntiHitActive = nil
		for _, c in ipairs(fullConns) do pcall(function() c:Disconnect() end) end
		fullConns = {}
		for _, c in pairs(tbl4) do pcall(function() c:Disconnect() end) end
		for _, c in pairs(tbl5) do pcall(function() c:Disconnect() end) end
		tbl4, tbl5 = {}, {}
		pcall(function() model:Destroy() end)
	end
end