--[[
  DUEL FARM  (own panel, starts as soon as you execute it)  -  NO ult building

  Loop (whenever slot 3 is off cooldown and there is someone to hit):
    press 3  >  wait 0.4s  >  glue (PhysicsRepRootPart) to the other players for exactly 0.7s in
    total (split evenly)  >  anchored at -501y for 0.3s  >  anchored at -10000y for RETURN_DELAY s  >
    teleport to -500y.

  No M1, no ult key, no dash/moves. Friends are never targeted.
  Invisibility, antivoid and anti-hit start on execute.
  Needs an executor with: getgenv, sethiddenproperty, VirtualInputManager access.
]]

if getgenv().DFStop then pcall(getgenv().DFStop) end   -- re-run safe

local Players             = game:GetService("Players")
local RunService          = game:GetService("RunService")
local HttpService         = game:GetService("HttpService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local localPlayer         = Players.LocalPlayer

-- the spot you return to: saved right now, before anything else loads
local savedSpot do
	local r0 = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
	savedSpot = r0 and r0.CFrame
end

------------------------------------------------------------------
-- settings
------------------------------------------------------------------
local CFG = {
	HIT_FRIENDS    = false,               -- LOCKED: friends are always skipped
	TARGET_TIME    = 6,                   -- farm: seconds on one target before switching
	DUEL_KEY       = Enum.KeyCode.Three,  -- duel move (slot 3)
	DUEL_WAIT      = 0.4,                 -- seconds between pressing the duel key and the glue
	RETURN_EARLY   = 0.5,                 -- go back to the saved spot this many seconds BEFORE slot 3 comes off cooldown
	DUEL_COOLDOWN  = 19.5,                  -- slot 3 cooldown in seconds; 0 = read it from the hotbar / learn it from the first duel
	DUEL_GAP       = 2,                   -- minimum seconds between two duels
	DUEL_TIME      = 0.7,                 -- EXACT seconds of glue on the other players, split evenly
	HOLD_POS       = Vector3.new(0, -501, 0),     -- anchored here first, right after the glue
	HOLD_TIME      = 0.3,                 -- seconds anchored at -501y
	VOID_POS       = Vector3.new(0, -10000, 0),   -- then anchored here
	RETURN_DELAY   = 3,                   -- seconds anchored before coming back
	RETURN_POS     = Vector3.new(0, -500, 0),     -- where you come back to
	ANTI_HIT       = true,                -- anti-hit (ragdoll desync) is always on, built in (no button)
	ANTI_HIT_HOLD  = 1.0,                 -- anti-hit: seconds the desync stays on after ANY health loss (even 1 hp)
	DESYNC_POS     = Vector3.new(9e9, 9e9, 9e9),
	M1_FORCE_MOBILE = false,              -- M1: treat this device as mobile (use the on-screen M1 button)
	M1_BUTTON_NAME = "",                  -- M1 (mobile): exact name of the M1 button if auto-detect picks the wrong one
	M1_INTERVAL    = 0.05,                -- M1: seconds between clicks (clicks forever, paused only during the ult)
	M1_EXEC        = true,                -- M1: also call the executor's mouse1click when it exists
	MINX = -500, MAXX = 800, MINZ = -600, MAXZ = 700,   -- arena bounds (farm targets only)
}

