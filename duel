workspace.FallenPartsDestroyHeight = (0/0)

local fallenConn = workspace:GetPropertyChangedSignal("FallenPartsDestroyHeight"):Connect(function()
	local h = workspace.FallenPartsDestroyHeight
	if h == h then
		workspace.FallenPartsDestroyHeight = (0/0)
	end
end)

local voidPart = Instance.new("Part")
voidPart.Name = HttpService:GenerateGUID()
voidPart.CFrame = CFrame.new(0, -10008, 0)
voidPart.Anchored = true
voidPart.Size = Vector3.new(2048, 10, 2048)
voidPart.Transparency = 0.5
voidPart.CanCollide = true
voidPart.Parent = workspace

local voidHealth = 100
local voidHealthConn, voidFollowConn

local function hookVoid(char)
	if not char then return end
	local hum  = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 3)
	local root = char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 3)
	if not hum or not root then return end

	voidHealth = hum.Health

	if voidHealthConn then voidHealthConn:Disconnect() voidHealthConn = nil end
	if voidFollowConn then voidFollowConn:Disconnect() voidFollowConn = nil end

	voidFollowConn = RunService.RenderStepped:Connect(function()
		local r = char:FindFirstChild("HumanoidRootPart")
		if r then
			voidHealth = hum.Health
			voidPart.CFrame = CFrame.new(r.Position.X, -10008, r.Position.Z)
		end
	end)

	voidHealthConn = hum.HealthChanged:Connect(function(h)
		local r = char:FindFirstChild("HumanoidRootPart")
		if h <= 0 and r and r.CFrame.Y <= 0 then
			hum.Health = voidHealth
		end
	end)
end

task.spawn(hookVoid, localPlayer.Character)

local voidCharConn = localPlayer.CharacterAdded:Connect(function(char)
	task.wait(0.1)
	hookVoid(char)
end)

------------------------------------------------------------------
-- glue (PhysicsRepRootPart link)
------------------------------------------------------------------
local linkMy, linkTheir
local linkBeat, linkRot
local glueHome, glueHomeRoot   -- where you stood before the glue first moved you to (0,0,5)

local function unlink()
	if linkBeat then linkBeat:Disconnect() linkBeat = nil end
	if linkRot  then linkRot:Disconnect()  linkRot  = nil end

	setRep(linkMy, nil)
	setRep(linkTheir, nil)

	if linkMy and linkMy.Parent then
		linkMy.CFrame = CFrame.new(linkMy.Position)
		zero(linkMy)
		local hum = linkMy.Parent:FindFirstChildOfClass("Humanoid")
		if hum then pcall(function() hum.AutoRotate = true end) end
	end

	linkMy, linkTheir = nil, nil
end

-- put you back where you were before the farm glue moved you (used on stop / shutdown)
local function restoreHome()
	local root = rootOf(localPlayer.Character)
	if root and glueHome and glueHomeRoot == root then
		root.CFrame = glueHome
		zero(root)
	end
	glueHome, glueHomeRoot = nil, nil
end

local function link(a, b, hum)
	unlink()
	if not running then return end   -- stopped / shutting down: never (re)glue, or you stay stuck at (0,0,5)
	if not glueHome or glueHomeRoot ~= a then glueHome, glueHomeRoot = a.CFrame, a end
	linkMy, linkTheir = a, b

	if hum then
		linkRot = RunService.RenderStepped:Connect(function()
			if hum.Parent then pcall(function() hum.AutoRotate = false end) end
		end)
	end

	a.CFrame = CFrame.new(0, 0, 5)
	zero(a)
	setRep(a, a)
	setRep(a, b)

	linkBeat = RunService.Heartbeat:Connect(function()
		if not a.Parent or not b.Parent then
			unlink()
			return
		end
		a.CFrame = CFrame.new(0, 0, 5)
		zero(a)
		setRep(a, b)
	end)
end

