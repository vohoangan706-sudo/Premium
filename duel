-- input
------------------------------------------------------------------
local function pressKey(code)
	pcall(function()
		VirtualInputManager:SendKeyEvent(true, code, false, game)
		task.wait(0.05)
		VirtualInputManager:SendKeyEvent(false, code, false, game)
	end)
end

-- M1.
--   PC:     left mouse button (VirtualInputManager click at the screen center, plus the
--           executor's mouse1click if it has one; CFG.M1_EXEC = false skips that)
--   MOBILE: M1 is an on-screen button, so there is no mouse to click. We find that button in
--           PlayerGui and activate it (firesignal / getconnections, or a touch on it).
--           Mouse events are NOT sent on mobile.
local UserInputService = game:GetService("UserInputService")
local GuiService       = game:GetService("GuiService")

local IS_MOBILE = (UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled) or CFG.M1_FORCE_MOBILE

local m1Button
local m1Warned = false
local m1LastScan = 0
local m1Logged

local function looksLikeM1(btn)
	local name = btn.Name:lower()
	local text = (btn:IsA("TextButton") and btn.Text or ""):lower()
	if CFG.M1_BUTTON_NAME ~= "" then
		return btn.Name == CFG.M1_BUTTON_NAME
	end
	return name == "m1" or text == "m1"
		or name:find("m1", 1, true) ~= nil
		or name:find("attack", 1, true) ~= nil
		or name:find("punch", 1, true) ~= nil
		or name:find("lmb", 1, true) ~= nil
		or name:find("click", 1, true) ~= nil
end

local function findM1Button()
	if m1Button and m1Button.Parent then return m1Button end
	m1Button = nil

	-- scanning the whole PlayerGui is heavy: at most once a second (this was run on every click
	-- whenever the button was missing, which made the build stutter)
	if tick() - m1LastScan < 1 then return nil end
	m1LastScan = tick()

	local pg = localPlayer:FindFirstChild("PlayerGui")
	if not pg then return nil end

	local best, found = nil, {}
	for _, d in ipairs(pg:GetDescendants()) do
		if d:IsA("GuiButton") and looksLikeM1(d) then
			table.insert(found, d:GetFullName())
			if d.Name:lower() == "m1" then best = d end
			best = best or d
		end
	end

	if best then
		m1Button = best
		if m1Logged ~= best then
			m1Logged = best
			warn("[DuelFarm] M1 button: " .. best:GetFullName() .. "  (" .. #found .. " candidate(s))")
		end
	elseif not m1Warned then
		m1Warned = true
		warn("[DuelFarm] no M1 button found in PlayerGui - tell me what the M1 button is called (or set CFG.M1_BUTTON_NAME)")
	end
	return m1Button
end

local function activateButton(btn)
	-- 1) fire the button's own signals
	local fs = rawget(getgenv(), "firesignal")
	if type(fs) == "function" then
		for _, sig in ipairs({ "MouseButton1Down", "MouseButton1Click", "Activated", "MouseButton1Up" }) do
			pcall(function() fs(btn[sig]) end)
		end
	end

	-- 2) or call its connections directly
	local gc = rawget(getgenv(), "getconnections")
	if type(gc) == "function" then
		for _, sig in ipairs({ "Activated", "MouseButton1Click", "MouseButton1Down" }) do
			pcall(function()
				for _, c in ipairs(gc(btn[sig])) do
					pcall(function() c:Fire() end)
				end
			end)
		end
	end

	-- 3) or a real touch on the button
	if not fs and not gc then
		pcall(function()
			local inset = GuiService:GetGuiInset()
			local gui = btn:FindFirstAncestorOfClass("ScreenGui")
			local dy = (gui and gui.IgnoreGuiInset) and 0 or inset.Y
			local c = btn.AbsolutePosition + btn.AbsoluteSize / 2
			VirtualInputManager:SendTouchEvent(1, 0, c.X, c.Y + dy)
			task.wait(0.03)
			VirtualInputManager:SendTouchEvent(1, 2, c.X, c.Y + dy)
		end)
	end
end

local function click()
	if IS_MOBILE then
		local btn = findM1Button()
		if btn then activateButton(btn) end
		return
	end

	local cam = workspace.CurrentCamera
	local size = cam and cam.ViewportSize or Vector2.new(800, 600)
	local x, y = size.X / 2, size.Y / 2

	pcall(function()
		VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
		task.wait(0.03)
		VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
	end)

	if CFG.M1_EXEC then
		local fn = rawget(getgenv(), "mouse1click")
		if type(fn) == "function" then pcall(fn) end
	end
end

local SLOT_KEYS = { Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four }

-- a hotbar slot shows a "Cooldown" child under Base while it is cooling down
local function moveReady(slot)
	local ok, ready = pcall(function()
		local base = localPlayer.PlayerGui.Hotbar.Backpack.Hotbar[tostring(slot)].Base
		return base:FindFirstChild("Cooldown") == nil
	end)
	if ok then return ready end
	return true   -- hotbar not found: just try it
end

-- slot press that works on PC (keyboard) and mobile (on-screen hotbar button)
local function pressSlotKey(code)
	pcall(pressKey, code)
	pcall(function()
		local slot = tostring(({[Enum.KeyCode.One]=1,[Enum.KeyCode.Two]=2,[Enum.KeyCode.Three]=3,[Enum.KeyCode.Four]=4})[code] or "")
		local btn = localPlayer.PlayerGui.Hotbar.Backpack.Hotbar[slot]
		for _, g in ipairs({btn, btn:FindFirstChild("Base")}) do
			if g and g:IsA("GuiButton") then
				for _, sig in ipairs({"MouseButton1Down","MouseButton1Click","Activated","MouseButton1Up"}) do
					if firesignal then pcall(firesignal, g[sig]) end
				end
			end
		end
	end)
end

local plannedQueue          -- players picked in advance (kept in a list so the duel starts without a lookup)

------------------------------------------------------------------
-- anti-hit (rebuilt from what the original does, see notes)
-- When you get hit you are ragdolled: a "Ragdoll" / "RagdollSim" object appears in your
-- character. While that lasts, the server is shown your root far away (desync), and your
-- real position is put back before every frame is drawn, so you see nothing odd.
-- Not active while Twin Fangs is running, when you are dead, or when an ExtraHitbox exists.
------------------------------------------------------------------
local ragdolled = false
local antiCharConn, antiAddConn, antiRemConn, antiHealthConn, antiBeat, antiRender
local hitUntil = 0     -- desync is on until this time after a health loss
local antiRealCF

local function hasRagdoll(char)
	if not char then return false end
	return char:FindFirstChild("Ragdoll", true) ~= nil or char:FindFirstChild("RagdollSim", true) ~= nil
end

local function antiStop()
	if antiAddConn then antiAddConn:Disconnect() antiAddConn = nil end
	if antiRemConn then antiRemConn:Disconnect() antiRemConn = nil end
	if antiHealthConn then antiHealthConn:Disconnect() antiHealthConn = nil end
	ragdolled = false
end

local function antiWatch(char)
	antiStop()
	if not char then return end

	local hum = char:WaitForChild("Humanoid", 5)
	if not hum then return end

	antiAddConn = char.DescendantAdded:Connect(function(d)
		if (d.Name == "Ragdoll" or d.Name == "RagdollSim")
			and hum.Health > 0 and not char:FindFirstChild("ExtraHitbox") then
			ragdolled = true
		end
	end)

	antiRemConn = char.DescendantRemoving:Connect(function(d)
		if d.Name == "Ragdoll" or d.Name == "RagdollSim" then
			task.defer(function()
				if not hasRagdoll(char) then ragdolled = false end
			end)
		end
	end)

	if hasRagdoll(char) and hum.Health > 0 then ragdolled = true end

	-- any health loss at all (even 1 hp) counts as being hit
	local lastHealth = hum.Health
	antiHealthConn = hum.HealthChanged:Connect(function(h)
		if h < lastHealth and h > 0 then
			hitUntil = tick() + CFG.ANTI_HIT_HOLD
		end
		lastHealth = h
	end)
end

local function antiStart()
	if antiBeat then return end

	antiWatch(localPlayer.Character)
	antiCharConn = localPlayer.CharacterAdded:Connect(function(char)
		task.wait(0.1)
		antiWatch(char)
	end)

	-- after physics: show the server the fake position
	antiBeat = RunService.Heartbeat:Connect(function()
		if not CFG.ANTI_HIT or twinBusy then return end
		if not ragdolled and tick() >= hitUntil then return end
		local root = rootOf(localPlayer.Character)
		local hum = humOf(localPlayer.Character)
		if not root or not hum or hum.Health <= 0 then return end

		antiRealCF = root.CFrame
		root.CFrame = CFrame.new(CFG.DESYNC_POS)
	end)

	-- before the frame is drawn: put your real position back
	antiRender = RunService.RenderStepped:Connect(function()
		if antiRealCF then
			local root = rootOf(localPlayer.Character)
			if root then root.CFrame = antiRealCF end
			antiRealCF = nil
		end
	end)
end

local function antiShutdown()
	if antiBeat then antiBeat:Disconnect() antiBeat = nil end
	if antiRender then antiRender:Disconnect() antiRender = nil end
	if antiCharConn then antiCharConn:Disconnect() antiCharConn = nil end
	antiStop()
	if antiRealCF then
		local root = rootOf(localPlayer.Character)
		if root then root.CFrame = antiRealCF end
		antiRealCF = nil
	end
end

antiStart()

------------------------------------------------------------------
-- targeting (immunity checks ported from the original; friends skipped by default)
------------------------------------------------------------------
local IMMUNE = { "ForceField", "AbsoluteImmortal", "BeingGrabbed", "HunterCounter", "AtomicCounter", "forcefield", "Counter" }

-- Friend lookups are web calls that can block for a second or more, which froze the farm
-- loop whenever a new player showed up. Now they run in the background; until the answer
-- is known the player is treated as a friend (= skipped), so nothing ever waits.
local friendCache, friendPending = {}, {}

local function lookupFriend(p)
	if friendPending[p.UserId] then return end
	friendPending[p.UserId] = true
	task.spawn(function()
		local ok, res = pcall(function() return localPlayer:IsFriendsWith(p.UserId) end)
		friendCache[p.UserId] = (ok and res) and true or false
		friendPending[p.UserId] = nil
	end)
end

local function isFriend(p)
	local v = friendCache[p.UserId]
	if v == nil then
		lookupFriend(p)
		return true
	end
	return v
end

for _, p in ipairs(Players:GetPlayers()) do
	if p ~= localPlayer then lookupFriend(p) end
end
local friendAddConn = Players.PlayerAdded:Connect(function(p) lookupFriend(p) end)

local function hittable(p)
	if p == localPlayer then return false end
	if not CFG.HIT_FRIENDS and isFriend(p) then return false end

	local c = p.Character
	local hum, root = humOf(c), rootOf(c)
	if not hum or not root or hum.Health <= 0 then return false end

	for _, name in ipairs(IMMUNE) do
		if c:FindFirstChild(name) then return false end
	end
	if c:FindFirstChildWhichIsA("ForceField") then return false end
	if hasAnim(hum, "15128849047") then return false end
	if c:GetAttribute("Ulted") and c:GetAttribute("Character") == "Batter" then return false end

	local pos = root.Position
	if pos.X < CFG.MINX or pos.X > CFG.MAXX or pos.Z < CFG.MINZ or pos.Z > CFG.MAXZ then
		return false
	end

	return true
end

local function isStunned(p)
	local hum = humOf(p.Character)
	return hum and (hasAnim(hum, "18896222853") or hasAnim(hum, "137434257516014")) or false
end

-- farm: lowest-health hittable player (same idea as the original picker)
local function pickFarmTarget(avoid)
	local best, bestHp = nil, math.huge
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= avoid and hittable(p) then
			local hp = humOf(p.Character).Health
			if hp < bestHp then
				best, bestHp = p, hp
			end
		end
	end
	return best
end

-- twin fangs: EVERY player with a body except you and friends, whatever their character,
-- immunity or state (shuffled so nobody is always last)
local function twinTargetList()
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= localPlayer and not isFriend(p) and rootOf(p.Character) and humOf(p.Character) then
			table.insert(list, p)
		end
	end
	for i = #list, 2, -1 do
		local j = math.random(i)
		list[i], list[j] = list[j], list[i]
	end
	return list
end

-- glass platform just under a position so you rest there (top = y - 3, root hovers like standing)
local platforms = {}
local function ensurePlatform(pos)
	local key = math.floor(pos.Y + 0.5)
	if platforms[key] and platforms[key].Parent then return end
	local platform = Instance.new("Part")
	platform.Name = "DuelFarmPlatform"
	platform.Size = Vector3.new(2048, 10, 2048)
	platform.Position = Vector3.new(pos.X, pos.Y - 3 - platform.Size.Y / 2, pos.Z)
	platform.Anchored = true
	platform.CanCollide = true
	platform.Material = Enum.Material.Glass
	platform.Color = Color3.fromRGB(210, 235, 255)
	platform.Transparency = 0.55
	platform.Reflectance = 0.15
	platform.Parent = workspace
	platforms[key] = platform
end

------------------------------------------------------------------
-- duel routine (called from mainLoop right after key 3 + DUEL_WAIT)
------------------------------------------------------------------
local function runDuel()
	if twinBusy then return end
	twinBusy = true
	setPhase("Duel")

	local keepVel = true
	task.spawn(function()
		while keepVel do
			local r = rootOf(localPlayer.Character)
			if r then
				r.AssemblyLinearVelocity  = Vector3.zero
				r.AssemblyAngularVelocity = Vector3.zero
			end
			RunService.Heartbeat:Wait()
		end
	end)

	-- everyone except you and friends: the planned list first, then anyone who joined since
	local queue, inQueue = {}, {}
	for _, p in ipairs(plannedQueue or {}) do
		if p.Parent and rootOf(p.Character) and humOf(p.Character) then
			table.insert(queue, p)
			inQueue[p] = true
		end
	end
	for _, p in ipairs(twinTargetList()) do
		if not inQueue[p] then table.insert(queue, p) end
	end
	plannedQueue = nil

	-- glue: EXACTLY DUEL_TIME seconds in total, the time left is always shared evenly
	local hardEnd = tick() + CFG.DUEL_TIME
	for idx, target in ipairs(queue) do
		if not running or tick() >= hardEnd then break end

		local tRoot = rootOf(target.Character)
		local mChar = localPlayer.Character
		local mRoot = rootOf(mChar)

		if tRoot and humOf(target.Character) and mRoot then
			local left = #queue - idx + 1
			local slotEnd = tick() + (hardEnd - tick()) / left
			link(mRoot, tRoot, humOf(mChar))
			stats.hits += 1
			while running and tick() < slotEnd do
				RunService.Heartbeat:Wait()
			end
		end
	end
	unlink()
	keepVel = false

	-- stage 1: anchored at -501y for HOLD_TIME (zero velocity every Heartbeat)
	local anchorPos = CFG.HOLD_POS
	local function pose()
		local r = rootOf(localPlayer.Character)
		if not r then return end
		r.AssemblyLinearVelocity  = Vector3.zero
		r.AssemblyAngularVelocity = Vector3.zero
		r.CFrame = CFrame.new(anchorPos)
	end
	setPhase("Anchored at " .. math.floor(CFG.HOLD_POS.Y + 0.5) .. "y")
	ensurePlatform(CFG.HOLD_POS)
	pose()
	local poseConn = RunService.Heartbeat:Connect(pose)

	local t0 = tick()
	while running and tick() - t0 < CFG.HOLD_TIME do
		RunService.Heartbeat:Wait()
	end

	-- stage 2: anchored at -10000y for RETURN_DELAY
	anchorPos = CFG.VOID_POS
	setPhase("Anchored at " .. math.floor(CFG.VOID_POS.Y + 0.5) .. "y")
	pose()

	local t1 = tick()
	while running and tick() - t1 < CFG.RETURN_DELAY do
		task.wait(0.1)
	end
	poseConn:Disconnect()

	-- stage 3: come back at -500y (glass floor there so you don't fall)
	ensurePlatform(CFG.RETURN_POS)
	local r2 = rootOf(localPlayer.Character)
	if r2 then
		r2.CFrame = CFrame.new(CFG.RETURN_POS)
		zero(r2)
	end

	stats.ults += 1
	twinBusy = false
end


------------------------------------------------------------------
-- phases
------------------------------------------------------------------
local lastDuel = 0
local away, backEarly = false, false   -- away = sitting at -500y; backEarly = already teleported to the saved spot
local pressT, learnedCd = nil, nil     -- when 3 was pressed / the cooldown length measured from it

-- seconds left on slot 3's cooldown, or nil when unknown.
-- 1) a number shown in the hotbar's Cooldown object, 2) CFG.DUEL_COOLDOWN, 3) the length learned from the last duel
local function cooldownLeft()
	local okT, txt = pcall(function()
		local cd = localPlayer.PlayerGui.Hotbar.Backpack.Hotbar["3"].Base:FindFirstChild("Cooldown")
		if not cd then return nil end
		for _, d in ipairs({cd, table.unpack(cd:GetDescendants())}) do
			if d:IsA("TextLabel") or d:IsA("TextButton") then
				local n = tonumber(d.Text:match("%d+%.?%d*"))
				if n then return n end
			end
		end
		return nil
	end)
	if okT and txt then return txt end

	local len = (CFG.DUEL_COOLDOWN and CFG.DUEL_COOLDOWN > 0) and CFG.DUEL_COOLDOWN or learnedCd
	if len and pressT then return len - (tick() - pressT) end
	return nil
end

local function goSavedSpot(root)
	if savedSpot then
		root.CFrame = savedSpot
		zero(root)
	end
end

local function mainLoop()
	while running do
		local ok, err = pcall(function()
			local char = localPlayer.Character
			local hum, root = humOf(char), rootOf(char)

			if not hum or not root or hum.Health <= 0 then
				away, backEarly = false, false   -- new body
				setPhase("Waiting to spawn...")
				task.wait(0.5)
				return
			end

			if tick() - lastDuel < CFG.DUEL_GAP or not moveReady(3) then
				-- RETURN_EARLY s before the cooldown ends: go back to the saved spot
				if away and not backEarly then
					local left = cooldownLeft()
					if left and left <= CFG.RETURN_EARLY then
						goSavedSpot(root)
						backEarly = true
						away = false
						setPhase("Back at saved spot, waiting for slot 3")
					end
				end
				if not backEarly then setPhase("Waiting for slot 3 cooldown") end
				task.wait(0.05)
				return
			end

			-- cooldown over: remember how long it was (for the early return next time)
			if pressT then
				local len = tick() - pressT
				if len >= 2 and len < 300 then learnedCd = len end
				pressT = nil
			end

			plannedQueue = twinTargetList()
			if #plannedQueue == 0 then
				setPhase("No targets, waiting...")
				task.wait(0.3)
				return
			end

			-- still at -500y (cooldown length unknown): go to the saved spot now, then continue
			if away then
				goSavedSpot(root)
				away = false
				task.wait(0.1)
			end
			backEarly = false
			if not savedSpot then savedSpot = root.CFrame end

			setPhase("Duel: pressing 3")
			pressT = tick()
			pressSlotKey(CFG.DUEL_KEY)
			task.wait(CFG.DUEL_WAIT)
			runDuel()
			away = true
			lastDuel = tick()
		end)

		if not ok then
			warn("[DuelFarm] " .. tostring(err))
			task.wait(1)
		end
	end
end

local function startBot()
	if running then return end
	running = true

	task.spawn(mainLoop)
end

local function stopBot()
	running = false
	unlink()
	restoreHome()
	setPhase("Stopped")
end

------------------------------------------------------------------
-- invisible (taken from the original script)
-- every Heartbeat it plays a frozen animation (71181015443030 at 13.45s,
-- huge weight) and stops it again in RenderStepped; your own body shows at 50%
------------------------------------------------------------------
local invisOn   = false
local invisBusy = false
local invisTrack
local invisBeat, invisCharConn
local dimConns = {}

local function dimPart(part)
	if not part:IsA("BasePart") then return end
	if part.Name == "HumanoidRootPart" then return end
	if part.Transparency == 1 then return end
	if part.Name:lower():find("hitbox") then return end

	part.LocalTransparencyModifier = 0.5
	table.insert(dimConns, part:GetPropertyChangedSignal("LocalTransparencyModifier"):Connect(function()
		if invisOn and part.LocalTransparencyModifier ~= 0.5 then
			part.LocalTransparencyModifier = 0.5
		end
	end))
end

local function dimCharacter(char)
	for _, d in ipairs(char:GetDescendants()) do
		dimPart(d)
	end

	table.insert(dimConns, char.DescendantAdded:Connect(function(d)
		if invisOn then dimPart(d) end
	end))
end

local function stopInvisTrack()
	if invisTrack then
		pcall(function()
			if invisTrack.IsPlaying then invisTrack:Stop() end
			invisTrack:Destroy()
		end)
		invisTrack = nil
	end
end

local function invisStep()
	if not invisOn or invisBusy then return end

	local char = localPlayer.Character
	local hum  = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local animator = hum and hum:FindFirstChildOfClass("Animator")
	if not hum or not root or not animator then return end
	if hum.Health <= 0 then return end

	invisBusy = true

	pcall(function()
		local velocity = root.Velocity

		local anim = Instance.new("Animation")
		anim.AnimationId = "rbxassetid://71181015443030"
		invisTrack = animator:LoadAnimation(anim)
		invisTrack.Priority = Enum.AnimationPriority.Action4
		invisTrack:Play()
		invisTrack:AdjustSpeed(0)
		invisTrack:AdjustWeight(2e9)
		invisTrack.TimePosition = 13.45

		RunService.RenderStepped:Wait()

		stopInvisTrack()
		root.Velocity = velocity
	end)

	invisBusy = false
end

local function setInvisible(on)
	if on == invisOn then return end
	invisOn = on

	if on then
		if localPlayer.Character then dimCharacter(localPlayer.Character) end

		invisCharConn = localPlayer.CharacterAdded:Connect(function(char)
			task.wait(0.1)
			if invisOn then dimCharacter(char) end
		end)

		invisBeat = RunService.Heartbeat:Connect(invisStep)
	else
		if invisBeat then invisBeat:Disconnect() invisBeat = nil end
		if invisCharConn then invisCharConn:Disconnect() invisCharConn = nil end

		for _, c in ipairs(dimConns) do
			pcall(function() c:Disconnect() end)
		end
		dimConns = {}

		stopInvisTrack()

		local char = localPlayer.Character
		if char then
			for _, d in ipairs(char:GetDescendants()) do
				if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
					d.LocalTransparencyModifier = 0
				end
			end
		end
	end
end

