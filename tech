-- tech
------------------------------------------------------------------
local busy = false
local lastTrigger = 0
local origJump, origUseJump

-- PC: press the Q key. Mobile: press the on-screen dash button (found in PlayerGui by name/text).
local IS_MOBILE = UIS.TouchEnabled and not UIS.KeyboardEnabled
local DASH_BUTTON_NAME = ""          -- set this to the exact button name if auto-detect picks the wrong one
local dashButton
local lastScan, warned = 0, false

local function findDashButton()
	if dashButton and dashButton.Parent then return dashButton end
	dashButton = nil
	if tick() - lastScan < 1 then return nil end
	lastScan = tick()
	local pg = me:FindFirstChild("PlayerGui")
	if not pg then return nil end
	local best
	for _, d in ipairs(pg:GetDescendants()) do
		if d:IsA("GuiButton") and not d:FindFirstAncestor("TechPanelUI") then
			local name = d.Name:lower()
			local text = (d:IsA("TextButton") and d.Text or ""):lower()
			local hit
			if DASH_BUTTON_NAME ~= "" then hit = d.Name == DASH_BUTTON_NAME
			else hit = name == "dash" or text == "dash" or name:find("dash", 1, true) ~= nil or text:find("dash", 1, true) ~= nil end
			if hit then
				if name == "dash" then best = d break end
				best = best or d
			end
		end
	end
	if best then
		dashButton = best
		warn("[Tech] dash button: " .. best:GetFullName())
	elseif not warned then
		warned = true
		warn("[Tech] no dash button found in PlayerGui - falling back to the Q key. Tell me the button's name (or set DASH_BUTTON_NAME)")
	end
	return dashButton
end

local function pressButton(btn)
	local fs = rawget(getgenv(), "firesignal")
	if type(fs) == "function" then
		for _, sig in ipairs({ "MouseButton1Down", "MouseButton1Click", "Activated", "MouseButton1Up" }) do
			pcall(function() fs(btn[sig]) end)
		end
	end
	local gc = rawget(getgenv(), "getconnections")
	if type(gc) == "function" then
		for _, sig in ipairs({ "Activated", "MouseButton1Click", "MouseButton1Down" }) do
			pcall(function()
				for _, c in ipairs(gc(btn[sig])) do pcall(function() c:Fire() end) end
			end)
		end
	end
	if not fs and not gc then       -- no executor helpers: a real touch on the button
		pcall(function()
			local gui = btn:FindFirstAncestorOfClass("ScreenGui")
			local dy = (gui and gui.IgnoreGuiInset) and 0 or GuiService:GetGuiInset().Y
			local c = btn.AbsolutePosition + btn.AbsoluteSize / 2
			VIM:SendTouchEvent(1, 0, c.X, c.Y + dy)
			task.wait(0.03)
			VIM:SendTouchEvent(1, 2, c.X, c.Y + dy)
		end)
	end
end

local function pressQ()
	if IS_MOBILE then
		local btn = findDashButton()
		if btn then pressButton(btn) return end
	end
	VIM:SendKeyEvent(true, Enum.KeyCode.Q, false, game)
	task.wait(0.03)
	VIM:SendKeyEvent(false, Enum.KeyCode.Q, false, game)
end

-- pad point -> world position around the target
local function padToWorld(px, tRootPos, fwd, right, y)
	local off = px - TARGET_PX
	local studsPerPx = S.DashRange / (PAD_W / 2)
	local flat = right * (off.X * studsPerPx) + fwd * (-off.Y * studsPerPx)   -- pad-up = forward
	return Vector3.new(tRootPos.X + flat.X, y, tRootPos.Z + flat.Z)
end

local function runTech(target)
	if busy then return end
	busy = true
	lastTrigger = tick()

	local ok, err = pcall(function()
		local r, h = root(me.Character), hum(me.Character)
		local tRoot = root(target)
		if not r or not h or not tRoot then return end

		local toT = Vector3.new(tRoot.Position.X - r.Position.X, 0, tRoot.Position.Z - r.Position.Z)
		local fwd = toT.Magnitude > 0.1 and toT.Unit or Vector3.new(0, 0, -1)
		local right = fwd:Cross(Vector3.yAxis)
		local myY = r.Position.Y

		-- cumulative pad length along the drawn path
		local lens, total = { 0 }, 0
		for i = 2, #path do
			total += (path[i] - path[i - 1]).Magnitude
			lens[i] = total
		end
		local studsPerPx = S.DashRange / (PAD_W / 2)
		local totalStuds = total * studsPerPx

		-- Q is pressed FIRST; the tech starts only once the game's dash actually appears
		-- (= the dash animation DASH_ID starts on my character), or after DASH_WAIT_MAX seconds as a fallback
		local dashSeen = false
		local dashConn = h.AnimationPlayed:Connect(function(tr)
			if tostring(tr.Animation.AnimationId):find(DASH_ID, 1, true) then dashSeen = true end
		end)
		pressQ()
		local qAt = tick()
		while not dashSeen and tick() - qAt < DASH_WAIT_MAX do RunService.Heartbeat:Wait() end
		dashConn:Disconnect()
		local waitEnd = tick() + DASH_TO_TECH         -- dash appeared > wait > tech
		while tick() < waitEnd do RunService.Heartbeat:Wait() end

		local t0 = tick()
		local flipped = false
		local done = false
		local conn
		conn = RunService.Heartbeat:Connect(function()
			local rr = root(me.Character)
			local tr = root(target)
			if done or not rr or not tr or not tr.Parent then done = true return end
			local el = tick() - t0

			local pos
			if el >= S.MagnetDelay then
				-- magnet phase: stay next to the target (under them in floater mode)
				local base = tr.Position
				if floater then
					pos = base - Vector3.new(0, 3.5, 0)
				else
					pos = base - tr.CFrame.LookVector * 3
				end
			else
				-- follow the drawn path
				local dist = math.min(el * DASH_SPEED, totalStuds)
				local pxDist = studsPerPx > 0 and dist / studsPerPx or 0
				local i = 2
				while i < #path and lens[i] < pxDist do i += 1 end
				local a, b = path[i - 1], path[i]
				local seg = lens[i] - lens[i - 1]
				local f = seg > 0 and math.clamp((pxDist - lens[i - 1]) / seg, 0, 1) or 1
				pos = padToWorld(a:Lerp(b, f), tr.Position, fwd, right, myY)
			end
			local look = Vector3.new(tr.Position.X, pos.Y, tr.Position.Z)
			if (look - pos).Magnitude > 0.05 then
				rr.CFrame = CFrame.lookAt(pos, look)
			else
				rr.CFrame = CFrame.new(pos)      -- standing exactly on the target's axis: lookAt would give a NaN CFrame (= void)
			end
			zero(rr)

			if not flipped and el >= S.FlipDelay then
				flipped = true
				local hh = hum(me.Character)
				if hh then hh.Jump = true end
			end
			if el >= S.CancelDelay then done = true end
		end)
		while not done do RunService.Heartbeat:Wait() end
		conn:Disconnect()
		local rr = root(me.Character)
		if rr then zero(rr) end
	end)
	if not ok then warn("[Tech] " .. tostring(err)) end
	busy = false
end

-- detect an uppercut: my own uppercut animation plays (id 10503381238); target = nearest player in range
local animConn

-- targets are character MODELS: real players' characters + the TSB "Weakest Dummy" (workspace.Live)
local function nearestTarget(maxRange)
	local r = root(me.Character)
	if not r then return nil end
	local candidates = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= me and p.Character then table.insert(candidates, p.Character) end
	end
	local live = workspace:FindFirstChild("Live")
	local dummy = live and live:FindFirstChild("Weakest Dummy")
	if dummy then table.insert(candidates, dummy) end

	local best, bestD = nil, maxRange or TRIGGER_RANGE
	for _, m in ipairs(candidates) do
		local tr, th = root(m), hum(m)
		if tr and th and th.Health > 0 then
			local d = (tr.Position - r.Position).Magnitude
			if d <= bestD then best, bestD = m, d end
		end
	end
	return best
end

-- Kiba tech: uppercut > wait > dash + flick 90 degrees so you sit KIBA_GAP studs under the (airborne) target,
-- your whole body turned face-up
local function runKiba(target, chained)
	if busy and not chained then return end
	busy = true
	lastTrigger = tick()
	local ok, err = pcall(function()
		local r = root(me.Character)
		local tRoot = root(target)
		if not r or not tRoot then return end
		local flat = Vector3.new(tRoot.Position.X - r.Position.X, 0, tRoot.Position.Z - r.Position.Z)
		local fwd = flat.Magnitude > 0.1 and flat.Unit or Vector3.new(0, 0, -1)

		task.spawn(pressQ)                             -- the dash ...
		local t0 = tick()
		local conn
		conn = RunService.Heartbeat:Connect(function()  -- ... + the flick, from the same moment
			local rr = root(me.Character)
			local tr = root(target)
			if not rr or not tr or not tr.Parent then return end
			local pos = tr.Position - Vector3.new(0, KIBA_GAP, 0)     -- follows the target, KIBA_GAP studs below
			rr.CFrame = CFrame.lookAt(pos, pos + fwd) * CFrame.Angles(math.rad(90), 0, 0)   -- pitched 90: facing up
			zero(rr)
		end)
		while tick() - t0 < KIBA_HOLD do RunService.Heartbeat:Wait() end
		conn:Disconnect()
		local rr = root(me.Character)                  -- stand back upright
		if rr then
			rr.CFrame = CFrame.lookAt(rr.Position, rr.Position + fwd)
			zero(rr)
		end
	end)
	if not ok then warn("[Tech/Kiba] " .. tostring(err)) end
	busy = false
end

-- Loop dash: uppercut > LOOP_DELAY > a full 360 degree dash around the target, circling LOOP_GAP studs BELOW them
local function runLoop(target)
	if busy then return end
	busy = true
	lastTrigger = tick()
	local ok, err = pcall(function()
		local r, tRoot = root(me.Character), root(target)
		if not r or not tRoot then return end
		local off = Vector3.new(r.Position.X - tRoot.Position.X, 0, r.Position.Z - tRoot.Position.Z)
		local a0 = off.Magnitude > 0.1 and math.atan2(off.Z, off.X) or 0     -- start where you already are around them
		pressQ()
		local t0 = tick()
		local conn
		conn = RunService.Heartbeat:Connect(function()
			local rr, tr = root(me.Character), root(target)
			if not rr or not tr or not tr.Parent then return end
			local u = math.clamp((tick() - t0) / LOOP_TIME, 0, 1)
			local a = a0 + math.rad(LOOP_SWEEP) * u
			local c = tr.Position
			local pos = Vector3.new(c.X + math.cos(a) * LOOP_RADIUS, c.Y - LOOP_GAP, c.Z + math.sin(a) * LOOP_RADIUS)   -- under them, live
			rr.CFrame = CFrame.lookAt(pos, Vector3.new(c.X, pos.Y, c.Z) + Vector3.new(0.001, 0, 0))
			zero(rr)
		end)
		while tick() - t0 < LOOP_TIME + LOOP_HOLD do RunService.Heartbeat:Wait() end
		conn:Disconnect()
		local rr = root(me.Character)
		if rr then zero(rr) end
	end)
	if not ok then warn("[Tech/Loop] " .. tostring(err)) end
	busy = false
end

local function hookAnim(char)
	if animConn then animConn:Disconnect() animConn = nil end
	local h = hum(char) or (char and char:WaitForChild("Humanoid", 5))
	if not h then return end
	animConn = h.AnimationPlayed:Connect(function(track)
		local id = tostring(track.Animation.AnimationId)
		local isUpper = id:find(UPPERCUT_ID, 1, true) ~= nil
		if not isUpper then return end
		-- the uppercut drives Tech and "Kiba tech auto"
		if not (enabled or kibaMode > 0) or busy or tick() - lastTrigger < COOLDOWN then return end
		lastTrigger = tick()
		task.spawn(function()
			if kibaMode == 2 then
				task.wait(LOOP_DELAY)
				if kibaMode ~= 2 then return end
				local t = nearestTarget()
				if t then runLoop(t) end
			elseif kibaMode == 1 then
				task.wait(KIBA_DELAY)
				if kibaMode ~= 1 then return end
				local t = nearestTarget()
				if t then runKiba(t) end
			else
				task.wait(START_DELAY)
				if not enabled then return end
				local t = nearestTarget()
				if t then runTech(t) end
			end
		end)
	end)
end
task.spawn(hookAnim, me.Character)

local function applyJump(on)
	local h = hum(me.Character)
	if not h then return end
	if on then
		if origJump == nil then origJump, origUseJump = h.JumpPower, h.UseJumpPower end
		h.UseJumpPower = true
		h.JumpPower = S.JumpPower
	elseif origJump ~= nil then
		h.UseJumpPower = origUseJump
		h.JumpPower = origJump
		origJump, origUseJump = nil, nil
	end
end

local charConn = me.CharacterAdded:Connect(function(char)
	origJump, origUseJump = nil, nil
	task.wait(0.5)
	hookAnim(char)
	if enabled then applyJump(true) end
end)

