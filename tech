local function dot(px, color, label)
	local d = Instance.new("Frame")
	d.Size = UDim2.new(0, 12, 0, 12)
	d.AnchorPoint = Vector2.new(0.5, 0.5)
	d.Position = UDim2.new(0, px.X, 0, px.Y)
	d.BackgroundColor3 = color
	d.BorderSizePixel = 0
	d.ZIndex = 5
	d.Parent = pad
	round(d, 6)
	local t = Instance.new("TextLabel")
	t.Size = UDim2.new(0, 50, 0, 12)
	t.Position = UDim2.new(0.5, -25, 1, 1)
	t.BackgroundTransparency = 1
	t.Font, t.TextSize, t.TextColor3, t.Text = FONT, 11, color, label
	t.ZIndex = 5
	t.Parent = d
end
dot(ME_PX, RED, "me")
dot(TARGET_PX, GOLD, "target")

local function seg(a, b)
	local d = b - a
	local f = Instance.new("Frame")
	f.Size = UDim2.new(0, d.Magnitude + 1, 0, 2)
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	local mid = (a + b) / 2
	f.Position = UDim2.new(0, mid.X, 0, mid.Y)
	f.Rotation = math.deg(math.atan2(d.Y, d.X))
	f.BackgroundColor3 = GOLD
	f.BorderSizePixel = 0
	f.Parent = lineLayer
end

local function redraw()
	lineLayer:ClearAllChildren()
	for i = 2, #path do seg(path[i - 1], path[i]) end
end
redraw()

local drawing = false
local function padPoint(input)
	local p = Vector2.new(input.Position.X, input.Position.Y) - pad.AbsolutePosition
	return Vector2.new(math.clamp(p.X, 0, PAD_W), math.clamp(p.Y, 0, PAD_H))
end

-- A press on the pad only STARTS a new drawing once the finger/mouse actually moves; a tap (or a press anywhere
-- else) never touches the saved path. Only the input that started the drawing can continue or end it.
local drawInput, working
pad.InputBegan:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
		drawing, drawInput, working = true, i, { ME_PX }
	end
end)
UIS.InputChanged:Connect(function(i)
	if not drawing or not working then return end
	local isMove = (drawInput.UserInputType == Enum.UserInputType.MouseButton1 and i.UserInputType == Enum.UserInputType.MouseMovement)
		or (i == drawInput)
	if not isMove then return end
	local p = padPoint(i)
	if (p - working[#working]).Magnitude >= 4 and #working < 80 then
		table.insert(working, p)
		if #working == 2 then          -- first real movement: replace the old drawing
			path = working
			redraw()
		else
			seg(working[#working - 1], working[#working])
		end
	end
end)
UIS.InputEnded:Connect(function(i)
	if drawing and (i == drawInput or (drawInput and drawInput.UserInputType == Enum.UserInputType.MouseButton1 and i.UserInputType == Enum.UserInputType.MouseButton1)) then
		drawing, drawInput, working = false, nil, nil
	end
end)

