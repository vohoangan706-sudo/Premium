--[[
  TECH panel (black + gold)
  * Drawing space: red dot = "me", gold dot = "target". Drag inside the pad to draw the dash path, starting from
    your "me" dot. The path is stored relative to the target dot (pad-up = the direction from you to the target,
    pad-right = your right), so it is replayed around the target's LIVE position. "Clear" resets it to a straight
    line me -> target.
  * Toggle "Tech": while ON, when YOUR uppercut animation (10503381238) plays and a player is within
    TRIGGER_RANGE studs - a player or the Weakest Dummy (nearest = target), it immediately:
        press Q  >  you dash along the drawn path
        at Magnet delay  : you get pinned next to the target (behind them; under them in Floater mode)
        at Flip delay    : you jump (Jumppower)
        at Cancel delay  : everything stops and your velocity is zeroed
  * Settings under the pad: Jumppower, Flip delay, Cancel delay, Magnet delay (seconds), Dash range (studs the
    pad's half-width stands for - bigger = longer dash). "Floater" toggle = keep yourself under the floating target.
  * "Kiba tech auto" button (alternative to Tech): uppercut > 0.22s > dash + flick: you sit 0 studs BELOW the airborne
    target, body pitched 90 degrees (face-up), for 1s. KIBA_DELAY / KIBA_GAP / KIBA_HOLD near the top.
  * Side panel ("..."): Loop dash = uppercut > 0.2s > a full 360 dash around the target, circling under them.
  I could not find a clear definition of these in-game terms; the meanings above are my reading. Untested in Roblox.
]]

if getgenv().TechPanelStop then pcall(getgenv().TechPanelStop) end

local Players  = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS      = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local VIM      = game:GetService("VirtualInputManager")
local GuiService = game:GetService("GuiService")
local me       = Players.LocalPlayer

local function root(c) return c and c:FindFirstChild("HumanoidRootPart") end
local function hum(c)  return c and c:FindFirstChildOfClass("Humanoid") end
local function zero(p) p.AssemblyLinearVelocity, p.AssemblyAngularVelocity = Vector3.zero, Vector3.zero end

------------------------------------------------------------------
-- settings
------------------------------------------------------------------
local S = {
	JumpPower   = 50,
	FlipDelay   = 0.15,
	CancelDelay = 0.45,
	MagnetDelay = 0.25,
	DashRange   = 25,
}
local floater = false
local enabled = false
local kibaMode = 0          -- 0 = off, 1 = Kiba tech auto, 2 = Loop dash

local TRIGGER_RANGE = 20     -- studs: how close the target must be
local DASH_SPEED    = 150    -- studs/s along the drawn path
local COOLDOWN      = 1.5    -- seconds between triggers
local UPPERCUT_ID = "10503381238"
local DASH_ID     = "10479335397"      -- the game's Q dash animation
local LOOP_DELAY     = 0.3     -- Loop dash: seconds after the uppercut animation starts
local LOOP_TIME      = 0.7     -- Loop dash: seconds for the circling dash
local LOOP_SWEEP     = 360     -- Loop dash: degrees travelled around the target
local LOOP_GAP       = 3       -- Loop dash: studs BELOW the target that you circle at
local LOOP_RADIUS    = 5       -- Loop dash: radius of the circle under the target (studs)
local LOOP_HOLD      = 0.2     -- Loop dash: seconds you stay under them afterwards
local KIBA_DELAY    = 0.3     -- Kiba: seconds after the uppercut animation starts, then dash + flick
local KIBA_GAP      = 0       -- Kiba: studs BELOW the target
local KIBA_HOLD     = 0.7       -- Kiba: seconds you stay under them, body flipped face-up
local DASH_TO_TECH  = 0.1     -- seconds between the dash appearing and the tech starting
local DASH_WAIT_MAX = 0.5     -- max seconds to wait for the dash to appear after Q before starting anyway
local START_DELAY   = 0.2    -- seconds after the uppercut animation starts before the tech begins (target is airborne by then)

