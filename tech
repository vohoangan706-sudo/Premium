-- palette
------------------------------------------------------------------
local BG       = Color3.fromRGB(12, 12, 12)
local GOLD     = Color3.fromRGB(235, 190, 30)
local GOLD_DIM = Color3.fromRGB(190, 150, 35)
local FILL     = Color3.fromRGB(62, 48, 8)
local FILL_ON  = Color3.fromRGB(235, 190, 30)
local ROW      = Color3.fromRGB(24, 20, 8)
local RED      = Color3.fromRGB(235, 40, 40)
local FONT     = Enum.Font.Code

------------------------------------------------------------------
-- drawing pad geometry (pixels inside the pad)
------------------------------------------------------------------
local PAD_W, PAD_H = 220, 110
local ME_PX     = Vector2.new(PAD_W / 2, PAD_H / 2 + 14)   -- near the middle, close to the target
local TARGET_PX = Vector2.new(PAD_W / 2, PAD_H / 2 - 14)
local path = { ME_PX, TARGET_PX }        -- pad pixel points, drawn path

