-- ======================================================================
--  Aetherfinix Linux  (standalone module)
--  Host this file somewhere (raw URL) and load it from the panel:
--      loadstring(game:HttpGet("YOUR_URL"))(context)
--  The panel passes `context` (its GUI pieces + command table). Running
--  this file by itself does nothing.
-- ======================================================================
local context = ...
if type(context) ~= "table" then
	warn("Aetherfinix Linux must be loaded by the Aetherfinix panel.")
	return
end

local player = context.player
local screenGui = context.screenGui
local panelFrame = context.panelFrame
local panelTitleBar = context.panelTitleBar
local outputFrame = context.outputFrame
local inputBox = context.inputBox
local addLine = context.addLine
local clearConsole = context.clearConsole
local themeState = context.themeState
local linuxHooks = context.linuxHooks
local commands = context.commands
local registerPackage = context.registerPackage
local PANEL_TITLE = context.PANEL_TITLE

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local SoundService = game:GetService("SoundService")

-- ######################################################################
-- #  Aetherfinix Linux  (hidden command: `pkg install linux`)
-- #  Aetherfinix's make-believe Lua "operating system". Once installed,
-- #  code run from {} mode gets these extra globals (none of them exist
-- #  in real Roblox/Lua):
-- #    os  ui  storage  fs  mathx  term  audio  task  net  debug  pkg
-- #    event  sys  clock  str  json  security  env  notify  fx  luaos
-- #  Everything is client-side. `fs` is a VIRTUAL file system kept inside
-- #  the settings file (it never touches real files). Settings are saved
-- #  to AetherfinixSettings.json when the executor has writefile.
-- ######################################################################
do
local function setupLuaOS()
	local HttpService = game:GetService("HttpService")
	local StarterGui = game:GetService("StarterGui")
	local Debris = game:GetService("Debris")
	local TweenService = game:GetService("TweenService")
	local Lighting = game:GetService("Lighting")
	local Stats = game:GetService("Stats")

	local realOs = os
	local realTask = task
	local realDebug = debug

	local SETTINGS_FILE = "AetherfinixSettings.json"
	local LUAOS_VERSION = "1.0.0"
	local LUAOS_BUILD = "2026.11.06"
	local LUAOS_API = "1.0"

	local AMBER = Color3.fromRGB(255, 200, 0)
	local BRIGHT = Color3.fromRGB(255, 220, 120)
	local GREEN = Color3.fromRGB(150, 255, 150)
	local RED = Color3.fromRGB(255, 150, 150)

	local COLOR_NAMES = {
		amber = AMBER, cyan = Color3.fromRGB(0, 255, 255), red = Color3.fromRGB(255, 90, 90),
		green = Color3.fromRGB(120, 255, 120), yellow = Color3.fromRGB(255, 240, 90),
		white = Color3.fromRGB(240, 240, 240), black = Color3.fromRGB(20, 20, 20),
		blue = Color3.fromRGB(100, 150, 255), magenta = Color3.fromRGB(255, 100, 255),
		orange = Color3.fromRGB(255, 150, 40), gray = Color3.fromRGB(170, 170, 170),
	}
	local termColorName = "amber"

	-- forward declarations (libraries reference each other)
	local booted = false
	local bootTime = realOs.time()
	local settings = {}
	local osLib, uiLib, storageLib, fsLib, mathxLib, termLib, audioLib, taskLib
	local netLib, debugLib, pkgLib, eventLib, sysLib, clockLib, strLib, jsonLib
	local securityLib, envLib, notifyLib, fxLib, luaosLib
	local windows = {}
	local currentWindow = nil
	local terminalHistory = {}
	local lastClipboard = nil

	local function emit(text, color)
		color = color or COLOR_NAMES[termColorName] or AMBER
		text = tostring(text)
		for line in (text .. "\n"):gmatch("(.-)\n") do
			if linuxHooks.report then
				linuxHooks.report(line, color)
			else
				addLine(line, color)
			end
		end
	end

	---------------------------------------------------------------
	-- settings file (storage / fs / permissions / env live in here)
	---------------------------------------------------------------
	local canPersist = (type(writefile) == "function" and type(readfile) == "function")

	local function ensureSettings()
		if type(settings.data) ~= "table" then settings.data = {} end
		if type(settings.fs) ~= "table" then settings.fs = {} end
		if type(settings.fs.files) ~= "table" then settings.fs.files = {} end
		if type(settings.fs.folders) ~= "table" then settings.fs.folders = {} end
		if type(settings.perms) ~= "table" then
			settings.perms = { filesystem = true, network = true, clipboard = true, audio = true }
		end
		if type(settings.env) ~= "table" then
			settings.env = {
				PATH = "/bin:/usr/bin",
				USER = player.Name,
				HOME = "/home/" .. player.Name,
				SHELL = "aether-shell",
			}
		end
		if type(settings.packages) ~= "table" then settings.packages = {} end
		-- older versions saved storage keys at the top level: move them into data
		local reserved = { data = true, fs = true, perms = true, env = true, packages = true,
			theme = true, language = true, linux_installed = true }
		for key, value in pairs(settings) do
			if not reserved[key] then
				settings.data[key] = value
				settings[key] = nil
			end
		end
	end

	local function loadSettings()
		if canPersist then
			local ok, raw = pcall(function()
				if type(isfile) == "function" and not isfile(SETTINGS_FILE) then
					return nil
				end
				return readfile(SETTINGS_FILE)
			end)
			if ok and type(raw) == "string" and raw ~= "" then
				local decoded, data = pcall(HttpService.JSONDecode, HttpService, raw)
				if decoded and type(data) == "table" then
					settings = data
				end
			end
		end
		ensureSettings()
	end

	local function saveSettings()
		if not canPersist then return end
		pcall(function()
			writefile(SETTINGS_FILE, HttpService:JSONEncode(settings))
		end)
	end

	local function checkPerm(name)
		if not settings.perms[name] then
			error("permission denied: '" .. name .. "' (security.requestPermission(\"" .. name .. "\"))", 3)
		end
	end

	---------------------------------------------------------------
	-- storage
	---------------------------------------------------------------
	storageLib = {}

	function storageLib.set(key, value)
		assert(key ~= nil, "storage.set: key is required")
		if value ~= nil then
			local okEncode = pcall(HttpService.JSONEncode, HttpService, { value })
			assert(okEncode, "storage.set: value can't be saved (use text, numbers, booleans or tables)")
		end
		settings.data[tostring(key)] = value
		saveSettings()
		return true
	end

	function storageLib.get(key)
		return settings.data[tostring(key)]
	end

	function storageLib.delete(key)
		local existed = settings.data[tostring(key)] ~= nil
		settings.data[tostring(key)] = nil
		saveSettings()
		return existed
	end

	function storageLib.clear()
		settings.data = {}
		saveSettings()
		return true
	end

	function storageLib.exists(key)
		return settings.data[tostring(key)] ~= nil
	end

	function storageLib.keys()
		local keys = {}
		for key in pairs(settings.data) do
			table.insert(keys, key)
		end
		table.sort(keys)
		return keys
	end

	function storageLib.save()
		saveSettings()
		return canPersist
	end

	function storageLib.load()
		loadSettings()
		return canPersist
	end

	---------------------------------------------------------------
	-- virtual file system  (fs)
	---------------------------------------------------------------
	fsLib = {}
	do
		local function norm(path)
			path = tostring(path or "/"):gsub("\\", "/")
			local parts = {}
			for seg in path:gmatch("[^/]+") do
				if seg == ".." then
					table.remove(parts)
				elseif seg ~= "." then
					table.insert(parts, seg)
				end
			end
			return "/" .. table.concat(parts, "/")
		end

		local function parentOf(path)
			local parent = path:match("^(.*)/[^/]+$")
			if parent == nil or parent == "" then return "/" end
			return parent
		end

		local function nameOf(path)
			return path:match("([^/]+)$") or ""
		end

		local function isFolder(path)
			return path == "/" or settings.fs.folders[path] == true
		end

		local function isFile(path)
			return settings.fs.files[path] ~= nil
		end

		local function ensureFolder(path)
			local current = ""
			for seg in path:gmatch("[^/]+") do
				current = current .. "/" .. seg
				settings.fs.folders[current] = true
			end
		end

		function fsLib.createFile(path, content)
			checkPerm("filesystem")
			local p = norm(path)
			if p == "/" or isFolder(p) or isFile(p) then return false, "already exists" end
			ensureFolder(parentOf(p))
			settings.fs.files[p] = { c = tostring(content or ""), m = realOs.time() }
			saveSettings()
			return true
		end

		function fsLib.writeFile(path, content)
			checkPerm("filesystem")
			local p = norm(path)
			if p == "/" or isFolder(p) then return false, "is a folder" end
			ensureFolder(parentOf(p))
			settings.fs.files[p] = { c = tostring(content or ""), m = realOs.time() }
			saveSettings()
			return true
		end

		function fsLib.readFile(path)
			checkPerm("filesystem")
			local file = settings.fs.files[norm(path)]
			if not file then return nil, "file not found" end
			return file.c
		end

		function fsLib.exists(path)
			checkPerm("filesystem")
			local p = norm(path)
			return isFolder(p) or isFile(p)
		end

		function fsLib.createFolder(path)
			checkPerm("filesystem")
			local p = norm(path)
			if isFile(p) then return false, "a file has that name" end
			if isFolder(p) then return false, "already exists" end
			ensureFolder(p)
			saveSettings()
			return true
		end

		-- deletes a file (or a folder and everything in it)
		function fsLib.deleteFile(path)
			checkPerm("filesystem")
			local p = norm(path)
			if p == "/" then return false, "can't delete /" end
			if isFile(p) then
				settings.fs.files[p] = nil
				saveSettings()
				return true
			end
			if isFolder(p) then
				local prefix = p .. "/"
				for filePath in pairs(settings.fs.files) do
					if filePath:sub(1, #prefix) == prefix then settings.fs.files[filePath] = nil end
				end
				for folderPath in pairs(settings.fs.folders) do
					if folderPath == p or folderPath:sub(1, #prefix) == prefix then
						settings.fs.folders[folderPath] = nil
					end
				end
				saveSettings()
				return true
			end
			return false, "not found"
		end

		function fsLib.list(path)
			checkPerm("filesystem")
			local p = norm(path or "/")
			if not isFolder(p) then return nil, "not a folder" end
			local names = {}
			for folderPath in pairs(settings.fs.folders) do
				if parentOf(folderPath) == p and folderPath ~= p then
					table.insert(names, nameOf(folderPath) .. "/")
				end
			end
			for filePath in pairs(settings.fs.files) do
				if parentOf(filePath) == p then
					table.insert(names, nameOf(filePath))
				end
			end
			table.sort(names)
			return names
		end

		-- moves a file or a whole folder; dest must not exist
		local function relocate(from, to)
			if from == "/" then return false, "can't move /" end
			if not (isFile(from) or isFolder(from)) then return false, "not found" end
			if isFile(to) or isFolder(to) then return false, "destination exists" end
			if to == from or to:sub(1, #from + 1) == from .. "/" then return false, "invalid destination" end
			ensureFolder(parentOf(to))
			if isFile(from) then
				settings.fs.files[to] = settings.fs.files[from]
				settings.fs.files[from] = nil
			else
				local prefix = from .. "/"
				local moved = {}
				for filePath, file in pairs(settings.fs.files) do
					if filePath:sub(1, #prefix) == prefix then
						moved[to .. "/" .. filePath:sub(#prefix + 1)] = file
						settings.fs.files[filePath] = nil
					end
				end
				for newPath, file in pairs(moved) do settings.fs.files[newPath] = file end
				local movedFolders = { [to] = true }
				for folderPath in pairs(settings.fs.folders) do
					if folderPath == from then
						settings.fs.folders[folderPath] = nil
					elseif folderPath:sub(1, #prefix) == prefix then
						movedFolders[to .. "/" .. folderPath:sub(#prefix + 1)] = true
						settings.fs.folders[folderPath] = nil
					end
				end
				for newPath in pairs(movedFolders) do settings.fs.folders[newPath] = true end
			end
			saveSettings()
			return true
		end

		function fsLib.rename(old, new)
			checkPerm("filesystem")
			local from = norm(old)
			local newText = tostring(new)
			local to
			if newText:find("/") then
				to = norm(newText)
			else
				to = norm(parentOf(from) .. "/" .. newText)
			end
			return relocate(from, to)
		end

		function fsLib.move(old, destination)
			checkPerm("filesystem")
			local from = norm(old)
			local destText = tostring(destination)
			local dest = norm(destText)
			if destText:sub(-1) == "/" or isFolder(dest) then
				return relocate(from, norm(dest .. "/" .. nameOf(from)))
			end
			return relocate(from, dest)
		end

		function fsLib.copy(source, destination)
			checkPerm("filesystem")
			local from = norm(source)
			local file = settings.fs.files[from]
			if not file then return false, "file not found" end
			local destText = tostring(destination)
			local dest = norm(destText)
			if destText:sub(-1) == "/" or isFolder(dest) then
				dest = norm(dest .. "/" .. nameOf(from))
			end
			if isFile(dest) or isFolder(dest) then return false, "destination exists" end
			ensureFolder(parentOf(dest))
			settings.fs.files[dest] = { c = file.c, m = realOs.time() }
			saveSettings()
			return true
		end

		function fsLib.getSize(path)
			checkPerm("filesystem")
			local file = settings.fs.files[norm(path)]
			if not file then return nil, "file not found" end
			return #file.c
		end

		function fsLib.getExtension(path)
			return tostring(path):match("%.([%w_]+)$")
		end

		function fsLib.getModified(path)
			checkPerm("filesystem")
			local file = settings.fs.files[norm(path)]
			if not file then return nil, "file not found" end
			return file.m
		end
	end

	---------------------------------------------------------------
	-- mathx / str / json / clock / env
	---------------------------------------------------------------
	mathxLib = {}

	function mathxLib.clamp(value, low, high) return math.clamp(value, low, high) end

	function mathxLib.round(value, decimals)
		local scale = 10 ^ (decimals or 0)
		return math.floor(value * scale + 0.5) / scale
	end

	function mathxLib.randomString(length)
		local chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
		local out = {}
		for i = 1, math.max(0, math.floor(tonumber(length) or 8)) do
			local index = math.random(1, #chars)
			out[i] = chars:sub(index, index)
		end
		return table.concat(out)
	end

	function mathxLib.average(...)
		local count = select("#", ...)
		if count == 0 then return 0 end
		local total = 0
		for i = 1, count do total = total + select(i, ...) end
		return total / count
	end

	function mathxLib.distance(x1, y1, x2, y2)
		return math.sqrt((x2 - x1) ^ 2 + (y2 - y1) ^ 2)
	end

	function mathxLib.map(value, inMin, inMax, outMin, outMax)
		return outMin + (value - inMin) * (outMax - outMin) / (inMax - inMin)
	end

	function mathxLib.lerp(a, b, t) return a + (b - a) * t end

	function mathxLib.factorial(n)
		n = math.floor(n)
		assert(n >= 0 and n <= 170, "mathx.factorial: n must be 0-170")
		local result = 1
		for i = 2, n do result = result * i end
		return result
	end

	function mathxLib.sign(n) return n > 0 and 1 or (n < 0 and -1 or 0) end
	function mathxLib.isEven(n) return n % 2 == 0 end
	function mathxLib.isOdd(n) return n % 2 == 1 end

	strLib = {}

	function strLib.split(text, separator)
		return tostring(text):split(separator or " ")
	end

	function strLib.trim(text)
		return (tostring(text):gsub("^%s+", ""):gsub("%s+$", ""))
	end

	function strLib.reverse(text) return tostring(text):reverse() end
	function strLib.contains(text, part) return tostring(text):find(tostring(part), 1, true) ~= nil end

	function strLib.startsWith(text, prefix)
		text, prefix = tostring(text), tostring(prefix)
		return text:sub(1, #prefix) == prefix
	end

	function strLib.endsWith(text, suffix)
		text, suffix = tostring(text), tostring(suffix)
		return suffix == "" or text:sub(-#suffix) == suffix
	end

	function strLib.replace(text, find, replacement)
		local escaped = tostring(find):gsub("[%^%$%(%)%%%.%[%]%*%+%-%?]", "%%%0")
		local safeReplacement = tostring(replacement):gsub("%%", "%%%%")
		return (tostring(text):gsub(escaped, safeReplacement))
	end

	jsonLib = {}

	function jsonLib.encode(value) return HttpService:JSONEncode(value) end
	function jsonLib.decode(text) return HttpService:JSONDecode(tostring(text)) end

	clockLib = {}

	function clockLib.now() return realOs.date("%H:%M:%S") end
	function clockLib.date() return realOs.date("%Y-%m-%d") end
	function clockLib.timestamp() return realOs.time() end
	function clockLib.format(fmt) return realOs.date(tostring(fmt or "%H:%M:%S")) end

	function clockLib.measure(fn)
		local started = realOs.clock()
		fn()
		return realOs.clock() - started
	end

	envLib = {}

	function envLib.get(name) return settings.env[tostring(name)] end

	function envLib.set(name, value)
		settings.env[tostring(name)] = tostring(value)
		saveSettings()
		return true
	end

	function envLib.remove(name)
		local existed = settings.env[tostring(name)] ~= nil
		settings.env[tostring(name)] = nil
		saveSettings()
		return existed
	end

	function envLib.list()
		local copy = {}
		for name, value in pairs(settings.env) do copy[name] = value end
		return copy
	end

	---------------------------------------------------------------
	-- security
	---------------------------------------------------------------
	securityLib = {}

	function securityLib.requestPermission(name)
		name = tostring(name):lower()
		settings.perms[name] = true
		saveSettings()
		emit("[security] permission granted: " .. name, BRIGHT)
		return true
	end

	function securityLib.hasPermission(name)
		return settings.perms[tostring(name):lower()] == true
	end

	function securityLib.revokePermission(name)
		name = tostring(name):lower()
		settings.perms[name] = false
		saveSettings()
		emit("[security] permission revoked: " .. name, BRIGHT)
		return true
	end

	function securityLib.listPermissions()
		local list = {}
		for name, granted in pairs(settings.perms) do
			if granted then table.insert(list, name) end
		end
		table.sort(list)
		return list
	end

	---------------------------------------------------------------
	-- event
	---------------------------------------------------------------
	eventLib = {}
	do
		local handlers = {}
		local nextId = 0

		function eventLib.connect(name, fn)
			assert(type(fn) == "function", "event.connect: callback must be a function")
			nextId = nextId + 1
			name = tostring(name)
			handlers[name] = handlers[name] or {}
			table.insert(handlers[name], { id = nextId, fn = fn })
			return nextId
		end

		function eventLib.emit(name, ...)
			local list = handlers[tostring(name)]
			if not list then return 0 end
			local args = table.pack(...)
			for _, handler in ipairs({ table.unpack(list) }) do
				realTask.spawn(function()
					local ok, err = pcall(handler.fn, table.unpack(args, 1, args.n))
					if not ok then emit("event error: " .. tostring(err), RED) end
				end)
			end
			return #list
		end

		-- by event name (removes all its handlers) or by the id connect returned
		function eventLib.disconnect(nameOrId)
			if type(nameOrId) == "number" then
				for _, list in pairs(handlers) do
					for i, handler in ipairs(list) do
						if handler.id == nameOrId then
							table.remove(list, i)
							return true
						end
					end
				end
				return false
			end
			local existed = handlers[tostring(nameOrId)] ~= nil
			handlers[tostring(nameOrId)] = nil
			return existed
		end

		function eventLib.list()
			local names = {}
			for name, list in pairs(handlers) do
				if #list > 0 then table.insert(names, name) end
			end
			table.sort(names)
			return names
		end
	end

	---------------------------------------------------------------
	-- task (the real task library plus getRunning / isRunning)
	---------------------------------------------------------------
	taskLib = {}
	do
		local running = {}

		local function runningCount()
			local count = 0
			for _ in pairs(running) do count = count + 1 end
			return count
		end

		function taskLib.spawn(fn, ...)
			local args = table.pack(...)
			local thread
			local finished = false
			thread = realTask.spawn(function()
				local ok, err = pcall(fn, table.unpack(args, 1, args.n))
				finished = true
				if thread then running[thread] = nil end
				if not ok then error(err, 0) end
			end)
			if not finished then running[thread] = true end
			return thread
		end

		function taskLib.delay(seconds, fn, ...)
			local args = table.pack(...)
			local thread
			thread = realTask.delay(seconds, function()
				if thread then running[thread] = nil end
				fn(table.unpack(args, 1, args.n))
			end)
			running[thread] = true
			return thread
		end

		function taskLib.cancel(thread)
			running[thread] = nil
			return realTask.cancel(thread)
		end

		function taskLib.getRunning()
			local list = {}
			for thread in pairs(running) do table.insert(list, thread) end
			return list
		end

		function taskLib.isRunning(thread)
			return running[thread] == true
		end

		taskLib.count = runningCount
	end
	setmetatable(taskLib, { __index = realTask })

	---------------------------------------------------------------
	-- theme + clipboard + title + lock (used by os / term)
	---------------------------------------------------------------
	local THEMES = {
		amber = {
			panel = Color3.fromRGB(10, 10, 10), input = Color3.fromRGB(20, 15, 0),
			text = Color3.fromRGB(255, 200, 0), gutter = Color3.fromRGB(30, 22, 0),
			gutterText = Color3.fromRGB(150, 115, 0),
		},
		dark = {
			panel = Color3.fromRGB(18, 18, 22), input = Color3.fromRGB(30, 30, 36),
			text = Color3.fromRGB(225, 225, 235), gutter = Color3.fromRGB(26, 26, 32),
			gutterText = Color3.fromRGB(120, 120, 135),
		},
		light = {
			panel = Color3.fromRGB(235, 235, 240), input = Color3.fromRGB(255, 255, 255),
			text = Color3.fromRGB(30, 30, 40), gutter = Color3.fromRGB(220, 220, 228),
			gutterText = Color3.fromRGB(120, 120, 135),
		},
	}

	local function applyTheme(name)
		local theme = THEMES[name]
		if not theme then return false end
		panelFrame.BackgroundColor3 = theme.panel
		inputBox.BackgroundColor3 = theme.input
		inputBox.TextColor3 = theme.text
		themeState.text = (name ~= "amber") and theme.text or nil
