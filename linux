	local function boot(forceMode)
		if not booted then
			booted = true
			bootTime = realOs.time()
			linuxHooks.globals = {
				os = osLib, ui = uiLib, storage = storageLib, fs = fsLib, mathx = mathxLib,
				term = termLib, audio = audioLib, task = taskLib, net = netLib, debug = debugLib,
				pkg = pkgLib, event = eventLib, sys = sysLib, clock = clockLib, str = strLib,
				json = jsonLib, security = securityLib, env = envLib, notify = notifyLib,
				fx = fxLib, luaos = luaosLib,
			}
			if settings.theme and THEMES[settings.theme] then
				applyTheme(settings.theme)
			end
		end
		if forceMode and linuxHooks.setMode then
			linuxHooks.setMode(true)
		end
		emit("Aetherfinix Linux start up", GREEN)
		emit("Aetherfinix Linux " .. LUAOS_VERSION .. " - 21 modules loaded (os, ui, fs, net, fx, ...)", BRIGHT)
		pcall(audioLib.play, "startup")
	end

	shutdownSystem = function(restart)
		emit("Aetherfinix Linux " .. (restart and "restarting..." or "shutting down..."), BRIGHT)
		for _, window in ipairs({ table.unpack(windows) }) do closeWindow(window) end
		pcall(fxLib.stopAll)
		pcall(audioLib.stopAll)
		if lockOverlay then lockOverlay:Destroy() lockOverlay = nil end
		booted = false
		linuxHooks.globals = nil
		if restart then
			boot(false)
		else
			emit("Aetherfinix Linux stopped. Run `pkg install linux` to start it again.", BRIGHT)
		end
	end

