	local installing = false

	local function installLinux()
		if installing then
			return "Install already in progress."
		end
		if settings.linux_installed then
			if booted then
				return "Aetherfinix Linux is already installed and running."
			end
			boot(true) -- installed earlier but shut down: start it again
			return "Aetherfinix Linux restarted."
		end
		installing = true
		realTask.spawn(function()
			for _, line in ipairs(INSTALL_LINES) do
				addLine(line, AMBER)
				realTask.wait(0.07)
			end
			for name in pairs(CATALOG) do
				if not name:find("extra") then settings.packages[name] = true end
			end
			settings.linux_installed = true
			saveSettings()
			installing = false
			boot(true)
		end)
		return "Installing Aetherfinix Linux..."
	end

	-- keeps your storage / fs / settings data; only removes the install
	local function uninstallLinux()
		if installing then
			return "Wait for the install to finish first."
		end
		if not settings.linux_installed then
			return "Aetherfinix Linux isn't installed."
		end
		if booted then
			shutdownSystem(false)
		end
		settings.linux_installed = nil
		settings.theme = nil
		applyTheme("amber")
		saveSettings()
		return "Aetherfinix Linux uninstalled. (Your saved storage and files are kept.)"
	end

	-- the panel owns the `pkg` command and hands `pkg install linux` to us
	if registerPackage then
		registerPackage("linux", function() return installLinux() end, function() return uninstallLinux() end)
	else
		commands["pkg"] = function(args)
			local action = tostring(args[1] or ""):lower()
			local package = tostring(args[2] or ""):lower()
			if action == "install" and (package == "linux" or package == "aetherfinix-linux") then
				return installLinux()
			end
			return "Usage: pkg install <package>"
		end
	end

	loadSettings()
	if settings.linux_installed then
		boot(false) -- already installed: start it with the panel
	end
end
setupLuaOS()
end
