		if window.Minimized then return end
		window.Minimized = true
		window.SavedSize = window.Frame.Size
		window.Content.Visible = false
		window.Frame.Size = UDim2.new(window.Frame.Size.X.Scale, window.Frame.Size.X.Offset, 0, 26)
