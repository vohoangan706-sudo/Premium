	function pkgLib.install(name)
		name = tostring(name):lower()
		if not CATALOG[name] then return false, "package not found: " .. name end
		if settings.packages[name] then return false, "already installed" end
		settings.packages[name] = true
		saveSettings()
		emit("Installing " .. name .. " ... OK", GREEN)
		return true
	end

	function pkgLib.uninstall(name)
		name = tostring(name):lower()
		if not settings.packages[name] then return false, "not installed" end
		settings.packages[name] = nil
		saveSettings()
		emit("Removed " .. name, BRIGHT)
		return true
	end

	function pkgLib.list()
		local list = {}
		for name in pairs(settings.packages) do table.insert(list, name) end
		table.sort(list)
		return list
	end

	function pkgLib.update(name)
		name = tostring(name):lower()
		if not CATALOG[name] then return false, "package not found: " .. name end
		emit(name .. " is already the newest version (" .. LUAOS_VERSION .. ")", BRIGHT)
		return true
	end

	function pkgLib.search(query)
		query = tostring(query):lower()
		local results = {}
		for name, description in pairs(CATALOG) do
			if name:find(query, 1, true) or description:find(query, 1, true) then
				table.insert(results, name)
			end
		end
		table.sort(results)
		return results
	end

	function pkgLib.info(name)
		name = tostring(name):lower()
		if not CATALOG[name] then return nil, "package not found: " .. name end
		return {
			name = name, version = LUAOS_VERSION, description = CATALOG[name],
			installed = settings.packages[name] == true,
		}
	end

