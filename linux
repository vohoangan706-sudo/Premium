	---------------------------------------------------------------
	-- fx (screen / panel effects)
	---------------------------------------------------------------
	fxLib = {}
	do
		local glowStroke = nil
		local glowOn, holoOn, pulseOn, particlesOn = false, false, false, false
		local fadeOriginals = {}

		local function refreshStroke()
			if not glowStroke or not glowStroke.Parent then
				glowStroke = Instance.new("UIStroke")
				glowStroke.Thickness = 0
				glowStroke.Parent = panelFrame
			end
			glowStroke.Color = holoOn and Color3.fromRGB(0, 255, 255) or AMBER
			local base = holoOn and 2 or (glowOn and 3 or 0)
			if pulseOn then base = math.max(base, 1.5) end
			glowStroke.Thickness = base
			return base
		end

		function fxLib.glow(on)
			glowOn = on ~= false
			refreshStroke()
		end

		function fxLib.hologram(on)
			holoOn = on ~= false
			panelFrame.BackgroundTransparency = holoOn and 0.5 or 0
			refreshStroke()
		end

		function fxLib.pulse(on)
			pulseOn = on ~= false
			local base = refreshStroke()
			if pulseOn then
				realTask.spawn(function()
					local t = 0
					while pulseOn and booted do
						t = t + RunService.Heartbeat:Wait()
						if glowStroke and glowStroke.Parent then
							glowStroke.Thickness = base + 1.5 * (math.sin(t * 4) + 1) / 2
						end
					end
					refreshStroke()
				end)
			end
		end

		function fxLib.blur(on)
			local blur = Lighting:FindFirstChild("LuaOSBlur")
			if on ~= false then
				if not blur then
					blur = Instance.new("BlurEffect")
					blur.Name = "LuaOSBlur"
					blur.Size = 0
					blur.Parent = Lighting
				end
				TweenService:Create(blur, TweenInfo.new(0.4), { Size = 20 }):Play()
			elseif blur then
				TweenService:Create(blur, TweenInfo.new(0.4), { Size = 0 }):Play()
				Debris:AddItem(blur, 0.5)
			end
		end

		local function fadePanel(hidden, duration)
			local info = TweenInfo.new(tonumber(duration) or 1)
			local list = { panelFrame }
			for _, inst in ipairs(panelFrame:GetDescendants()) do table.insert(list, inst) end
			for _, inst in ipairs(list) do
				local goal = {}
				local saved = fadeOriginals[inst] or {}
				if inst:IsA("GuiObject") then
					saved.bg = saved.bg or inst.BackgroundTransparency
					goal.BackgroundTransparency = hidden and 1 or saved.bg
				end
				if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
					saved.text = saved.text or inst.TextTransparency
					goal.TextTransparency = hidden and 1 or saved.text
				end
				if inst:IsA("UIStroke") then
					saved.stroke = saved.stroke or inst.Transparency
					goal.Transparency = hidden and 1 or saved.stroke
				end
				fadeOriginals[inst] = saved
				if next(goal) then
					TweenService:Create(inst, info, goal):Play()
				end
			end
		end

		function fxLib.fadeIn(duration) fadePanel(false, duration) end
		function fxLib.fadeOut(duration) fadePanel(true, duration) end

		function fxLib.particles(on)
			particlesOn = on ~= false
			if not particlesOn then return end
			realTask.spawn(function()
				while particlesOn and booted do
					local dot = Instance.new("Frame")
					local size = math.random(2, 5)
					dot.Size = UDim2.fromOffset(size, size)
					dot.Position = UDim2.new(math.random(), 0, 1, 0)
					dot.BackgroundColor3 = AMBER
					dot.BorderSizePixel = 0
					dot.ZIndex = 0
					dot.Parent = screenGui
					TweenService:Create(dot, TweenInfo.new(math.random(20, 40) / 10, Enum.EasingStyle.Linear), {
						Position = UDim2.new(dot.Position.X.Scale, math.random(-40, 40), 0.6, 0),
						BackgroundTransparency = 1,
					}):Play()
					Debris:AddItem(dot, 4.2)
					realTask.wait(0.06)
				end
			end)
		end

		function fxLib.stopAll()
			glowOn, holoOn, pulseOn, particlesOn = false, false, false, false
			panelFrame.BackgroundTransparency = 0
			if glowStroke and glowStroke.Parent then glowStroke.Thickness = 0 end
			fxLib.blur(false)
			fadePanel(false, 0.2)
		end
	end

