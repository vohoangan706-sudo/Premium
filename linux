	-- audio
	---------------------------------------------------------------
	audioLib = {}
	do
		local SOUNDS = {
			startup = "rbxasset://sounds/electronicpingshort.wav",
			click = "rbxasset://sounds/button.wav",
			beep = "rbxasset://sounds/electronicpingshort.wav",
			notify = "rbxasset://sounds/electronicpingshort.wav",
			error = "rbxasset://sounds/uuhhh.mp3",
		}
		local current = nil
		local volume = 0.6
		local pitch = 1
		local pitchEffect = nil

		local function resolve(name)
			local key = tostring(name)
			if SOUNDS[key:lower()] then return SOUNDS[key:lower()] end
			if tonumber(key) then return "rbxassetid://" .. tostring(math.floor(tonumber(key))) end
			if key:find("://") then return key end
			-- a file in the executor's workspace folder
			if type(getcustomasset) == "function" and type(isfile) == "function" and isfile(key) then
				local ok, asset = pcall(getcustomasset, key)
				if ok then return asset end
			end
			error("audio: unknown sound '" .. key .. "' (try startup, click, beep, notify, error, an asset id or a workspace file)", 3)
		end

		local function start(soundId, looped)
			checkPerm("audio")
			if current then current:Destroy() end
			local sound = Instance.new("Sound")
			sound.SoundId = soundId
			sound.Volume = volume
			sound.Looped = looped
			sound.Parent = SoundService
			pitchEffect = Instance.new("PitchShiftSoundEffect")
			pitchEffect.Octave = pitch
			pitchEffect.Parent = sound
			current = sound
			sound:Play()
			if not looped then Debris:AddItem(sound, 30) end
			return true
		end

		function audioLib.play(name) return start(resolve(name), false) end
		function audioLib.playMusic(name) return start(resolve(name), true) end

		function audioLib.stop()
			if current then current:Stop() end
		end

		function audioLib.pause()
			if current then current:Pause() end
		end

		function audioLib.resume()
			if current then current:Resume() end
		end

		function audioLib.setVolume(value)
			volume = math.clamp(tonumber(value) or volume, 0, 2)
			if current then current.Volume = volume end
		end

		function audioLib.getVolume() return volume end

		function audioLib.setPitch(value)
			pitch = math.clamp(tonumber(value) or 1, 0.5, 2)
			if pitchEffect then pitchEffect.Octave = pitch end
		end

		function audioLib.isPlaying()
			return current ~= nil and current.Parent ~= nil and current.IsPlaying
		end

		function audioLib.stopAll()
			if current then current:Destroy() current = nil end
		end
	end

