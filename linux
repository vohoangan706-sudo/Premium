	local function closeWindow(window)
		window = window or currentWindow
		if not window then return end
		for i, other in ipairs(windows) do
			if other == window then table.remove(windows, i) break end
		end
		if currentWindow == window then currentWindow = windows[#windows] end
		if window.Frame.Parent then window.Frame:Destroy() end
	end

