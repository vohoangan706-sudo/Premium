		frame.Name = "LuaOSWindow"
		frame.Size = UDim2.new(0, width, 0, height)
		frame.Position = UDim2.new(0.5, -width / 2 + #windows * 14, 0.5, -height / 2 + #windows * 14)
		frame.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
		frame.BorderSizePixel = 0
		frame.Active = true
		frame.Parent = screenGui

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 6)
		corner.Parent = frame

		local stroke = Instance.new("UIStroke")
		stroke.Color = AMBER
		stroke.Thickness = 1.5
		stroke.Parent = frame

		local bar = Instance.new("Frame")
		bar.Size = UDim2.new(1, 0, 0, 26)
		bar.BackgroundColor3 = Color3.fromRGB(40, 30, 0)
		bar.BorderSizePixel = 0
		bar.Active = true
		bar.Parent = frame

		local barCorner = Instance.new("UICorner")
		barCorner.CornerRadius = UDim.new(0, 6)
		barCorner.Parent = bar

		local barTitle = Instance.new("TextLabel")
		barTitle.Size = UDim2.new(1, -36, 1, 0)
		barTitle.Position = UDim2.new(0, 8, 0, 0)
