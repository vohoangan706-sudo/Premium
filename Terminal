	function uiLib.maximizeWindow()
		local window = target()
		if window.Maximized then
			window.Maximized = false
			window.Frame.Size = window.SavedSize or window.Frame.Size
			window.Frame.Position = window.SavedPos or window.Frame.Position
			return
		end
		if window.Minimized then
			window.Minimized = false
			window.Content.Visible = true
			window.Frame.Size = window.SavedSize or window.Frame.Size
			return
		end
		window.Maximized = true
		window.SavedSize = window.Frame.Size
		window.SavedPos = window.Frame.Position
		window.Frame.Position = UDim2.new(0, 20, 0, 20)
		window.Frame.Size = UDim2.new(1, -40, 1, -40)
