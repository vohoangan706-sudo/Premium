-- #  Type `updatelog` in the terminal to print this list.
-- #  Add one string per line between the START and END lines below.
-- #  Example:  "v1.15 - added updatelog",
-- ######################################################################
local UPDATE_LOG = {
	-- vvvvvvvvvvvvvvvvvvvv  START OF YOUR LOG  vvvvvvvvvvvvvvvvvvvv



	-- ^^^^^^^^^^^^^^^^^^^^  END OF YOUR LOG  ^^^^^^^^^^^^^^^^^^^^
}
-- ######################################################################
-- #  END OF UPDATE LOG ZONE
-- ######################################################################

commands["updatelog"] = function(args)
	if #UPDATE_LOG == 0 then
		return "No update log yet."
	end
	local lines = { PANEL_TITLE .. " — update log:" }
	for _, entry in ipairs(UPDATE_LOG) do
		table.insert(lines, "  " .. entry)
	end
	return lines
end

local hiddenCommands = { pkg = true } -- not listed by help

commands["help"] = function(args)
	local names = {}
	for name in pairs(commands) do
		if not hiddenCommands[name] then
			table.insert(names, name)
		end
	end
	table.sort(names)

	local lines = { "Available commands:" }
	for _, name in ipairs(names) do
		table.insert(lines, "  - " .. name)
	end
	return lines
end

commands["clear"] = function(args)
	clearConsole()
	return "Console cleared."
end

-------------------------------------------------
-- INPUT HANDLING
-------------------------------------------------

local function parseCommand(rawText)
	local parts = rawText:split(" ")
	local cmdName = (parts[1] or ""):lower()
	table.remove(parts, 1)
	return cmdName, parts
end

local function runCommand(cmdName, args)
	local fn = commands[cmdName]
	if fn then
		local ok, result = pcall(fn, args)
		if ok then
			return result or "Done."
		else
			return "Error: " .. tostring(result)
		end
	else
		return "Unknown command: '" .. cmdName .. "'. Type 'help' for a list."
	end
end

local processing = false

inputBox.FocusLost:Connect(function(enterPressed)
	if not enterPressed then return end
	local text = inputBox.Text
	if linuxHooks.onInput and text ~= "" then linuxHooks.onInput(text) end
	if processing or text == "" then
		inputBox.Text = ""
		return
	end

	processing = true
	inputBox.Text = ""
	inputBox.TextEditable = false

	local cmdName, args = parseCommand(text)
	addLine("$ " .. text, Color3.fromRGB(255, 220, 120))

	local result = runCommand(cmdName, args)
	if type(result) == "table" then
		for _, resultText in ipairs(result) do
			addLine(resultText, Color3.fromRGB(255, 200, 0))
		end
	else
		addLine(result, Color3.fromRGB(255, 200, 0))
	end

	inputBox.TextEditable = true
	processing = false
	inputBox:CaptureFocus()
end)

addLine(PANEL_TITLE .. " ready. Type 'help' for a list of commands.", Color3.fromRGB(255, 220, 120))

-- Print the update log in the terminal every time the panel loads.
if #UPDATE_LOG > 0 then
	addLine("Update log:", Color3.fromRGB(255, 220, 120))
	for _, entry in ipairs(UPDATE_LOG) do
		addLine("  " .. entry, Color3.fromRGB(255, 200, 0))
	end
end