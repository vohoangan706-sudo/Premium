	local function installLinux()
		if installing then
			return "Install already in progress."
		end
		if settings.linux_installed then
			if booted then
				return "Aetherfinix Linux is already installed and running."
			end
			boot(true) -- installed earlier but shut down: start it again
			return "Aetherfinix Linux restarted."
		end
		installing = true
		realTask.spawn(function()
			for _, line in ipairs(INSTALL_LINES) do
				addLine(line, AMBER)
				realTask.wait(0.07)
			end
			for name in pairs(CATALOG) do
				if not name:find("extra") then settings.packages[name] = true end
			end
			settings.linux_installed = true
			saveSettings()
			installing = false
			boot(true)
		end)
		return "Installing Aetherfinix Linux..."
	end

