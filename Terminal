RunService:Heartbeat:Connect(function()

	if not ACTIVE then
		return
	end

	local target = findPlayer(targetBox.Text)

	if not target then

		status.Text = "Target not found :("
		status.TextColor3 =
			Color3.fromRGB(190, 80, 50)

		return
	end

	local myCharacter = LocalPlayer.Character
	local targetCharacter = target.Character

	if not myCharacter or not targetCharacter then
		return
	end

	local myRoot =
		myCharacter:FindFirstChild("HumanoidRootPart")

	local targetRoot =
		targetCharacter:FindFirstChild("HumanoidRootPart")

	if not myRoot or not targetRoot then
		return
	end

	-- =========================
	-- CAMERA SPECTATE
	-- =========================

	Camera.CameraType = Enum.CameraType.Scriptable

	spectateTarget(targetRoot)

	-- =========================
	-- UNDER ATTRACTOR
	-- =========================

	local humanoid =
		myCharacter:FindFirstChildOfClass("Humanoid")

	if humanoid then
		humanoid.AutoRotate = false
	end

	local targetBoxCFrame, targetBoxSize =
		targetCharacter:GetBoundingBox()

	local myBoxCFrame, myBoxSize =
		myCharacter:GetBoundingBox()

	local targetBottom =
		targetBoxCFrame.Position.Y
		- (targetBoxSize.Y / 2)

	local myHalfHeight =
		myBoxSize.Y / 2

	local desiredY =
		targetBottom
		- DISTANCE
		- myHalfHeight

	local position = Vector3.new(
		targetRoot.Position.X,
		desiredY,
		targetRoot.Position.Z
	)

	local lookDirection =
		Vector3.new(0, 1, 0)

	local upDirection =
		targetRoot.CFrame.RightVector

	local finalCFrame =
		CFrame.lookAt(
			position,
			position + lookDirection,
			upDirection
		)

	myRoot.AssemblyLinearVelocity =
		Vector3.zero

	myRoot.AssemblyAngularVelocity =
		Vector3.zero

	myCharacter:PivotTo(finalCFrame)

	status.Text =
		"Under: "
		.. target.Name
		.. " • 3 STUD GAP • CAM 5 STUDS"

	status.TextColor3 =
		Color3.fromRGB(105, 135, 35)
end)

end

