-- Shared "park here forever" mechanic: keeps re-snapping the HRP to
-- whatever `getPosition()` currently returns, every frame, until
-- stopped.
-- Moves the ENTIRE character (every part, accessory and any extra
-- hitbox parts) with PivotTo instead of only the HumanoidRootPart, and
-- clears velocity so nothing drifts or lags behind the root part.
local function teleportFullBody(char, cf)
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if hrp then
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
	end
	char:PivotTo(cf)
end

local function createVoidLoop(getPosition, fullBody)
	local connection = nil
	local function isActive()
		return connection ~= nil
	end
	local function startLoop()
		if connection then return end
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if hrp then
			if fullBody then
				teleportFullBody(char, CFrame.new(getPosition()))
			else
				hrp.CFrame = CFrame.new(getPosition())
			end
		end
		connection = RunService.Heartbeat:Connect(function()
			local currentChar = player.Character
			local currentHrp = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
			if currentHrp then
				if fullBody then
					teleportFullBody(currentChar, CFrame.new(getPosition()))
				else
					currentHrp.CFrame = CFrame.new(getPosition())
				end
			end
		end)
	end
	local function stopLoop()
		if connection then
			connection:Disconnect()
			connection = nil
		end
	end
	return startLoop, stopLoop, isActive
end

