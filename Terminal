local ADMIN_ORBIT_RADIUS = 3 -- small enough to stay in contact with the target's hitbox
local ADMIN_ORBIT_SPEED = 50 -- studs/second along the circle

-- Circles your character tightly around a target's HRP for `duration`
-- seconds, close enough that your hitbox stays touching theirs the
-- whole time.
local function orbitTargetBriefly(targetHrp, duration)
	local startTime = os.clock()
	local angularSpeed = ADMIN_ORBIT_SPEED / ADMIN_ORBIT_RADIUS -- rad/sec

	while os.clock() - startTime < duration do
		if not targetHrp.Parent then break end
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then break end

		local elapsed = os.clock() - startTime
		local angle = angularSpeed * elapsed
		local centerPos = targetHrp.Position
		local offset = Vector3.new(math.cos(angle) * ADMIN_ORBIT_RADIUS, 0, math.sin(angle) * ADMIN_ORBIT_RADIUS)
		hrp.CFrame = CFrame.new(centerPos + offset, centerPos)

		task.wait()
	end
end

local function getSelectedTargetHrps()
	local targetHrps = {}
	for _, targetPlayer in ipairs(selectedCheckPlayers) do
		local targetChar = targetPlayer.Character
		local targetHrp = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
		if targetHrp then
			table.insert(targetHrps, targetHrp)
		end
	end
	return targetHrps
end

-------------------------------------------------
-- GODMODE (Option B: stay at 0 HP, but stay mobile)
-- Drops your Health to 0 via the void, but disables Roblox's Dead
-- state first so you never ragdoll, never get locked out of
-- movement, and never respawn — you just stay fully mobile at 0 HP.
-- Since most games' damage code checks "if health <= 0, do nothing,"
-- further hits can't affect you. R6 animations are force-applied so
-- the corpse still walks/idles normally.
--
-- Caveat: this only works if Health/death for your own character is
-- decided client-side (the common case, since your own Humanoid is
-- usually network-owned by your own client). If your game's kill or
-- respawn logic is authoritative on the server, it can still force a
-- real respawn regardless of what this script does — if that
-- happens, the CharacterAdded handler below detects it and
-- automatically re-runs the whole sequence on the new character, so
-- it keeps re-answering every forced respawn rather than staying
-- broken after the first one.
-------------------------------------------------

local GODMODE_RESET_Y = -10000
local GODMODE_KILL_TIMEOUT = 3 -- give the void up to this long to actually zero your Health

local R6_DEFAULT_ANIMATIONS = {
	idle1 = "180435571", idle2 = "180435792",
	walk = "180426354", run = "180426354",
	jump = "125750702", fall = "180436148",
	climb = "180436334", sit = "178130996",
}

-- Shared by any animation set (the classic R6 defaults, or a themed
-- set like Viltrumite for The Supreme) — same slot names either way,
-- since Roblox's default Animate script structure doesn't change.
local function applyAnimationSet(char, animSet)
	local animate = char and char:FindFirstChild("Animate")
	if not animate then return end

	local function setAnim(container, childName, animId)
		local child = container and container:FindFirstChild(childName)
		local animValue = child and child:FindFirstChild("AnimationId")
		if animValue and animId then
			animValue.Value = "rbxassetid://" .. animId
		end
	end

	local idle = animate:FindFirstChild("idle")
	setAnim(idle, "Animation1", animSet.idle1)
	setAnim(idle, "Animation2", animSet.idle2)
	setAnim(animate:FindFirstChild("walk"), "WalkAnim", animSet.walk)
	setAnim(animate:FindFirstChild("run"), "RunAnim", animSet.run)
	setAnim(animate:FindFirstChild("jump"), "JumpAnim", animSet.jump)
	setAnim(animate:FindFirstChild("fall"), "FallAnim", animSet.fall)
	setAnim(animate:FindFirstChild("climb"), "ClimbAnim", animSet.climb)
	setAnim(animate:FindFirstChild("sit"), "Sit", animSet.sit)
end

local function applyDefaultR6Animations(char)
	applyAnimationSet(char, R6_DEFAULT_ANIMATIONS)
end

local godmodeActive = false

-- Forward-declared: defined later (THE SUPREME FLOATING TEXT section),
-- but deactivateGodmode below needs to call it regardless of whether
-- it was ever started, so it's declared here first and assigned later.
local stopSupremeText = function() end

local function isGodmode()
	return godmodeActive
end

-- Runs the full drop-and-lock sequence on whatever character is
-- currently loaded. Safe to call again on a fresh character (e.g.
-- after a forced respawn) — it doesn't depend on any state from a
-- previous character.
local GODMODE_MUSIC_ID = "rbxassetid://92563891769161"
local godmodeSound = nil

local function getGodmodeSound()
	if not godmodeSound then
		local sound = Instance.new("Sound")
		sound.Name = "GodmodeMusic"
		sound.SoundId = GODMODE_MUSIC_ID
		sound.Looped = true
		sound.Volume = 0.5
		sound.Parent = SoundService
		godmodeSound = sound
	end
	return godmodeSound
end

local function activateGodmode()
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not (char and hum and hrp) then return false end

	-- Disabling the Dead state BEFORE Health hits 0 is what prevents
	-- the ragdoll/lock-out/respawn from ever kicking in once it does.
	hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
	hum.BreakJointsOnDeath = false

	local returnCFrame = hrp.CFrame
	hrp.CFrame = CFrame.new(hrp.Position.X, GODMODE_RESET_Y, hrp.Position.Z)

	local waited = 0
	while hum.Health > 0 and waited < GODMODE_KILL_TIMEOUT do
		task.wait(0.1)
		waited += 0.1
	end

	-- Back to solid ground — corpse, 0 HP, and all — instead of
	-- staying physically parked in the void.
	local currentChar = player.Character
	local currentHrp = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
	if currentHrp then
		currentHrp.CFrame = returnCFrame
	end
	applyDefaultR6Animations(currentChar)

	getGodmodeSound():Play()

	godmodeActive = true
	return true
end

local function deactivateGodmode()
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
		hum.Health = hum.MaxHealth
	end
	if godmodeSound then
		godmodeSound:Stop()
	end
	stopSupremeText()
	godmodeActive = false
end

-- Single respawn handler covering every persistent state above.
player.CharacterAdded:Connect(function(newChar)
	if godmodeActive then
		-- A real respawn only happens here if your game's kill/respawn
		-- logic is server-authoritative and forced it despite the Dead
		-- state trick. Re-run the whole sequence on the new character
		-- so it keeps re-answering every forced respawn.
		task.spawn(function()
			newChar:WaitForChild("HumanoidRootPart", 5)
			activateGodmode()
		end)
	end
end)

