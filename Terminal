--[[
    Terminalpanel Premium
    ------------------------------------------------------------
    Place this as a second LocalScript inside StarterPlayerScripts,
    alongside the main TerminalPanel script.

    This is a fully separate script on purpose: it has its own
    Luau 200-local-variable budget, independent of the main
    TerminalPanel script. All the admin-exclusive tools that used
    to live inside TerminalPanel (admincheck, check2, godmode) have
    been moved here so the main script has headroom again.

    If the local player's UserId isn't in ADMIN_USER_IDS below, this
    entire script does nothing at all — no UI is created, nothing is
    visible, nothing is discoverable. That's stronger hiding than
    per-command checks can offer, since there's no shared panel for
    a non-admin to even probe with command names.
--]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local SoundService = game:GetService("SoundService")

local player = Players.LocalPlayer

-- Fill in your own UserId(s) here. This only hides the panel from
-- everyone else — it's a LocalScript check, so it can't be made
-- tamper-proof against someone editing their own client. True
-- enforcement would need a server Script + RemoteEvent.
local ADMIN_USER_IDS = {
	3101624536,
	11535922291,
	11517308890,
	11717723065,
}

-- Anyone not in the list above gets a full-screen white "jumpscare"
-- with two lines of text, then is kicked after JUMPSCARE_SECONDS with
-- KICK_MESSAGE. Nothing below this block ever runs for them. Set
-- KICK_NON_ADMINS to false to go back to silently doing nothing.
local KICK_NON_ADMINS = true
local KICK_MESSAGE = "._.___._..._._.._"
local JUMPSCARE_SECONDS = 4
local JUMPSCARE_LINE_1 = "空に見えますか？"
local JUMPSCARE_LINE_2 = "見ないでください。重大な結果"

if not table.find(ADMIN_USER_IDS, player.UserId) then
	if KICK_NON_ADMINS then
		-- full-screen white cover with the two lines centered, on top of everything
		local scareGui = Instance.new("ScreenGui")
		scareGui.Name = "AccessDenied"
		scareGui.IgnoreGuiInset = true
		scareGui.ResetOnSpawn = false
		scareGui.DisplayOrder = 2147483647
		scareGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

		local cover = Instance.new("Frame")
		cover.Size = UDim2.new(1, 0, 1, 0)
		cover.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		cover.BorderSizePixel = 0
		cover.Active = true -- swallow clicks/taps so nothing underneath is usable
		cover.Parent = scareGui

		local textHolder = Instance.new("Frame")
		textHolder.AnchorPoint = Vector2.new(0.5, 0.5)
		textHolder.Position = UDim2.new(0.5, 0, 0.5, 0)
		textHolder.Size = UDim2.new(1, -40, 0, 110)
		textHolder.BackgroundTransparency = 1
		textHolder.Parent = cover

		local textLayout = Instance.new("UIListLayout")
		textLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
		textLayout.VerticalAlignment = Enum.VerticalAlignment.Center
		textLayout.Padding = UDim.new(0, 14)
		textLayout.Parent = textHolder

		local function addScareLine(text, size, order)
			local label = Instance.new("TextLabel")
			label.LayoutOrder = order
			label.Size = UDim2.new(1, 0, 0, size + 14)
			label.BackgroundTransparency = 1
			label.Text = text
			label.TextColor3 = Color3.fromRGB(0, 0, 0)
			label.Font = Enum.Font.SourceSansBold
			label.TextSize = size
			label.TextWrapped = true
			label.Parent = textHolder
		end
		addScareLine(JUMPSCARE_LINE_1, 40, 1)
		addScareLine(JUMPSCARE_LINE_2, 32, 2)

		pcall(function()
			scareGui.Parent = player:WaitForChild("PlayerGui", 5)
		end)

		task.delay(JUMPSCARE_SECONDS, function()
			player:Kick(KICK_MESSAGE)
		end)
	end
	return -- not an admin: nothing below this line ever runs for you
end

