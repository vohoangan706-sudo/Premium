-------------------------------------------------
-- THE SUPREME
-- Combines godmode (Option B, with its music) with your own
-- hat/wings code, your own flying code, and a played animation, all
-- from one command.
-------------------------------------------------

local function runHatWingsScript()
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")

	local player = Players.LocalPlayer

	local SWORD_PITCH = -90
	local SWORD_TWIST = 90

	local TILT_BACKWARD = -10
	local Y_CENTER_POS = 2.8

	local SIGIL_ID = 131448000848567
	local SIGIL_Z_DEPTH = 3.0
	local SIGIL_ATTACH_OFFSET = 3.2
	local SIGIL_SPIN_SPEED = 3.0

	local DEPTH_PER_PAIR = {3.0, 6.5, 8.5, 10.5, 12.5}
	local ANGLE_PER_PAIR = {18, 35, 52, 69, 86}
	local OFFSET_PER_PAIR = {0, 2.2, 4.2, 6.2, 8.2}

	local FLAP_SPEED = 4.2
	local FLAP_ANGLE_MAX = 28
	local FLAP_HEIGHT_MAX = 1.8
	local FLAP_TILT_MAX = 12

	local autoLoadIds = {
		6202662855,
		6202665143,
		6202672186,
		6202663797,
		6202666587,
		6202670464,
		5355685721,
		6202664431,
		86679127741967,
		81059652095084,
		SIGIL_ID
	}

	local managedHats = {}
	local sigilWeld = nil
	local renderConnection = nil

	local function clearAttachments()
		for _, data in ipairs(managedHats) do
			if data.TargetAttachment then data.TargetAttachment:Destroy() end
			if data.AlignPos then data.AlignPos:Destroy() end
			if data.AlignOri then data.AlignOri:Destroy() end
		end
		managedHats = {}

		if sigilWeld then
			sigilWeld:Destroy()
			sigilWeld = nil
		end
	end

	local function setupHat(accessory)
		local character = player.Character
		if not character then return end
		local hrp = character:FindFirstChild("HumanoidRootPart")
		if not hrp then return end

		local handle = accessory:FindFirstChild("Handle")
		if not handle then return end

		local isSigil = string.find(accessory.Name, tostring(SIGIL_ID)) or (accessory:FindFirstChild("AssetId") and accessory.AssetId == SIGIL_ID)

		for _, child in ipairs(handle:GetChildren()) do
			if child:IsA("Weld") or child:IsA("WeldConstraint") or child:IsA("Motor6D") then
				child:Destroy()
			end
		end

		if isSigil then
			handle.Massless = true
			handle.CanCollide = false

			sigilWeld = Instance.new("Weld")
			sigilWeld.Name = "SigilWeld"
			sigilWeld.Part0 = hrp
			sigilWeld.Part1 = handle
			sigilWeld.C0 = CFrame.new(0, Y_CENTER_POS, SIGIL_Z_DEPTH)
			sigilWeld.Parent = handle
			return
		end

		local handleAttachment = handle:FindFirstChild("WingAttachment")
		if not handleAttachment then
			handleAttachment = Instance.new("Attachment")
			handleAttachment.Name = "WingAttachment"
			handleAttachment.Parent = handle
		end

		handleAttachment.CFrame = CFrame.identity

		local targetAttachment = Instance.new("Attachment")
		targetAttachment.Name = "TargetAttachment"
		targetAttachment.Parent = hrp

		local alignPos = Instance.new("AlignPosition")
		alignPos.Attachment0 = handleAttachment
		alignPos.Attachment1 = targetAttachment
		alignPos.MaxForce = math.huge
		alignPos.Responsiveness = 200
		alignPos.Parent = handle

		local alignOri = Instance.new("AlignOrientation")
		alignOri.Attachment0 = handleAttachment
		alignOri.Attachment1 = targetAttachment
		alignOri.MaxTorque = math.huge
		alignOri.Responsiveness = 200
		alignOri.Parent = handle

		table.insert(managedHats, {
			Accessory = accessory,
			Handle = handle,
			TargetAttachment = targetAttachment
		})
	end

	local function stopEffect()
		if renderConnection then
			renderConnection:Disconnect()
			renderConnection = nil
		end
		clearAttachments()
	end

	local function startEffect()
		stopEffect()
		local character = player.Character
		if not character then return end

		for _, item in ipairs(character:GetChildren()) do
			if item:IsA("Accessory") then
				setupHat(item)
			end
		end

		renderConnection = RunService.RenderStepped:Connect(function()
			local time = tick()

			if sigilWeld then
				local spinRotation = CFrame.Angles(0, 0, time * SIGIL_SPIN_SPEED)
				sigilWeld.C0 = CFrame.new(0, Y_CENTER_POS, SIGIL_Z_DEPTH) * spinRotation
			end

			local numHats = #managedHats
			if numHats == 0 then return end

			local flapWave = math.sin(time * FLAP_SPEED)
			local flapCos = math.cos(time * FLAP_SPEED)

			for i, hatData in ipairs(managedHats) do
				if hatData.TargetAttachment and hatData.TargetAttachment.Parent then
					local isLeft = (i % 2 == 1)
					local wingIndex = math.ceil(i / 2)

					local zDepth = DEPTH_PER_PAIR[wingIndex] or (3.0 + (wingIndex - 1) * 2.5)
					local baseAngle = ANGLE_PER_PAIR[wingIndex] or (18 + (wingIndex - 1) * 18)
					local outwardOffset = OFFSET_PER_PAIR[wingIndex] or ((wingIndex - 1) * 2.2)

					local dynamicFlapAngle = flapWave * (wingIndex == 1 and (FLAP_ANGLE_MAX * 0.55) or FLAP_ANGLE_MAX)
					local verticalLift = (wingIndex == 1) and 0 or (flapWave * FLAP_HEIGHT_MAX)
					local strokePitch = (wingIndex == 1) and (flapCos * FLAP_TILT_MAX * 0.3) or (flapCos * FLAP_TILT_MAX)

					local spreadAngle = baseAngle + dynamicFlapAngle

					if not isLeft then
						spreadAngle = -spreadAngle
					end

					local xPivot = isLeft and -SIGIL_ATTACH_OFFSET or SIGIL_ATTACH_OFFSET
					local centerPivot = CFrame.new(xPivot, Y_CENTER_POS + verticalLift, zDepth)

					local fanRotation = CFrame.Angles(0, 0, math.rad(spreadAngle))
					local tiltRotation = CFrame.Angles(math.rad(TILT_BACKWARD + strokePitch), 0, 0)
					local swordSelfRotation = CFrame.Angles(math.rad(SWORD_PITCH), math.rad(SWORD_TWIST), 0)

					hatData.TargetAttachment.CFrame = centerPivot
						* fanRotation
						* tiltRotation
						* CFrame.new(0, outwardOffset, 0)
						* swordSelfRotation
				end
			end
		end)
	end

	local function executeAutoLoad()
		local character = player.Character or player.CharacterAdded:Wait()

		for _, id in ipairs(autoLoadIds) do
			pcall(function()
				local objects = game:GetObjects("rbxassetid://" .. id)
				for _, obj in ipairs(objects) do
					if obj:IsA("Accessory") then
						if id == SIGIL_ID then
							obj.Name = tostring(SIGIL_ID)
						end
						obj.Parent = character
