local adminCheckFrame = nil
local selectedCheckPlayers = {} -- ordered list of Player instances, no cap

local function isPlayerSelected(targetPlayer)
	return table.find(selectedCheckPlayers, targetPlayer) ~= nil
end

local function toggleCheckSelection(targetPlayer)
	local index = table.find(selectedCheckPlayers, targetPlayer)
	if index then
		table.remove(selectedCheckPlayers, index)
		return true
	end
	table.insert(selectedCheckPlayers, targetPlayer)
	return true
end

-- Your game's existing status-check hotkey, simulated via
-- VirtualInputManager. Note: this API is restricted to Studio/plugin
-- contexts on Roblox — it may do nothing (silently, via the pcall)
-- once this script is running in a real published game rather than
-- in Studio.
local function runAdminKeyCheck()
	local ok, err = pcall(function()
		VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Three, false, game)
		task.wait(0.03)
		VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Three, false, game)
	end)
	if not ok then
		warn("3 key simulation failed:", err)
	end
end

local adminCheckReturnCFrame = nil
local adminVoidLoopStart, adminVoidLoopStop, adminCheckParked = createVoidLoop(getVoidPosition)

local ADMIN_ORBIT_RADIUS = 3 -- small enough to stay in contact with the target's hitbox
local ADMIN_ORBIT_SPEED = 50 -- studs/second along the circle

-- Circles your character tightly around a target's HRP for `duration`
-- seconds, close enough that your hitbox stays touching theirs the
-- whole time.
local function orbitTargetBriefly(targetHrp, duration)
	local startTime = os.clock()
	local angularSpeed = ADMIN_ORBIT_SPEED / ADMIN_ORBIT_RADIUS -- rad/sec

	while os.clock() - startTime < duration do
		if not targetHrp.Parent then break end
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then break end

		local elapsed = os.clock() - startTime
		local angle = angularSpeed * elapsed
		local centerPos = targetHrp.Position
		local offset = Vector3.new(math.cos(angle) * ADMIN_ORBIT_RADIUS, 0, math.sin(angle) * ADMIN_ORBIT_RADIUS)
		hrp.CFrame = CFrame.new(centerPos + offset, centerPos)

		task.wait()
	end
end

local function getSelectedTargetHrps()
	local targetHrps = {}
	for _, targetPlayer in ipairs(selectedCheckPlayers) do
		local targetChar = targetPlayer.Character
		local targetHrp = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
		if targetHrp then
			table.insert(targetHrps, targetHrp)
		end
	end
	return targetHrps
end

-- admincheck: key 3 -> wait -> orbit-sweep every selected player
-- (bounded to ~1s total) -> park on the void platform on a loop.
local function runAdminCheckSequence()
	createVoidPlatform()

	local startChar = player.Character
	local startHrp = startChar and startChar:FindFirstChild("HumanoidRootPart")
	if startHrp then
		adminCheckReturnCFrame = startHrp.CFrame
	end

	runAdminKeyCheck()
	task.wait(0.5)

	local targetHrps = getSelectedTargetHrps()
	if #targetHrps > 0 then
		local perStep = 1.21 / #targetHrps
		for _, targetHrp in ipairs(targetHrps) do
			orbitTargetBriefly(targetHrp, perStep)
		end
	end

	adminVoidLoopStart()
end

-- Stops the loop and returns you to wherever you were right before
-- the check sequence started.
local function returnFromAdminCheck()
	adminVoidLoopStop()

	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp and adminCheckReturnCFrame then
		hrp.CFrame = adminCheckReturnCFrame
	end
	adminCheckReturnCFrame = nil
end

-- check2: same key-3 + orbit-sweep idea, but bounded to 0.5s total,
-- then a brief stop on the void platform before dropping to -10000y
-- and anchoring there instead of staying on the platform loop.
local check2Parked = false

local function runCheck2Sequence()
	createVoidPlatform()

	runAdminKeyCheck()
	task.wait(0.4)

	local targetHrps = getSelectedTargetHrps()
	if #targetHrps > 0 then
		local perStep = 0.7 / #targetHrps
		for _, targetHrp in ipairs(targetHrps) do
			orbitTargetBriefly(targetHrp, perStep)
		end
	end

	adminVoidLoopStart()
	task.wait(0.3)
	adminVoidLoopStop()

	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp then
		hrp.CFrame = CFrame.new(0, -10000, 0)
		hrp.Anchored = true
	end
	check2Parked = true
end

