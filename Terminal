-- SHARED HELPERS
-- Own copies, independent of the main TerminalPanel script — this
-- script can't reach into another script's locals, so the void
-- platform/loop/toggle mechanics are duplicated here rather than
-- shared. Functionally identical to the main script's versions.
-------------------------------------------------

local function createToggle(signal, onTick, onStart, onStop)
	local connection = nil
	local function isOn()
		return connection ~= nil
	end
	local function turnOn()
		if connection then return end
		if onStart then onStart() end
		connection = signal:Connect(onTick)
	end
	local function turnOff()
		if not connection then return end
		connection:Disconnect()
		connection = nil
		if onStop then onStop() end
	end
	return turnOn, turnOff, isOn
end

local VOID_POSITION = Vector3.new(0, -500, 0)
local VOID_PLATFORM_SIZE = Vector3.new(4000, 0.5, 4000)
local voidPlatform = nil

local function createVoidPlatform()
	if voidPlatform then return voidPlatform end

	local platform = Instance.new("Part")
	platform.Name = "VoidPlatformPremium"
	platform.Size = VOID_PLATFORM_SIZE
	platform.Position = VOID_POSITION - Vector3.new(0, VOID_PLATFORM_SIZE.Y / 2, 0)
	platform.Anchored = true
	platform.CanCollide = true
	platform.Material = Enum.Material.Glass
	platform.Color = Color3.fromRGB(210, 235, 255)
	platform.Transparency = 0.55
	platform.Reflectance = 0.15
	platform.Parent = workspace

	voidPlatform = platform
	return platform
end

local function getVoidPosition()
	return VOID_POSITION
end

-- Shared "park here forever" mechanic: keeps re-snapping the HRP to
-- whatever `getPosition()` currently returns, every frame, until
-- stopped.
local function createVoidLoop(getPosition)
	local connection = nil
	local function isActive()
		return connection ~= nil
	end
	local function startLoop()
		if connection then return end
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if hrp then
			hrp.CFrame = CFrame.new(getPosition())
		end
		connection = RunService.Heartbeat:Connect(function()
			local currentChar = player.Character
			local currentHrp = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
			if currentHrp then
				currentHrp.CFrame = CFrame.new(getPosition())
			end
		end)
	end
	local function stopLoop()
		if connection then
			connection:Disconnect()
			connection = nil
		end
	end
	return startLoop, stopLoop, isActive
end

