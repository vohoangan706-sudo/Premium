-- PLACE TELEPORT
-- A small panel listing fixed places. Picking one starts looping you
-- there (same re-snap-every-frame mechanic as televoid/admincheck,
-- reusing the same createVoidLoop helper — it already takes any
-- position, not just the void's), and switching to a different place
-- while already looping just retargets it, no need to stop first.
-- "Stop" ends the loop and returns you to wherever you were before
-- you started, same convention as every other loop feature here.
-------------------------------------------------

local PLACE_PLATFORM_SIZE = Vector3.new(4000, 0.5, 4000)
local placePlatforms = {} -- keyed by place name, so each is only built once

-- Generic version of createVoidPlatform for places other than the
-- void itself (Deepvoid, The Sky) — same look, any position.
local function createPlacePlatform(place)
	if placePlatforms[place.name] then return end

	local platform = Instance.new("Part")
	platform.Name = "PlaceTeleportPlatform_" .. place.name
	platform.Size = PLACE_PLATFORM_SIZE
	platform.Position = place.position - Vector3.new(0, PLACE_PLATFORM_SIZE.Y / 2, 0)
	platform.Anchored = true
	platform.CanCollide = true
	platform.Material = Enum.Material.Glass
	platform.Color = Color3.fromRGB(210, 235, 255)
	platform.Transparency = 0.55
	platform.Reflectance = 0.15
	platform.Parent = workspace

	placePlatforms[place.name] = platform
end

local PLACES = {
	{ name = "Void", position = Vector3.new(0, -500, 0), platformFn = createVoidPlatform },
	{ name = "Deepvoid", position = Vector3.new(0, -10000, 0), platformFn = createPlacePlatform },
	{ name = "Null Zone", position = Vector3.new(100000000, 100000000, 100000000), platformFn = nil },
	{ name = "The Sky", position = Vector3.new(0, 2000, 0), platformFn = createPlacePlatform },
}

local currentPlaceTarget = nil
local placeTeleportReturnCFrame = nil

local placeLoopStart, placeLoopStop, isPlaceLooping = createVoidLoop(function()
	return currentPlaceTarget
end, true) -- true = move the entire body + hitbox, not just the root part

-- Picking a place while already looping just retargets the existing
-- loop (currentPlaceTarget is read fresh every frame) — only the
-- very first pick captures your return spot.
local function selectPlace(place)
	if place.platformFn then
		place.platformFn(place)
	end

	if not isPlaceLooping() then
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if hrp then
			placeTeleportReturnCFrame = hrp.CFrame
		end
	end

	currentPlaceTarget = place.position
	placeLoopStart()
end

local function stopPlaceTeleport()
	placeLoopStop()

	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp and placeTeleportReturnCFrame then
		teleportFullBody(char, placeTeleportReturnCFrame)
	end
	placeTeleportReturnCFrame = nil
	currentPlaceTarget = nil
end

