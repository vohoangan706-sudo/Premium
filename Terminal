-- TRUECHECK
-- More accurate status check — the real detection logic already
-- lives in your game's own key-2 hook, same idea as key-3 for
-- admincheck. Sequence: key 2 -> wait -> orbit-sweep every selected
-- player (bounded to 0.8s total) -> loop-park on the void platform
-- (same createVoidLoop mechanic as televoid/admincheck, not a raw
-- anchor) -> wait -> stop the loop and return to wherever you were
-- standing before the sequence started.
-------------------------------------------------

local function runTrueKeyCheck()
	local ok, err = pcall(function()
		VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Two, false, game)
		task.wait(0.03)
		VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Two, false, game)
	end)
	if not ok then
		warn("2 key simulation failed:", err)
	end
end

local trueCheckReturnCFrame = nil

-- Truecheck's own void-parking loop, separate from
-- adminVoidLoopStart/Stop (shared by admincheck/check2) since those
-- just use plain upright CFrame.new(position) — this one also rotates
-- the character to lie horizontal, facing down into the void below,
-- instead of standing upright on the platform.
local TRUECHECK_VOID_POSITION = Vector3.new(0, -501, 0)
local trueCheckPlatform = nil

-- Truecheck's own glass platform at its own depth (the shared void
-- platform stays at -500 for admincheck/check2/televoid).
local function createTrueCheckPlatform()
	if trueCheckPlatform and trueCheckPlatform.Parent then return end
	local platform = Instance.new("Part")
	platform.Name = "TrueCheckPlatformPremium"
	platform.Size = VOID_PLATFORM_SIZE
	platform.Position = TRUECHECK_VOID_POSITION - Vector3.new(0, VOID_PLATFORM_SIZE.Y / 2, 0)
	platform.Anchored = true
	platform.CanCollide = true
	platform.Material = Enum.Material.Glass
	platform.Color = Color3.fromRGB(210, 235, 255)
	platform.Transparency = 0.55
	platform.Reflectance = 0.15
	platform.Parent = workspace
	trueCheckPlatform = platform
end

local trueCheckCurrentTarget = TRUECHECK_VOID_POSITION
local trueCheckVoidConnection = nil

local function applyTrueCheckPose()
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	hrp.AssemblyLinearVelocity = Vector3.zero
	hrp.AssemblyAngularVelocity = Vector3.zero
	hrp.CFrame = CFrame.new(trueCheckCurrentTarget) -- upright, no rotation
end

local function startTrueCheckVoidLoop()
	if trueCheckVoidConnection then return end
	applyTrueCheckPose()
	trueCheckVoidConnection = RunService.Heartbeat:Connect(applyTrueCheckPose)
end

local function stopTrueCheckVoidLoop()
	if trueCheckVoidConnection then
		trueCheckVoidConnection:Disconnect()
		trueCheckVoidConnection = nil
	end
end

-- ######################################################################
-- #  TRUECHECK CUSTOM CODE ZONE
-- #  Runs at the very START of every truecheck (before the orbit sweep).
-- #  The original opening steps (save return spot, key check, 0.3s wait)
-- #  now live inside it — keep them unless you mean to change them. Wrapped in pcall, so an error in your code
-- #  can't break the rest of truecheck. Locals in here don't count
-- #  toward the 200-local limit. Available: `player`, `selectedCheckPlayers`.
-- #  ONLY PASTE BETWEEN THE "START" AND "END" LINES BELOW.
-- ######################################################################
local function runTrueCheckCustomCode()
	-- vvvvvvvvvvvvvvvvvvvv  START OF YOUR CODE  vvvvvvvvvvvvvvvvvvvv
	local RunService = game:GetService("RunService")
	local localPlayer = game:GetService("Players").LocalPlayer

	workspace.FallenPartsDestroyHeight = (0/0)

	workspace:GetPropertyChangedSignal("FallenPartsDestroyHeight"):Connect(function()
		local fallenPartsDestroyHeight = workspace.FallenPartsDestroyHeight

		if fallenPartsDestroyHeight == fallenPartsDestroyHeight then
			workspace.FallenPartsDestroyHeight = (0/0)
		end
	end)

	local part = Instance.new("Part", workspace)
	part.CFrame = CFrame.new(0, -10008, 0)
	part.Anchored = true
	part.Size = Vector3.new(2048, 10, 2048)
	part.Transparency = 0.5
	part.CanCollide = true
	part.Name = game:GetService("HttpService"):GenerateGUID()
	local health = 100
	local connection = nil
	local connection2 = nil

	local function fn8(arg)
		if not arg then
			return
		end
		local humanoid = arg:FindFirstChildOfClass("Humanoid") or arg:WaitForChild("Humanoid", 3)
		local humanoidRootPart = arg:FindFirstChild("HumanoidRootPart") or arg:WaitForChild("HumanoidRootPart", 3)
		if not humanoid or not humanoidRootPart then
			return
		end
		health = humanoid.Health

		if connection then
			connection:Disconnect()
			connection = nil
		end

		if connection2 then
			connection2:Disconnect()
			connection2 = nil
		end

		connection2 = RunService.RenderStepped:Connect(function()
			local humanoidRootPart2 = arg:FindFirstChild("HumanoidRootPart")

			if humanoidRootPart2 then
				health = humanoid.Health
				part.CFrame = CFrame.new(humanoidRootPart2.Position.X, -10008, humanoidRootPart2.Position.Z)
			end
		end)

		connection = humanoid.HealthChanged:Connect(function(health2)
			local humanoidRootPart2 = arg:FindFirstChild("HumanoidRootPart")

			if health2 <= 0 and humanoidRootPart2 and humanoidRootPart2.CFrame.Y <= 0 then
				humanoid.Health = health
			end
		end)
	end

	fn8(localPlayer.Character)

	localPlayer.CharacterAdded:Connect(function(character)
		task.wait(0.1)
		fn8(character)
	end)
	-- ^^^^^^^^^^^^^^^^^^^^  END OF YOUR CODE  ^^^^^^^^^^^^^^^^^^^^
end
-- ######################################################################
-- #  END OF TRUECHECK CUSTOM CODE ZONE
-- ######################################################################

local function runTrueCheckSequence()
	local startChar = player.Character
	local startHrp = startChar and startChar:FindFirstChild("HumanoidRootPart")
	if startHrp then
		trueCheckReturnCFrame = startHrp.CFrame
	end

	pcall(runTrueCheckCustomCode)

	runTrueKeyCheck() -- presses key 2
	task.wait(0.3)

	local targetHrps = getSelectedTargetHrps()
	if #targetHrps > 0 then
		local perStep = 1.7 / #targetHrps
		for _, targetHrp in ipairs(targetHrps) do
			orbitTargetBriefly(targetHrp, perStep)
		end
	end

	createTrueCheckPlatform()
	-- anchor at -501y for 4s, then go back
	trueCheckCurrentTarget = TRUECHECK_VOID_POSITION
	startTrueCheckVoidLoop()
	task.wait(4)
	stopTrueCheckVoidLoop()

	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp and trueCheckReturnCFrame then
		hrp.CFrame = trueCheckReturnCFrame
	end
	trueCheckReturnCFrame = nil
end

