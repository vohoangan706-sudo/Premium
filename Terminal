	function uiLib.slider(min, max, default, onChange)
		min, max = tonumber(min) or 0, tonumber(max) or 100
		local value = math.clamp(tonumber(default) or min, min, max)

		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, -8, 0, 36)
		row.BackgroundTransparency = 1
		row.Parent = target().Content

		local readout = Instance.new("TextLabel")
		readout.Size = UDim2.new(1, 0, 0, 16)
		readout.BackgroundTransparency = 1
		readout.Font = Enum.Font.Code
		readout.TextSize = 13
		readout.TextColor3 = AMBER
		readout.TextXAlignment = Enum.TextXAlignment.Left
		readout.Parent = row

		local track = Instance.new("TextButton")
		track.Text = ""
		track.AutoButtonColor = false
		track.Position = UDim2.new(0, 0, 0, 22)
		track.Size = UDim2.new(1, 0, 0, 10)
		track.BackgroundColor3 = Color3.fromRGB(40, 30, 0)
		track.BorderSizePixel = 0
		track.Parent = row

		local fill = Instance.new("Frame")
		fill.BackgroundColor3 = AMBER
		fill.BorderSizePixel = 0
		fill.Parent = track

		local function render()
			local alpha = (max == min) and 0 or (value - min) / (max - min)
			fill.Size = UDim2.new(alpha, 0, 1, 0)
			readout.Text = tostring(math.floor(value * 100 + 0.5) / 100)
		end
		render()

		local function setFromX(x)
			local alpha = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
			value = min + (max - min) * alpha
			render()
			safeCall(onChange, "ui.slider", value)
		end

		local dragging = false
		track.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				setFromX(input.Position.X)
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then dragging = false end
				end)
			end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch) then
				setFromX(input.Position.X)
			end
		end)

		return {
			Instance = row,
			Get = function() return value end,
			Set = function(newValue) value = math.clamp(tonumber(newValue) or value, min, max) render() end,
		}
	end

