-- ANTIVOID: stops the void from killing/destroying you — turns off the
-- fallen-parts destroy height, keeps a platform under you far below, and
-- restores your health if it would hit 0 while you're in the void.
-- Runs once per session (running it again just reports it's already on,
-- so platforms and listeners don't pile up).
local antivoidActive = false

commands["antivoid"] = function(args)
	if antivoidActive then
		return "Antivoid is already active."
	end
	antivoidActive = true
	task.spawn(function()
		local RunService = game:GetService("RunService")
		local localPlayer = game:GetService("Players").LocalPlayer

		workspace.FallenPartsDestroyHeight = (0/0)

		workspace:GetPropertyChangedSignal("FallenPartsDestroyHeight"):Connect(function()
			local fallenPartsDestroyHeight = workspace.FallenPartsDestroyHeight

			if fallenPartsDestroyHeight == fallenPartsDestroyHeight then
				workspace.FallenPartsDestroyHeight = (0/0)
			end
		end)

		local part = Instance.new("Part", workspace)
		part.CFrame = CFrame.new(0, -10008, 0)
		part.Anchored = true
		part.Size = Vector3.new(2048, 10, 2048)
		part.Transparency = 0.5
		part.CanCollide = true
		part.Name = game:GetService("HttpService"):GenerateGUID()
		local health = 100
		local connection = nil
		local connection2 = nil

		local function fn8(arg)
			if not arg then
				return
			end
			local humanoid = arg:FindFirstChildOfClass("Humanoid") or arg:WaitForChild("Humanoid", 3)
			local humanoidRootPart = arg:FindFirstChild("HumanoidRootPart") or arg:WaitForChild("HumanoidRootPart", 3)
			if not humanoid or not humanoidRootPart then
				return
			end
			health = humanoid.Health

			if connection then
				connection:Disconnect()
				connection = nil
			end

			if connection2 then
				connection2:Disconnect()
				connection2 = nil
			end

			connection2 = RunService.RenderStepped:Connect(function()
				local humanoidRootPart2 = arg:FindFirstChild("HumanoidRootPart")

				if humanoidRootPart2 then
					health = humanoid.Health
					part.CFrame = CFrame.new(humanoidRootPart2.Position.X, -10008, humanoidRootPart2.Position.Z)
				end
			end)

			connection = humanoid.HealthChanged:Connect(function(health2)
				local humanoidRootPart2 = arg:FindFirstChild("HumanoidRootPart")

				if health2 <= 0 and humanoidRootPart2 and humanoidRootPart2.CFrame.Y <= 0 then
					humanoid.Health = health
				end
			end)
		end

		fn8(localPlayer.Character)

		localPlayer.CharacterAdded:Connect(function(character)
			task.wait(0.1)
			fn8(character)
		end)
	end)
	return "Antivoid enabled."
end

-- ULTRASONIC BRING: key 1 -> wait 1.5s -> orbit-sweep every selected
-- player (1s total, split evenly) -> flee to a fixed coordinate.
-- Selection comes from the admincheck panel, same as truecheck.
-- Key 1 goes through VirtualInputManager, which Roblox may silently
-- block outside Studio (same caveat as the key 2 / key 3 checks).
local ULTRASONIC_FLEE_POSITION = Vector3.new(-4.9, 1468.7, 25383.5)
local ultrasonicRunning = false

runUltrasonicSequence = function()
	if ultrasonicRunning then return end
	ultrasonicRunning = true

	pcall(function()
		VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.One, false, game)
		task.wait(0.05)
		VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.One, false, game)
	end)
	task.wait(1.5)

	local targetHrps = getSelectedTargetHrps()
	if #targetHrps > 0 then
		local perStep = 1 / #targetHrps -- exactly 1s total
		for _, targetHrp in ipairs(targetHrps) do
			orbitTargetBriefly(targetHrp, perStep)
		end
	end

	local char = player.Character
	if char then
		teleportFullBody(char, CFrame.new(ULTRASONIC_FLEE_POSITION))
	end

	ultrasonicRunning = false
end

