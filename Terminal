	function uiLib.animate(kind)
		local frame = target().Frame
		kind = tostring(kind or "fade"):lower()
		if kind == "fade" then
			local original = frame.BackgroundTransparency
			frame.BackgroundTransparency = 1
			TweenService:Create(frame, TweenInfo.new(0.5), { BackgroundTransparency = original }):Play()
		elseif kind == "pop" then
			local size = frame.Size
			frame.Size = UDim2.new(size.X.Scale * 0.8, size.X.Offset * 0.8, size.Y.Scale * 0.8, size.Y.Offset * 0.8)
			TweenService:Create(frame, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Size = size }):Play()
		elseif kind == "slide" then
			local position = frame.Position
			frame.Position = position + UDim2.fromOffset(0, 60)
			TweenService:Create(frame, TweenInfo.new(0.4, Enum.EasingStyle.Quad), { Position = position }):Play()
		else
			error("ui.animate: unknown animation (try fade, pop, slide)", 2)
		end
	end

