		barTitle.Text = tostring(title or "Window")
		barTitle.Parent = bar

		local closeButton = Instance.new("TextButton")
		closeButton.Size = UDim2.new(0, 22, 0, 18)
		closeButton.Position = UDim2.new(1, -26, 0, 4)
		closeButton.BackgroundColor3 = Color3.fromRGB(90, 30, 0)
		closeButton.TextColor3 = AMBER
		closeButton.Font = Enum.Font.Code
		closeButton.TextSize = 14
		closeButton.Text = "X"
		closeButton.Parent = bar

		local closeCorner = Instance.new("UICorner")
		closeCorner.CornerRadius = UDim.new(0, 4)
		closeCorner.Parent = closeButton

		local content = Instance.new("ScrollingFrame")
		content.Position = UDim2.new(0, 6, 0, 32)
		content.Size = UDim2.new(1, -12, 1, -38)
		content.BackgroundTransparency = 1
		content.BorderSizePixel = 0
		content.ScrollBarThickness = 4
		content.CanvasSize = UDim2.new(0, 0, 0, 0)
		content.AutomaticCanvasSize = Enum.AutomaticSize.Y
		content.Parent = frame

		local layout = Instance.new("UIListLayout")
		layout.Padding = UDim.new(0, 6)
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Parent = content

		local window = {
			Frame = frame, Content = content, Draggable = true,
			Minimized = false, Maximized = false,
		}

		-- drag by the title bar
		local dragging, dragStart, startPos = false, nil, nil
		bar.InputBegan:Connect(function(input)
			if window.Draggable and (input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch) then
				dragging = true
				dragStart = input.Position
				startPos = frame.Position
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
					end
				end)
			end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch) then
				local delta = input.Position - dragStart
				frame.Position = UDim2.new(
					startPos.X.Scale, startPos.X.Offset + delta.X,
					startPos.Y.Scale, startPos.Y.Offset + delta.Y
				)
			end
		end)

		function window.Close() closeWindow(window) end
		closeButton.MouseButton1Click:Connect(window.Close)

		table.insert(windows, window)
		if not keepCurrent then currentWindow = window end
		return window
	end

	local function target()
		if not currentWindow or not currentWindow.Frame.Parent then
