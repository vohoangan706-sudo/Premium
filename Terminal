	local DownButton = Instance.new("TextButton")
	DownButton.Size = UDim2.fromOffset(65, 55)
	DownButton.Position = UDim2.new(1, -150, 1, -80)
	DownButton.BackgroundColor3 = Color3.fromRGB(255, 230, 150)
	DownButton.BackgroundTransparency = 0.1
	DownButton.Text = "▼"
	DownButton.TextSize = 25
	DownButton.TextColor3 = Color3.fromRGB(50, 40, 20)
	DownButton.Font = Enum.Font.GothamBold
	DownButton.Parent = Gui

	local DownCorner = Instance.new("UICorner")
	DownCorner.CornerRadius = UDim.new(0, 14)
	DownCorner.Parent = DownButton

	UpButton.MouseButton1Down:Connect(function()
		UpHeld = true
	end)

	UpButton.MouseButton1Up:Connect(function()
		UpHeld = false
	end)

	DownButton.MouseButton1Down:Connect(function()
		DownHeld = true
	end)

	DownButton.MouseButton1Up:Connect(function()
		DownHeld = false
	end)

	UserInputService.TouchEnded:Connect(function()
		UpHeld = false
		DownHeld = false
	end)

	SpeedBox.FocusLost:Connect(function()
		local Number = tonumber(SpeedBox.Text)

		if Number and Number >= 1 then
			Speed = Number
			SpeedBox.Text = tostring(Speed)
		else
			SpeedBox.Text = tostring(Speed)
		end
	end)

	local function StartFly()
		if not Root or not Humanoid then
			return
		end

		if BodyVelocity then
			BodyVelocity:Destroy()
		end

		if BodyGyro then
			BodyGyro:Destroy()
		end

		BodyVelocity = Instance.new("BodyVelocity")
		BodyVelocity.Name = "AutoFlyVelocity"
		BodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
		BodyVelocity.P = 9000
		BodyVelocity.Velocity = Vector3.zero
		BodyVelocity.Parent = Root

		BodyGyro = Instance.new("BodyGyro")
		BodyGyro.Name = "AutoFlyGyro"
		BodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
		BodyGyro.P = 9000
		BodyGyro.D = 500
		BodyGyro.CFrame = Root.CFrame
		BodyGyro.Parent = Root

		Humanoid.AutoRotate = false

		if FlyConnection then
			FlyConnection:Disconnect()
		end

		FlyConnection = RunService.RenderStepped:Connect(function()
			if not Character
				or not Character.Parent
				or not Humanoid
				or not Root
				or not Root.Parent then
				return
			end

			local MoveDirection = Humanoid.MoveDirection
			local HorizontalVelocity = Vector3.zero

			if MoveDirection.Magnitude > 0 then
				HorizontalVelocity = MoveDirection * Speed
			end

			local VerticalVelocity = 0

			if UpHeld then
				VerticalVelocity = Speed
			elseif DownHeld then
				VerticalVelocity = -Speed
			end

			BodyVelocity.Velocity = Vector3.new(
				HorizontalVelocity.X,
				VerticalVelocity,
				HorizontalVelocity.Z
			)

			if MoveDirection.Magnitude > 0.01 then
				BodyGyro.CFrame = CFrame.lookAt(
					Root.Position,
					Root.Position + MoveDirection
				)
			end
		end)
	end

	StartFly()

	Player.CharacterAdded:Connect(function(NewCharacter)
		Character = NewCharacter

		task.wait(0.5)

		Humanoid = Character:WaitForChild("Humanoid")
		Root = Character:WaitForChild("HumanoidRootPart")

		StartFly()
	end)
end


-- Viltrumite Animation Pack (by 55Epaa) — full movement-animation
-- set, applied the same way as R6_DEFAULT_ANIMATIONS above (same
-- Animate-script slots, just different asset ids). No matching
-- Viltrumite "sit" animation exists, so that key is left out — the
-- shared applyAnimationSet helper skips any slot with no id, so sit
-- just keeps whatever was already set (the R6 default, since
-- activateGodmode's applyDefaultR6Animations already ran first).
local SUPREME_ANIMATIONS = {
	idle1 = "75641026799451", idle2 = "75641026799451",
	walk = "106987123511072",
	run = "106987123511072",
	jump = "134140909114564",
	fall = "93363225480628",
	climb = "125663362682162",
}

local function applySupremeAnimations()
	local char = player.Character
	if not char then return end

	applyAnimationSet(char, SUPREME_ANIMATIONS)

	-- The previous version gave up entirely if no Animator existed
	-- yet on the Humanoid, silently — that's the real reason it
	-- "didn't work at all": a freshly-processed Humanoid may not have
	-- an Animator child yet if the game's own Animate script hasn't
	-- created one, so `FindFirstChildOfClass("Animator")` returned nil
	-- and this whole function quietly did nothing after that point.
	-- Creating one directly if it's missing guarantees there's always
	-- something to load the animation onto, regardless of timing or
	-- whether the game uses a standard Animate script at all.
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then
		warn("The Supreme animation failed: no Humanoid found.")
		return
	end

	local animator = hum:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = hum
	end

	local animation = Instance.new("Animation")
	animation.AnimationId = "rbxassetid://" .. SUPREME_ANIMATIONS.idle1

	local ok, trackOrErr = pcall(function()
		return animator:LoadAnimation(animation)
	end)

	if not ok then
		warn("The Supreme animation failed to load:", trackOrErr)
		return
	end

	trackOrErr.Priority = Enum.AnimationPriority.Action
	trackOrErr.Looped = true
	trackOrErr:Play()
end

-------------------------------------------------
-- THE SUPREME FLOATING TEXT
-- A BillboardGui 3 studs above your head, repeatedly scrambling to
-- random characters and decoding back to the real text — "The
-- Supreme" as the big title, "Form - Purgatory" as the small
-- subtitle underneath — looping for as long as The Supreme is active.
-------------------------------------------------

local SUPREME_SCRAMBLE_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*"
local supremeBillboard = nil
local supremeTextActive = false

local function randomSupremeChar()
	local i = math.random(1, #SUPREME_SCRAMBLE_CHARS)
	return SUPREME_SCRAMBLE_CHARS:sub(i, i)
end

-- Scrambles toward the real text over `duration` seconds, leaving
-- spaces and hyphens alone so the shape of the words stays readable
-- even while scrambling.
local function scrambleSupremeText(label, finalText, duration)
	local startTime = os.clock()
	while supremeTextActive and os.clock() - startTime < duration do
		local chars = {}
		for i = 1, #finalText do
			local c = finalText:sub(i, i)
			if c == " " or c == "-" then
				chars[i] = c
			else
				chars[i] = randomSupremeChar()
			end
		end
		label.Text = table.concat(chars)
		task.wait(0.03)
	end
	if supremeTextActive then
		label.Text = finalText
	end
end

local function createSupremeBillboard(char)
	local head = char:FindFirstChild("Head")
	if not head then return nil end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "SupremeText"
	billboard.Adornee = head
	billboard.Size = UDim2.new(0, 220, 0, 60)
	billboard.StudsOffset = Vector3.new(0, 3, 0)
	billboard.AlwaysOnTop = true
	billboard.Parent = head

	local titleLabel = Instance.new("TextLabel")
	titleLabel.Name = "Title"
	titleLabel.Size = UDim2.new(1, 0, 0, 36)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Text = "The Supreme"
	titleLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
	titleLabel.Font = Enum.Font.Code
	titleLabel.TextSize = 24
	titleLabel.TextStrokeTransparency = 0
	titleLabel.Parent = billboard

	local subtitleLabel = Instance.new("TextLabel")
	subtitleLabel.Name = "Subtitle"
	subtitleLabel.Size = UDim2.new(1, 0, 0, 20)
	subtitleLabel.Position = UDim2.new(0, 0, 0, 36)
	subtitleLabel.BackgroundTransparency = 1
	subtitleLabel.Text = "Form - Purgatory"
	subtitleLabel.TextColor3 = Color3.fromRGB(255, 220, 150)
	subtitleLabel.Font = Enum.Font.Code
	subtitleLabel.TextSize = 14
	subtitleLabel.TextStrokeTransparency = 0
	subtitleLabel.Parent = billboard

	return billboard, titleLabel, subtitleLabel
end

local function startSupremeText()
	local char = player.Character
	if not char then return end

	if supremeBillboard then
		supremeBillboard:Destroy()
		supremeBillboard = nil
	end

	local billboard, titleLabel, subtitleLabel = createSupremeBillboard(char)
	if not billboard then return end

	supremeBillboard = billboard
	supremeTextActive = true

	task.spawn(function()
		while supremeTextActive and billboard.Parent do
			scrambleSupremeText(titleLabel, "The Supreme", 0.6)
			scrambleSupremeText(subtitleLabel, "Form - Purgatory", 0.5)
			if supremeTextActive then
				task.wait(2)
			end
		end
	end)
end

stopSupremeText = function()
	supremeTextActive = false
	if supremeBillboard then
		supremeBillboard:Destroy()
		supremeBillboard = nil
	end
end

