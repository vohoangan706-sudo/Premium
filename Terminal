	---------------------------------------------------------------
	-- net
	---------------------------------------------------------------
	netLib = {}
	do
		local httpRequest = request or http_request or (syn and syn.request) or nil

		local function fetch(url)
			checkPerm("network")
			url = tostring(url)
			local ok, body = pcall(function() return game:HttpGet(url) end)
			if ok then return body end
			return nil, tostring(body)
		end

		function netLib.get(url) return fetch(url) end

		function netLib.post(url, body)
			checkPerm("network")
			if not httpRequest then return nil, "net.post needs an executor with request()" end
			local payload = body
			local headers = {}
			if type(body) == "table" then
				payload = HttpService:JSONEncode(body)
				headers["Content-Type"] = "application/json"
			end
			local ok, response = pcall(httpRequest, {
				Url = tostring(url), Method = "POST", Headers = headers, Body = tostring(payload or ""),
			})
			if not ok then return nil, tostring(response) end
			return response.Body, response.StatusCode
		end

		-- saves into the virtual fs
		function netLib.download(url, path)
			local body, err = fetch(url)
			if not body then return false, err end
			path = path or tostring(url):match("([^/]+)$") or "download.bin"
			return fsLib.writeFile(path, body)
		end

		function netLib.getStatus()
			local ping = 0
			pcall(function() ping = math.floor(player:GetNetworkPing() * 2000) end)
			return { connected = true, pingMs = ping, http = (httpRequest ~= nil) or pcall(function() return game.HttpGet end) }
		end

		function netLib.getIPAddress()
			local body, err = fetch("https://api.ipify.org")
			if not body then return nil, err end
			return body
		end

		function netLib.ping(host)
			host = tostring(host)
			if not host:find("://") then host = "https://" .. host end
			local started = realOs.clock()
			local body, err = fetch(host)
			if not body then return nil, err end
			return math.floor((realOs.clock() - started) * 1000)
		end
	end

	---------------------------------------------------------------
	-- debug (the real debug library plus Aetherfinix Linux helpers)
	---------------------------------------------------------------
	debugLib = {}
	do
		local function inspect(value, depth, seen)
			depth = depth or 0
			local kind = typeof(value)
			if kind == "string" then return string.format("%q", value) end
			if kind ~= "table" then return tostring(value) end
			seen = seen or {}
			if seen[value] then return "<cycle>" end
			if depth >= 4 then return "{...}" end
			seen[value] = true
			local pad = string.rep("  ", depth + 1)
			local lines = {}
			for key, item in pairs(value) do
				table.insert(lines, pad .. "[" .. tostring(key) .. "] = " .. inspect(item, depth + 1, seen))
			end
			seen[value] = nil
			table.sort(lines)
			if #lines == 0 then return "{}" end
			return "{\n" .. table.concat(lines, ",\n") .. "\n" .. string.rep("  ", depth) .. "}"
		end

		function debugLib.inspect(value)
			local text = inspect(value)
			emit(text)
			return text
		end

		function debugLib.typeof(value) return typeof(value) end
		function debugLib.getMemory() return collectgarbage("count") end
		function debugLib.getVersion() return version() end
		function debugLib.log(...) termLib.print(...) end

		function debugLib.warn(...)
			local parts = {}
			for i = 1, select("#", ...) do parts[i] = tostring((select(i, ...))) end
			emit("[warn] " .. table.concat(parts, "\t"), Color3.fromRGB(255, 240, 90))
		end

		function debugLib.error(...)
			local parts = {}
			for i = 1, select("#", ...) do parts[i] = tostring((select(i, ...))) end
			emit("[error] " .. table.concat(parts, "\t"), RED)
		end
	end
