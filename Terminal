local themeState = { text = nil } -- set by os.theme (Aetherfinix Linux)
local linuxHooks = {}             -- filled in by the {} editor, used by Aetherfinix Linux

local function addLine(text, color)
	local line = Instance.new("TextLabel")
	line.Size = UDim2.new(1, 0, 0, 18)
	line.BackgroundTransparency = 1
	line.Text = text
	line.TextColor3 = color or Color3.fromRGB(255, 200, 0)
	if themeState.text and (not color or color == Color3.fromRGB(255, 200, 0) or color == Color3.fromRGB(255, 220, 120)) then
		line.TextColor3 = themeState.text
	end
	line.Font = Enum.Font.Code
	line.TextSize = 15
	line.TextXAlignment = Enum.TextXAlignment.Left
	line.TextWrapped = true
	line.Parent = outputFrame
	outputFrame.CanvasPosition = Vector2.new(0, math.huge)
	return line
end

local function clearConsole()
	for _, child in ipairs(outputFrame:GetChildren()) do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end
end

