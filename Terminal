------------------------------------------------------------------
-- glue core
------------------------------------------------------------------
local function zero(part)
	part.AssemblyLinearVelocity  = Vector3.zero
	part.AssemblyAngularVelocity = Vector3.zero
	pcall(function() part.Velocity    = Vector3.zero end)
	pcall(function() part.RotVelocity = Vector3.zero end)
end

local function setRep(part, value)
	if sethiddenproperty and part and part.Parent then
		pcall(function() sethiddenproperty(part, "PhysicsRepRootPart", value) end)
	end
end

local active = false
local targetId, targetName = nil, ""
local attachedMy, attachedTheir
local heartbeatConn, rotConn
local lastState
local onState = function() end

local function setState(s)
	if s ~= lastState then
		lastState = s
		onState(s)
	end
end

-- detach the physics link only (does not end the session)
local function release()
	if rotConn then rotConn:Disconnect() rotConn = nil end

	setRep(attachedMy, nil)
	setRep(attachedTheir, nil)

	if attachedMy and attachedMy.Parent then
		attachedMy.CFrame = CFrame.new(attachedMy.Position)
		zero(attachedMy)
		local hum = attachedMy.Parent:FindFirstChildOfClass("Humanoid")
		if hum then pcall(function() hum.AutoRotate = true end) end
	end

	attachedMy, attachedTheir = nil, nil
end

-- link your root part to the target's root part
local function attach(a, b, hum)
	release()
	attachedMy, attachedTheir = a, b

	if hum then
		rotConn = RunService.RenderStepped:Connect(function()
			if hum.Parent then pcall(function() hum.AutoRotate = false end) end
		end)
	end

	a.CFrame = CFrame.new(0, 0, 5)
	zero(a)
	setRep(a, a)
	setRep(a, b)
end

-- end the session completely (this is what the Stop button does)
local function stop()
	active = false
	targetId = nil
	if heartbeatConn then heartbeatConn:Disconnect() heartbeatConn = nil end
	release()
	lastState = nil
end

-- start gluing to one player and keep going until stop()
local function start(player)
	if not Selected[player.UserId] then return false end   -- selected players only

	stop()
	targetId = player.UserId
	targetName = player.DisplayName .. " (@" .. player.Name .. ")"
	active = true

	heartbeatConn = RunService.Heartbeat:Connect(function()
		if not active then return end

		local target = Players:GetPlayerByUserId(targetId)
		if not target then
			if attachedMy then release() end
			setState("Waiting for " .. targetName .. " to rejoin...")
			return
		end

		local myChar    = localPlayer.Character
		local theirChar = target.Character
		local a   = myChar    and myChar:FindFirstChild("HumanoidRootPart")
		local b   = theirChar and theirChar:FindFirstChild("HumanoidRootPart")
		local hum = myChar    and myChar:FindFirstChildOfClass("Humanoid")

		if not a then
			if attachedMy then release() end
			setState("Waiting for your character...")
			return
		end

		if not b then
			if attachedMy then release() end
			setState("Waiting for " .. targetName .. " to respawn...")
			return
		end

		if a ~= attachedMy or b ~= attachedTheir then
			attach(a, b, hum)          -- first attach, or either of you respawned
		else
			a.CFrame = CFrame.new(0, 0, 5)
			zero(a)
			setRep(a, b)
		end

		setState("Glued to " .. targetName)
	end)

	return true
end

------------------------------------------------------------------
-- name lookup: exact -> starts with -> contains (username or display name)
------------------------------------------------------------------
local function findPlayer(text)
	text = text:match("^%s*(.-)%s*$"):lower()
	if text == "" then return nil end

	local function search(test)
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= localPlayer then
				if test(p.Name:lower()) or test(p.DisplayName:lower()) then
					return p
				end
			end
		end
	end

	return search(function(n) return n == text end)
		or search(function(n) return n:sub(1, #text) == text end)
		or search(function(n) return n:find(text, 1, true) ~= nil end)
end

------------------------------------------------------------------
-- invisible (taken from the original script)
-- every Heartbeat it plays a frozen animation (71181015443030 at 13.45s,
-- huge weight) and stops it again in RenderStepped; your own body shows at 50%
------------------------------------------------------------------
local invisOn   = false
local invisBusy = false
local invisTrack
local invisBeat, invisCharConn
local dimConns = {}

local function dimPart(part)
	if not part:IsA("BasePart") then return end
	if part.Name == "HumanoidRootPart" then return end
	if part.Transparency == 1 then return end
	if part.Name:lower():find("hitbox") then return end

	part.LocalTransparencyModifier = 0.5
	table.insert(dimConns, part:GetPropertyChangedSignal("LocalTransparencyModifier"):Connect(function()
		if invisOn and part.LocalTransparencyModifier ~= 0.5 then
			part.LocalTransparencyModifier = 0.5
		end
	end))
end

local function dimCharacter(char)
	for _, d in ipairs(char:GetDescendants()) do
		dimPart(d)
	end

	table.insert(dimConns, char.DescendantAdded:Connect(function(d)
		if invisOn then dimPart(d) end
	end))
end

local function stopInvisTrack()
	if invisTrack then
		pcall(function()
			if invisTrack.IsPlaying then invisTrack:Stop() end
			invisTrack:Destroy()
		end)
		invisTrack = nil
	end
end

local function invisStep()
	if not invisOn or invisBusy then return end

	local char = localPlayer.Character
	local hum  = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local animator = hum and hum:FindFirstChildOfClass("Animator")
	if not hum or not root or not animator then return end
	if hum.Health <= 0 then return end

	invisBusy = true

	pcall(function()
		local velocity = root.Velocity

		local anim = Instance.new("Animation")
		anim.AnimationId = "rbxassetid://71181015443030"
		invisTrack = animator:LoadAnimation(anim)
		invisTrack.Priority = Enum.AnimationPriority.Action4
		invisTrack:Play()
		invisTrack:AdjustSpeed(0)
		invisTrack:AdjustWeight(2e9)
		invisTrack.TimePosition = 13.45

		RunService.RenderStepped:Wait()

		stopInvisTrack()
		root.Velocity = velocity
	end)

	invisBusy = false
end

local function setInvisible(on)
	if on == invisOn then return end
	invisOn = on

	if on then
		if localPlayer.Character then dimCharacter(localPlayer.Character) end

		invisCharConn = localPlayer.CharacterAdded:Connect(function(char)
			task.wait(0.1)
			if invisOn then dimCharacter(char) end
		end)

		invisBeat = RunService.Heartbeat:Connect(invisStep)
	else
		if invisBeat then invisBeat:Disconnect() invisBeat = nil end
		if invisCharConn then invisCharConn:Disconnect() invisCharConn = nil end

		for _, c in ipairs(dimConns) do
			pcall(function() c:Disconnect() end)
		end
		dimConns = {}

		stopInvisTrack()

		local char = localPlayer.Character
		if char then
			for _, d in ipairs(char:GetDescendants()) do
				if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
					d.LocalTransparencyModifier = 0
				end
			end
		end
	end
end

