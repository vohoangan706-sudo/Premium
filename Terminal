	resultLabel.Visible = false
	resultLabel.Parent = panelFrame

	local function setExecutorMode(on)
		inputBox.Visible = not on
		outputFrame.Visible = not on
		editorScroll.Visible = on
		runButton.Visible = on
		clearCodeButton.Visible = on
		resultLabel.Visible = on
		terminalButton.BackgroundColor3 = on and IDLE_BG or ACTIVE_BG
		executorButton.BackgroundColor3 = on and ACTIVE_BG or IDLE_BG
		if on then
			inputBox:ReleaseFocus()
		else
			codeBox:ReleaseFocus()
			outputFrame.CanvasPosition = Vector2.new(0, math.huge)
		end
	end

	setExecutorMode(false) -- terminal is the default

	terminalButton.MouseButton1Click:Connect(function()
		setExecutorMode(false)
	end)
	executorButton.MouseButton1Click:Connect(function()
		setExecutorMode(true)
	end)

	clearCodeButton.MouseButton1Click:Connect(function()
		codeBox.Text = ""
	end)

	local realPrint = print
	local realWarn = warn

	local function joinArgs(...)
		local parts = {}
		for i = 1, select("#", ...) do
			parts[i] = tostring((select(i, ...)))
		end
		return table.concat(parts, "\t")
	end

	-- writes to the full console AND the one-line strip
	local function report(text, color)
		addLine(text, color)
		resultLabel.Text = text
		resultLabel.TextColor3 = color
	end

	linuxHooks.report = report
	linuxHooks.setMode = setExecutorMode
	linuxHooks.applyEditorTheme = function(theme)
		editorScroll.BackgroundColor3 = theme.input
		lineNumbers.BackgroundColor3 = theme.gutter
		lineNumbers.TextColor3 = theme.gutterText
		codeBox.TextColor3 = theme.text
		resultLabel.TextColor3 = theme.text
	end

	local function runCode()
		local code = codeBox.Text
		if not code:match("%S") then
			report("{} nothing to run.", RED)
			return
		end

		report("{} running...", Color3.fromRGB(255, 220, 120))
		task.spawn(function()
			local ok, fn, compileErr = pcall(loadstring, code)
			if not ok then
				report("{} loadstring unavailable: " .. tostring(fn), RED)
				return
			end
			if type(fn) ~= "function" then
				report("{} compile error: " .. tostring(compileErr), RED)
				return
			end

			-- show print()/warn() in the console and the strip as well as the normal output
			pcall(function()
				local env = setmetatable({
					print = function(...)
						report(joinArgs(...), AMBER)
						realPrint(...)
					end,
					warn = function(...)
						report(joinArgs(...), Color3.fromRGB(255, 220, 120))
						realWarn(...)
					end,
				}, { __index = getfenv(fn) })
				-- extra globals from Aetherfinix Linux (os.notify, ui.button, storage...)
				if linuxHooks.globals then
					for name, value in pairs(linuxHooks.globals) do
						env[name] = value
					end
				end
				setfenv(fn, env)
			end)

			local runOk, runErr = pcall(fn)
			if runOk then
				report("{} done.", Color3.fromRGB(150, 255, 150))
			else
				report("{} error: " .. tostring(runErr), RED)
			end
		end)
	end

	runButton.MouseButton1Click:Connect(runCode)
end

-------------------------------------------------
-- SHARED HELPERS
-- Own copies, independent of the main TerminalPanel script — this
-- script can't reach into another script's locals, so the void
-- platform/loop/toggle mechanics are duplicated here rather than
-- shared. Functionally identical to the main script's versions.
-------------------------------------------------

local function createToggle(signal, onTick, onStart, onStop)
	local connection = nil
	local function isOn()
		return connection ~= nil
	end
	local function turnOn()
		if connection then return end
		if onStart then onStart() end
		connection = signal:Connect(onTick)
	end
	local function turnOff()
		if not connection then return end
		connection:Disconnect()
		connection = nil
		if onStop then onStop() end
	end
	return turnOn, turnOff, isOn
end

local VOID_POSITION = Vector3.new(0, -500, 0)
local VOID_PLATFORM_SIZE = Vector3.new(4000, 0.5, 4000)
local voidPlatform = nil

local function createVoidPlatform()
	if voidPlatform then return voidPlatform end

	local platform = Instance.new("Part")
	platform.Name = "VoidPlatformPremium"
	platform.Size = VOID_PLATFORM_SIZE
	platform.Position = VOID_POSITION - Vector3.new(0, VOID_PLATFORM_SIZE.Y / 2, 0)
	platform.Anchored = true
