local function parseCommand(rawText)
	local parts = rawText:split(" ")
	local cmdName = (parts[1] or ""):lower()
	table.remove(parts, 1)
	return cmdName, parts
end

local function runCommand(cmdName, args)
	local fn = commands[cmdName]
	if fn then
		local ok, result = pcall(fn, args)
		if ok then
			return result or "Done."
		else
			return "Error: " .. tostring(result)
		end
	else
		return "Unknown command: '" .. cmdName .. "'. Type 'help' for a list."
	end
end

local processing = false

inputBox.FocusLost:Connect(function(enterPressed)
	if not enterPressed then return end
	local text = inputBox.Text
	if processing or text == "" then
		inputBox.Text = ""
		return
	end

	processing = true
	inputBox.Text = ""
	inputBox.TextEditable = false

	local cmdName, args = parseCommand(text)
	addLine("$ " .. text, Color3.fromRGB(255, 220, 120))

	local result = runCommand(cmdName, args)
	if type(result) == "table" then
		for _, resultText in ipairs(result) do
			addLine(resultText, Color3.fromRGB(255, 200, 0))
		end
	else
		addLine(result, Color3.fromRGB(255, 200, 0))
	end

	inputBox.TextEditable = true
	processing = false
	inputBox:CaptureFocus()
end)

