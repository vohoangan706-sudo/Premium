-- ======================================================================
--  Return by Death  (standalone package for the Aetherfinix panel)
--  Host this file (raw URL) and put the URL in the panel's
--  PACKAGE_URLS.returnbydeath slot. Then type:  returnbydeath
--  Running this file by itself does nothing: the panel loads it.
--
--  returnbydeath [on|off] | status | reset | forgive <player> | hold <seconds>
--  Health hits 0 -> you are sent to the void (Y = -5000); when you respawn
--  you are put back where you died with a sound and a revive animation.
--
--  It also LEARNS from every death (the adapt system is part of this command,
--  not a separate one). It works out what killed you (void, fall, kill-part,
--  damage, one-shot, unknown), counts deaths (saved to AetherAdapt.json when
--  the executor has writefile) and builds a defence from then on:
--    void kill -> antivoid is turned on + rescue back to your last safe spot
--    fall      -> soft landings
--    kill part -> every part with that name is deleted (on your client)
--    damage    -> retreat when you lose health fast
--    a player kills you -> you avoid that player from then on (vanish when they get close)
--  After 10 deaths it also PREDICTS attacks (teleports to 9e9 for 1 s when an attack is about to land,
--  brakes at void edges).
--  The reset button still works and isn't counted as a death.
-- ======================================================================
local context = ...
if type(context) ~= "table" then
	warn("Return by Death must be loaded by the Aetherfinix panel.")
	return
end

local player = context.player
local commands = context.commands
local registerPackage = context.registerPackage
local screenGui = context.screenGui

local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local StarterGui = game:GetService("StarterGui")
local Players = game:GetService("Players")

local SAVE_FILE = "AetherAdapt.json"
local KILLER_GUESS_RADIUS = 10 -- no kill tag: only a player this close (studs) counts as your killer
local PREDICT_AFTER = 10 -- deaths before the attack-prediction system switches on

local enabled = false
local data = nil
local connections = {}
local charConnections = {}
local MAX_DELETE_SIZE = 300 -- never delete a part bigger than this (floors, baseplates, walls)
local resetEvent = nil
local resetPressed = false
local godmodeOffered = false

local function freshData()
	return { deaths = 0, resets = 0, causes = {}, parts = {}, killers = {}, weapons = {}, avoid = {}, kd = { sum = 0, n = 0 }, log = {} }
end
data = freshData()

local function count(cause) return data.causes[cause] or 0 end
local function predicting() return data.deaths >= PREDICT_AFTER end

-- body part names are never "kill parts" (a player's arm touching you is not a trap)
local BODY_NAMES = {}
for _, name in ipairs({ "Head", "Torso", "UpperTorso", "LowerTorso", "HumanoidRootPart", "Left Arm", "Right Arm", "Left Leg", "Right Leg",
	"LeftUpperArm", "LeftLowerArm", "LeftHand", "RightUpperArm", "RightLowerArm", "RightHand",
	"LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "RightUpperLeg", "RightLowerLeg", "RightFoot", "Handle" }) do
	BODY_NAMES[name] = true
end

local function purgeBodyNames()
	for name in pairs(BODY_NAMES) do data.parts[name] = nil end
end

local function save()
	if type(writefile) ~= "function" then return end
	pcall(function() writefile(SAVE_FILE, HttpService:JSONEncode(data)) end)
end

local function load()
	if type(readfile) ~= "function" or type(isfile) ~= "function" then return end
	pcall(function()
		if not isfile(SAVE_FILE) then return end
		local d = HttpService:JSONDecode(readfile(SAVE_FILE))
		if type(d) ~= "table" then return end
		data.deaths = tonumber(d.deaths) or 0
		data.resets = tonumber(d.resets) or 0
		for _, key in ipairs({ "causes", "parts", "killers", "weapons", "avoid", "kd", "log" }) do
			if type(d[key]) == "table" then data[key] = d[key] end
		end
		purgeBodyNames() -- older saves could contain 'Right Arm' etc.
		data.hold = tonumber(d.hold)
		data.kd.sum = tonumber(data.kd.sum) or 0
		data.kd.n = tonumber(data.kd.n) or 0
	end)
end

local function clearCharConnections()
	for _, c in ipairs(charConnections) do c:Disconnect() end
	charConnections = {}
end

-- the Humanoid model (a player or an NPC) a part belongs to, or nil
local function characterOf(inst)
	local model = inst:FindFirstAncestorOfClass("Model")
	while model do
		if model:FindFirstChildOfClass("Humanoid") then return model end
		model = model.Parent and model.Parent:FindFirstAncestorOfClass("Model") or nil
	end
	return nil
end

local function consider(inst)
	if inst:IsA("BasePart") and data.parts[inst.Name] and not BODY_NAMES[inst.Name] and not characterOf(inst)
		and inst.Size.Magnitude <= MAX_DELETE_SIZE then
		pcall(function() inst:Destroy() end) -- deleted on your client only
	end
end

local function scanWorkspace()
	task.spawn(function()
		local n = 0
		for _, d in ipairs(workspace:GetDescendants()) do
			if not enabled then return end
			consider(d)
			n = n + 1
			if n % 1500 == 0 then task.wait() end
		end
	end)
end

local function turnOnAntivoid()
	if commands["antivoid"] then pcall(commands["antivoid"], {}) end
end

-- other characters (players and NPCs) with a Humanoid within `radius` of `pos`
local function threatsNear(pos, radius, ownChar)
	local found, seen = {}, {}
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { ownChar }
	local ok, parts = pcall(function() return workspace:GetPartBoundsInRadius(pos, radius, params) end)
	if not ok then return found end
	for _, part in ipairs(parts) do
		local model = part:FindFirstAncestorOfClass("Model")
		if model and not seen[model] then
			seen[model] = true
			local hum = model:FindFirstChildOfClass("Humanoid")
			local r = model:FindFirstChild("HumanoidRootPart")
			if hum and r and hum.Health > 0 then
				table.insert(found, { model = model, root = r, dist = (r.Position - pos).Magnitude })
			end
		end
	end
	return found
end

local function record(cause, detail)
	data.deaths = data.deaths + 1
	data.causes[cause] = count(cause) + 1
	table.insert(data.log, { os.time(), cause, detail or "" })
	while #data.log > 12 do table.remove(data.log, 1) end
	save()
	if cause == "void" then turnOnAntivoid() end
	-- health-based deaths can't be stopped from the client: offer the real godmode once
	local unguardable = count("damage") + count("oneshot") + count("unknown")
	if unguardable >= 3 and not godmodeOffered and commands["godmode"] then
		godmodeOffered = true
		pcall(commands["godmode"], {})
	end
end

local function watchCharacter(char)
	clearCharConnections()
	local hum = char:WaitForChild("Humanoid", 5)
	local root = char:WaitForChild("HumanoidRootPart", 5)
	if not (enabled and hum and root) then return end

	local hist, safe = {}, {}
	local classified = false
	local lastTouch = nil
	local lastSample, lastEvade, lastThreat, lastDodge = 0, 0, 0, 0
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = { char }

	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") then
			table.insert(charConnections, part.Touched:Connect(function(other)
				if other:IsDescendantOf(char) or other:IsA("Terrain") then return end
				lastTouch = { part = other, time = os.clock(), owner = characterOf(other) }
			end))
		end
	end

	-- an attack is about to land: hold the character at 9e9 (Heartbeat + Stepped, anchored so nothing
	-- pulls it back) for the hold time, then bring it back. The hold time is 1 s unless you set
	-- `returnbydeath hold <seconds>`
	local vanished = false
	local function vanish(fromPos)
		if vanished then return false end
		vanished = true
		local origin = root.CFrame
		-- come back ~30 studs further from whoever you are avoiding (if there is ground there)
		if fromPos then
			local flat = Vector3.new(origin.Position.X - fromPos.X, 0, origin.Position.Z - fromPos.Z)
			if flat.Magnitude > 0.1 then
				local target = origin.Position + flat.Unit * 30
				if workspace:Raycast(target + Vector3.new(0, 5, 0), Vector3.new(0, -40, 0), rayParams) then
					origin = origin - origin.Position + target + Vector3.new(0, 3, 0)
				end
			end
		end
		local far = CFrame.new(9e9, 9e9, 9e9)
		local holdTime = data.hold or 1
		local wasAnchored = root.Anchored
		local started = os.clock()
		local conns = {}
		local function stop()
			for _, c in ipairs(conns) do c:Disconnect() end
			vanished = false
		end
		local function hold()
			if not root.Parent or hum.Health <= 0 then
				stop()
				return false
			end
			root.CFrame = far
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
			return true
		end
		root.Anchored = true
		table.insert(conns, RunService.Stepped:Connect(function()
			if vanished then hold() end
		end))
		table.insert(conns, RunService.Heartbeat:Connect(function()
			if not vanished then return end
			if os.clock() - started < holdTime then
				hold()
			else
				stop()
				root.Anchored = wasAnchored
				root.CFrame = origin
				root.AssemblyLinearVelocity = Vector3.zero
			end
		end))
		for _, c in ipairs(conns) do table.insert(charConnections, c) end
		return true
	end

	local function classify()
		if classified then return end
		classified = true
		if resetPressed then
			data.resets = data.resets + 1
			save()
			return
		end
		local last = hist[#hist]
		local pos = last and last.pos or root.Position
		local now = os.clock()

		if pos.Y < -350 then
			record("void", "fell below the map")
			return
		end
		local minVy = 0
		for _, s in ipairs(hist) do
			if now - s.t < 0.5 and s.vy < minVy then minVy = s.vy end
		end
		if minVy <= -60 then
			record("fall", "landing speed " .. math.floor(-minVy))
			return
		end
		if lastTouch and now - lastTouch.time < 0.5 and lastTouch.part.Parent and not lastTouch.owner
			and not BODY_NAMES[lastTouch.part.Name] then
			local name = lastTouch.part.Name
			data.parts[name] = (data.parts[name] or 0) + 1
			record("touch", name)
			scanWorkspace()
			return
		end

		-- who (or what) was next to you: remember the name, the distance and its weapon
		local killerName = ""
		local nearest, bestDist = nil, 40
		for _, threat in ipairs(threatsNear(pos, 40, char)) do
			if threat.dist < bestDist then nearest, bestDist = threat, threat.dist end
		end
		if nearest then
			killerName = nearest.model.Name
			data.killers[killerName] = (data.killers[killerName] or 0) + 1
			data.kd.sum = data.kd.sum + bestDist
			data.kd.n = data.kd.n + 1
			local tool = nearest.model:FindFirstChildOfClass("Tool")
			if tool then data.weapons[tool.Name] = (data.weapons[tool.Name] or 0) + 1 end
		end
		-- a player killed you: the kill tag if the game sets one, else the nearest player within KILLER_GUESS_RADIUS -> avoid them from now on
		local killerPlayer = nil
		local tag = hum:FindFirstChild("creator")
		if tag and typeof(tag.Value) == "Instance" and tag.Value:IsA("Player") and tag.Value ~= player then
			killerPlayer = tag.Value
		elseif lastTouch and lastTouch.owner and now - lastTouch.time < 1 and Players:GetPlayerFromCharacter(lastTouch.owner)
			and Players:GetPlayerFromCharacter(lastTouch.owner) ~= player then
			killerPlayer = Players:GetPlayerFromCharacter(lastTouch.owner)
		elseif nearest and bestDist <= KILLER_GUESS_RADIUS then
			local p = Players:GetPlayerFromCharacter(nearest.model)
			if p and p ~= player then killerPlayer = p end
		end
		if killerPlayer then
			if killerPlayer.Name ~= killerName then
				data.killers[killerPlayer.Name] = (data.killers[killerPlayer.Name] or 0) + 1
			end
			killerName = killerPlayer.Name
			data.avoid[killerName] = true
		end
		if last and last.h >= hum.MaxHealth * 0.75 then
			record("oneshot", killerName)
		elseif hist[1] and last and hist[1].h > last.h + 0.5 then
			record("damage", killerName)
		else
			record("unknown", killerName)
		end
	end

	table.insert(charConnections, hum.Died:Connect(classify))
	table.insert(charConnections, hum.HealthChanged:Connect(function(h)
		if h <= 0 then classify() end
	end))

	table.insert(charConnections, RunService.Heartbeat:Connect(function()
		if hum.Health <= 0 or not root.Parent or vanished then return end
		local now = os.clock()
		local vel = root.AssemblyLinearVelocity
		local pos = root.Position

		table.insert(hist, { t = now, h = hum.Health, vy = vel.Y, pos = pos })
		while #hist > 0 and now - hist[1].t > 1.5 do table.remove(hist, 1) end

		if now - lastSample >= 0.25 then
			lastSample = now
			if hum.FloorMaterial ~= Enum.Material.Air and pos.Y > -300 then
				table.insert(safe, { t = now, cf = root.CFrame })
				while #safe > 16 do table.remove(safe, 1) end
			end
		end

		-- defence: void
		if count("void") > 0 and pos.Y < -380 and safe[#safe] then
			root.CFrame = safe[#safe].cf + Vector3.new(0, 3, 0)
			root.AssemblyLinearVelocity = Vector3.zero
			return
		end

		-- defence: hard landing
		if count("fall") > 0 and vel.Y < -45 then
			local hit = workspace:Raycast(pos, Vector3.new(0, -(-vel.Y * 0.1 + 5), 0), rayParams)
			if hit then root.AssemblyLinearVelocity = Vector3.new(vel.X, 0, vel.Z) end
		end

		-- defence: losing health fast -> jump back to where you were a few seconds ago
		if count("damage") + count("oneshot") + count("unknown") > 0 and now - lastEvade > 3 and hist[1] and safe[1]
			and hist[1].h - hum.Health >= hum.MaxHealth * 0.3 and hum.Health < hum.MaxHealth * 0.6 then
			lastEvade = now
			root.CFrame = safe[1].cf
			root.AssemblyLinearVelocity = Vector3.zero
		end

		-- AVOID: players who killed you are kept away from you right away (no need to wait for 10 deaths)
		-- PREDICTION 1 (after 10 deaths): anything that has hurt you before and is closing in -> vanish before it lands a hit
		if now - lastThreat >= 0.1 and (next(data.avoid) ~= nil or predicting()) then
			lastThreat = now
			local radius = 14
			if data.kd.n > 0 then radius = math.clamp(data.kd.sum / data.kd.n * 1.2, 8, 25) end
			local hasKnown = next(data.killers) ~= nil
			for _, threat in ipairs(threatsNear(pos, 45, char)) do
				local owner = Players:GetPlayerFromCharacter(threat.model)
				if owner and data.avoid[owner.Name] then
					if threat.dist < 30 and now - lastDodge > 1.2 then
						if vanish(threat.root.Position) then lastDodge = now + 1 end
						break
					end
				elseif predicting() then
					local tool = threat.model:FindFirstChildOfClass("Tool")
					local known = data.killers[threat.model.Name] ~= nil or (tool ~= nil and data.weapons[tool.Name] ~= nil)
					if known or not hasKnown then
						local rel = threat.root.Position - pos
						local tvel = threat.root.AssemblyLinearVelocity
						local closing = rel.Magnitude > 0.1 and -rel:Dot(tvel) / rel.Magnitude or 0
						local futureDist = (rel + tvel * 0.5).Magnitude
						if closing > 8 and futureDist < radius and now - lastDodge > 1.2 then
							if vanish(threat.root.Position) then lastDodge = now + 1 end
							break
						end
					end
				end
			end
		end

		if not predicting() then return end

		-- PREDICTION 2: running off an edge into the void -> brake before you leave the ground
		if count("void") > 0 and hum.FloorMaterial ~= Enum.Material.Air and vel.Magnitude > 6 then
			local flat = Vector3.new(vel.X, 0, vel.Z)
			if flat.Magnitude > 6 then
				local ahead = pos + flat.Unit * math.max(flat.Magnitude * 0.35, 5)
				local hit = workspace:Raycast(ahead, Vector3.new(0, -300, 0), rayParams)
				if not hit then root.AssemblyLinearVelocity = Vector3.new(0, vel.Y, 0) end
			end
		end
	end))
end

local function hookReset()
	pcall(function()
		resetEvent = Instance.new("BindableEvent")
		table.insert(connections, resetEvent.Event:Connect(function()
			resetPressed = true
			task.delay(3, function() resetPressed = false end)
			local char = player.Character
			if char then
				pcall(function()
					local h = char:FindFirstChildOfClass("Humanoid")
					if h then h.Health = 0 end
					char:BreakJoints()
				end)
			end
		end))
		StarterGui:SetCore("ResetButtonCallback", resetEvent)
	end)
end

local function adaptOn()
	if enabled then return end
	enabled = true
	load()
	purgeBodyNames()
	if count("void") > 0 then turnOnAntivoid() end
	hookReset()
	table.insert(connections, workspace.DescendantAdded:Connect(consider))
	table.insert(connections, player.CharacterAdded:Connect(function(char) task.spawn(watchCharacter, char) end))
	if player.Character then task.spawn(watchCharacter, player.Character) end
	scanWorkspace()
end

local function adaptOff()
	if not enabled then return end
	enabled = false
	for _, c in ipairs(connections) do c:Disconnect() end
	connections = {}
	clearCharConnections()
	pcall(function() StarterGui:SetCore("ResetButtonCallback", true) end)
	if resetEvent then resetEvent:Destroy() resetEvent = nil end
end

local function joinKeys(tbl, withCounts)
	local list = {}
	for name, n in pairs(tbl) do
		table.insert(list, withCounts and (name .. " x" .. n) or name)
	end
	return table.concat(list, ", ")
end

local function statusLines()
	local lines = { "Adapt is " .. (enabled and "ON" or "OFF") .. ".", "Deaths: " .. data.deaths .. "   Resets: " .. data.resets }
	local parts = {}
	for _, cause in ipairs({ "void", "fall", "touch", "oneshot", "damage", "unknown" }) do
		if count(cause) > 0 then table.insert(parts, cause .. " x" .. count(cause)) end
	end
	table.insert(lines, "Causes: " .. (#parts > 0 and table.concat(parts, ", ") or "none yet"))

	local defences = {}
	if count("void") > 0 then table.insert(defences, "antivoid + void rescue") end
	if count("fall") > 0 then table.insert(defences, "soft landing") end
	if next(data.parts) ~= nil then table.insert(defences, "deleting kill parts (" .. joinKeys(data.parts, false) .. ")") end
	if count("damage") + count("oneshot") + count("unknown") > 0 then table.insert(defences, "health-drop retreat") end
	table.insert(lines, "Defences: " .. (#defences > 0 and table.concat(defences, ", ") or "none yet"))

	if predicting() then
		table.insert(lines, "Attack prediction: ACTIVE (vanishes to 9e9 for 1 s when an attack is about to land, brakes at void edges)")
	else
		table.insert(lines, "Attack prediction: switches on after " .. PREDICT_AFTER .. " deaths (" .. (PREDICT_AFTER - data.deaths) .. " to go)")
	end
	if next(data.avoid) ~= nil then table.insert(lines, "Avoiding players (they killed you): " .. joinKeys(data.avoid, false)) end
	if next(data.killers) ~= nil then table.insert(lines, "Seen near your deaths: " .. joinKeys(data.killers, true)) end
	if next(data.weapons) ~= nil then table.insert(lines, "Weapons seen: " .. joinKeys(data.weapons, true)) end

	for i = math.max(1, #data.log - 4), #data.log do
		local e = data.log[i]
		if type(e) == "table" then
			table.insert(lines, "  - " .. tostring(e[2]) .. ((e[3] and e[3] ~= "") and (" (" .. tostring(e[3]) .. ")") or ""))
		end
	end
	return lines
end

-- `returnbydeath status` / `returnbydeath reset` use these
local function adaptCommand(sub, arg)
	if sub == "status" or sub == "deaths" then
		if not enabled and data.deaths == 0 then load() end
		return statusLines()
	elseif sub == "hold" then
		local seconds = tonumber(arg)
		if not seconds then return "Usage: returnbydeath hold <seconds>  (how long you stay at 9e9 when avoiding an attack; now " .. tostring(data.hold or 1) .. ")" end
		data.hold = math.clamp(seconds, 0.1, 1e9)
		save()
		return "You will now stay at 9e9 for " .. data.hold .. " s when avoiding an attack."
	elseif sub == "forgive" then
		local wanted = tostring(arg or ""):lower()
		for name in pairs(data.avoid) do
			if name:lower() == wanted then
				data.avoid[name] = nil
				save()
				return "No longer avoiding " .. name .. "."
			end
		end
		return "Usage: returnbydeath forgive <player name>  (not avoiding anyone by that name)"
	elseif sub == "reset" then
		data = freshData()
		godmodeOffered = false
		save()
		return "Adapt memory cleared."
	end
end

-- ######################################################################
-- #  RETURNBYDEATH  (the `returnbydeath` command)
-- #  returnbydeath [on|off]   toggles it
-- #  When your health hits 0 you are sent to the void (Y = -5000). When you
-- #  respawn you are teleported back to the spot where you died, a sound plays,
-- #  and your body parts fly together into your torso like a revival.
-- #  The fly-together animation and the sound are on your screen only.
-- #  All locals live inside this do-block (no top-level locals added).
-- ######################################################################
do
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local SoundService = game:GetService("SoundService")
	local TweenService = game:GetService("TweenService")

	local VOID_Y = -5000
	local SOUND_ID = "rbxassetid://139203439169314"
	local ANIM_TIME = 1.1 -- seconds for the body parts to fly together
	local rng = Random.new()

	local enabled = false
	local connections = {} -- while the command is on
	local charConnections = {} -- for the current character only
	local deathCFrame = nil -- where you died, until you respawn
	local lastSafe = nil -- the last place you stood alive, not in the void
	local handled = false -- this character's death was already handled
	local fx = nil -- the revive animation that is running (nil = none)

	local function clearCharConnections()
		for _, c in ipairs(charConnections) do c:Disconnect() end
		charConnections = {}
	end

	local function stopFx()
		local a = fx
		if not a then return end
		fx = nil
		if a.heartbeat then a.heartbeat:Disconnect() end
		for _, item in ipairs(a.items) do
			if item.part.Parent then item.part.LocalTransparencyModifier = 0 end
		end
		if a.root and a.root.Parent then a.root.Anchored = a.wasAnchored end
		if a.folder then a.folder:Destroy() end
	end

	local function flash()
		local gui = Instance.new("ScreenGui")
		gui.Name = "AetherReviveFlash"
		gui.ResetOnSpawn = false
		gui.IgnoreGuiInset = true
		gui.DisplayOrder = 95
		gui.Parent = screenGui.Parent
		local frame = Instance.new("Frame")
		frame.Size = UDim2.new(1, 0, 1, 0)
		frame.BackgroundColor3 = Color3.new(1, 1, 1)
		frame.BackgroundTransparency = 0.25
		frame.BorderSizePixel = 0
		frame.Active = false
		frame.Parent = gui
		TweenService:Create(frame, TweenInfo.new(0.6), { BackgroundTransparency = 1 }):Play()
		task.delay(0.7, function() gui:Destroy() end)
	end

	local function playSound()
		local sound = Instance.new("Sound")
		sound.SoundId = SOUND_ID
		sound.Volume = 1
		sound.Parent = SoundService
		sound:Play()
		sound.Ended:Connect(function() sound:Destroy() end)
		task.delay(15, function()
			if sound.Parent then sound:Destroy() end
		end)
	end

	-- the revive animation: scattered copies of your body parts fly into place, then a white flash
	local function playRevive(char)
		stopFx()
		local root = char:FindFirstChild("HumanoidRootPart")
		if not root then return end

		local a = { items = {}, root = root, wasAnchored = root.Anchored, born = os.clock() }
		a.folder = Instance.new("Folder")
		a.folder.Name = "ReturnByDeathFx"
		a.folder.Parent = workspace
		fx = a

		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") and part ~= root and part.Transparency < 1 then
				local copy = part:Clone()
				if copy then
					for _, child in ipairs(copy:GetChildren()) do
						if child:IsA("JointInstance") or child:IsA("WeldConstraint") or child:IsA("LuaSourceContainer")
							or child:IsA("Attachment") or child:IsA("ParticleEmitter") or child:IsA("Trail")
							or child:IsA("Beam") or child:IsA("Sound") or child:IsA("BillboardGui") then
							child:Destroy()
						end
					end
					copy.Anchored = true
					copy.CanCollide = false
					copy.CanTouch = false
					copy.CanQuery = false
					copy.CastShadow = false
					local direction = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-0.3, 1), rng:NextNumber(-1, 1))
					if direction.Magnitude < 0.1 then direction = Vector3.new(0, 1, 0) end
					local start = part.CFrame * CFrame.new(direction.Unit * rng:NextNumber(6, 14))
						* CFrame.Angles(rng:NextNumber(-3, 3), rng:NextNumber(-3, 3), rng:NextNumber(-3, 3))
					copy.CFrame = start
					copy.Parent = a.folder
					part.LocalTransparencyModifier = 1
					table.insert(a.items, { copy = copy, part = part, start = start })
				end
			end
		end

		root.Anchored = true -- hold still while the parts come together
		a.heartbeat = RunService.Heartbeat:Connect(function()
			if fx ~= a then return end
			local t = (os.clock() - a.born) / ANIM_TIME
			if t >= 1 then
				stopFx()
				flash()
				return
			end
			local eased = t < 0.5 and 2 * t * t or 1 - (-2 * t + 2) ^ 2 / 2
			for _, item in ipairs(a.items) do
				if item.part.Parent and item.copy.Parent then
					item.copy.CFrame = item.start:Lerp(item.part.CFrame, eased)
				end
			end
		end)
	end

	-- health hit 0: remember the spot, then send the body to the void
	local function onDeath(root)
		if handled then return end
		handled = true
		local spot = root.CFrame
		-- if you died by falling into the void, return to the last place you stood instead
		if spot.Position.Y < workspace.FallenPartsDestroyHeight + 50 then
			turnOnAntivoid() -- killed by the void: antivoid on
			if lastSafe then spot = lastSafe end
		end
		deathCFrame = spot
		pcall(function()
			root.CFrame = CFrame.new(spot.Position.X, VOID_Y, spot.Position.Z)
			root.AssemblyLinearVelocity = Vector3.zero
		end)
	end

	local function watchCharacter(char)
		clearCharConnections()
		handled = false
		local humanoid = char:WaitForChild("Humanoid", 5)
		local root = char:WaitForChild("HumanoidRootPart", 5)
		if not (enabled and humanoid and root) then return end

		local function check()
			if humanoid.Health <= 0 then onDeath(root) end
		end
		table.insert(charConnections, humanoid.HealthChanged:Connect(check))
		table.insert(charConnections, humanoid.Died:Connect(check))
		table.insert(charConnections, RunService.Heartbeat:Connect(function()
			if humanoid.Health > 0 and root.Parent and root.Position.Y > workspace.FallenPartsDestroyHeight + 100 then
				lastSafe = root.CFrame
			end
		end))
		check()
	end

	local function onCharacterAdded(char)
		task.spawn(watchCharacter, char)
		if not deathCFrame then return end
		local target = deathCFrame
		deathCFrame = nil
		task.spawn(function()
			local root = char:WaitForChild("HumanoidRootPart", 5)
			if not root then return end
			task.wait(0.25) -- let the game finish putting you at its spawn point
			if not (enabled and char.Parent) then return end
			root.CFrame = target
			root.AssemblyLinearVelocity = Vector3.zero
			playSound()
			playRevive(char)
			task.wait(0.4)
			-- if the game moved you again while loading, put you back
			if enabled and char.Parent and root.Parent and (root.Position - target.Position).Magnitude > 15 then
				root.CFrame = target
			end
		end)
	end

	local function turnOn()
		if enabled then return end
		enabled = true
		deathCFrame = nil
		adaptOn()
		table.insert(connections, player.CharacterAdded:Connect(onCharacterAdded))
		if player.Character then task.spawn(watchCharacter, player.Character) end
	end

	local function turnOff()
		if not enabled then return end
		enabled = false
		adaptOff()
		for _, c in ipairs(connections) do c:Disconnect() end
		connections = {}
		clearCharConnections()
		stopFx()
		deathCFrame = nil
	end

	commands["returnbydeath"] = function(args)
		local sub = tostring(args[1] or ""):lower()
		if sub == "" then sub = enabled and "off" or "on" end
		if sub == "on" then
			if enabled then return "Return by Death is already on." end
			turnOn()
			return "Return by Death on: if your health hits 0 you go to the void, then come back to where you died when you respawn. It also learns from every death (see 'returnbydeath status'). 'returnbydeath off' turns it off."
		elseif sub == "off" then
			if not enabled then return "Return by Death is already off." end
			turnOff()
			return "Return by Death off. What it learned is kept."
		end
		local result = adaptCommand(sub, args[2])
		if result then
			if type(result) == "table" then
				table.insert(result, 1, "Return by Death is " .. (enabled and "ON" or "OFF") .. ".")
			end
			return result
		end
		return "Usage: returnbydeath [on|off] | status | reset | forgive <player> | hold <seconds>"
	end

	-- used by `shutdown`
	commands["__returnbydeath_off"] = turnOff
end

registerPackage("returnbydeath", function()
	return commands["returnbydeath"]({ "on" })
end, function()
	return commands["returnbydeath"]({ "off" })
end)