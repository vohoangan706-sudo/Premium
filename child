local rows = {}   -- [UserId] = button

local function countSelected()
	local n = 0
	for uid in pairs(Selected) do
		if Players:GetPlayerByUserId(uid) then n += 1 end
	end
	selectedLabel.Text = "Selected: " .. n
end

local function paintRow(btn, on)
	btn.BackgroundColor3 = on and FILL_ON or ROW
	btn.TextColor3 = on and BG or GOLD
end

local function addRow(p)
	if p == me or rows[p.UserId] then return end
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, -4, 0, 32)
	b.BackgroundColor3 = ROW
	b.BorderSizePixel = 0
	b.Font, b.TextSize, b.TextColor3 = FONT, 14, GOLD
	b.Text = p.Name
	b.LayoutOrder = #rows + 1
	b.Parent = list
	paintRow(b, Selected[p.UserId])

	b.MouseButton1Click:Connect(function()
		if Selected[p.UserId] then Selected[p.UserId] = nil else Selected[p.UserId] = true end
		paintRow(b, Selected[p.UserId])
		countSelected()
	end)
	rows[p.UserId] = b
end

for _, p in ipairs(Players:GetPlayers()) do addRow(p) end
countSelected()

local addConn = Players.PlayerAdded:Connect(addRow)
local remConn = Players.PlayerRemoving:Connect(function(p)
	local b = rows[p.UserId]
	if b then b:Destroy() rows[p.UserId] = nil end
	Selected[p.UserId] = nil
	task.defer(countSelected)
end)

voidBtn.MouseButton1Click:Connect(function()
	if busy then return end
	task.spawn(childEmperorVoid)
end)

task.spawn(function()
	while gui.Parent do
		voidBtn.BackgroundColor3 = busy and FILL_ON or FILL
		voidBtn.TextColor3 = busy and BG or GOLD
		task.wait(0.2)
	end
end)

getgenv().ChildEmperorStop = function()
	if addConn then addConn:Disconnect() addConn = nil end
	if remConn then remConn:Disconnect() remConn = nil end
	setAntivoid(false)
	for _, pl in pairs(platforms) do pcall(function() pl:Destroy() end) end
	gui:Destroy()
end

closeBtn.MouseButton1Click:Connect(function()
	getgenv().ChildEmperorStop()
end)