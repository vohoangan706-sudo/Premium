--[[
  VOID KILL panel  -  one button: "Child emperor void"   (the Duel farm function, once per press)
  Tap players in the list to select them ("Selected: N", saved in getgenv().SelectedPlayers as [UserId] = true).
  Press "Child emperor void" and it runs the duel void ONCE on the selected players:
    antivoid turns on  >  wait for slot 3 to be off cooldown  >  press 3  >  wait 0.4s  >
    glue (PhysicsRepRootPart) to the selected players for exactly 0.7s in total (split evenly)  >
    anchored at -501y for 0.3s  >  anchored at -10000y for 3s  >  teleport to -500y.
  Press it again for another run. The x closes the panel and turns antivoid off.
]]

if getgenv().ChildEmperorStop then pcall(getgenv().ChildEmperorStop) end

local Players    = game:GetService("Players")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local VIM        = game:GetService("VirtualInputManager")
local me         = Players.LocalPlayer

getgenv().SelectedPlayers = getgenv().SelectedPlayers or {}
local Selected = getgenv().SelectedPlayers

local function root(c) return c and c:FindFirstChild("HumanoidRootPart") end
local function hum(c)  return c and c:FindFirstChildOfClass("Humanoid") end

local function zero(p)
	p.AssemblyLinearVelocity, p.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
end

local function setRep(p, v)
	if sethiddenproperty and p and p.Parent then pcall(sethiddenproperty, p, "PhysicsRepRootPart", v) end
end

------------------------------------------------------------------
-- antivoid (turns on when the function starts)
------------------------------------------------------------------
local voidOn = false
local voidPart, voidFollowConn, voidHealthConn, voidCharConn, voidFallenConn
local voidHealth = 100

local function hookVoid(char)
	if not char then return end
	local h = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 3)
	local r = char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 3)
	if not h or not r or not voidOn then return end

	voidHealth = h.Health
	if voidHealthConn then voidHealthConn:Disconnect() voidHealthConn = nil end
	if voidFollowConn then voidFollowConn:Disconnect() voidFollowConn = nil end

	voidFollowConn = RunService.RenderStepped:Connect(function()
		local rr = char:FindFirstChild("HumanoidRootPart")
		if rr and voidPart then
			voidHealth = h.Health
			voidPart.CFrame = CFrame.new(rr.Position.X, -10008, rr.Position.Z)
		end
	end)

	voidHealthConn = h.HealthChanged:Connect(function(hp)
		local rr = char:FindFirstChild("HumanoidRootPart")
		if hp <= 0 and rr and rr.CFrame.Y <= 0 then h.Health = voidHealth end
	end)
end

local function setAntivoid(on)
	if on == voidOn then return end
	voidOn = on

	if on then
		workspace.FallenPartsDestroyHeight = (0/0)
		voidFallenConn = workspace:GetPropertyChangedSignal("FallenPartsDestroyHeight"):Connect(function()
			local v = workspace.FallenPartsDestroyHeight
			if voidOn and v == v then workspace.FallenPartsDestroyHeight = (0/0) end
		end)

		voidPart = Instance.new("Part")
		voidPart.Name = HttpService:GenerateGUID()
		voidPart.CFrame = CFrame.new(0, -10008, 0)
		voidPart.Anchored = true
		voidPart.Size = Vector3.new(2048, 10, 2048)
		voidPart.Transparency = 0.5
		voidPart.CanCollide = true
		voidPart.Parent = workspace

		task.spawn(hookVoid, me.Character)
		voidCharConn = me.CharacterAdded:Connect(function(char)
			task.wait(0.1)
			hookVoid(char)
		end)
	else
		if voidFallenConn then voidFallenConn:Disconnect() voidFallenConn = nil end
		if voidCharConn then voidCharConn:Disconnect() voidCharConn = nil end
		if voidHealthConn then voidHealthConn:Disconnect() voidHealthConn = nil end
		if voidFollowConn then voidFollowConn:Disconnect() voidFollowConn = nil end
		pcall(function() if voidPart then voidPart:Destroy() end end)
		voidPart = nil
		pcall(function() workspace.FallenPartsDestroyHeight = -500 end)
	end
end

------------------------------------------------------------------
-- Child emperor void = the duel farm routine, once
------------------------------------------------------------------
local DUEL_WAIT, DUEL_TIME = 0.4, 0.7
local HOLD_POS, HOLD_TIME  = Vector3.new(0, -501, 0), 0.3
local VOID_POS, VOID_TIME  = Vector3.new(0, -10000, 0), 3
local RETURN_POS           = Vector3.new(0, -500, 0)

local platforms = {}
local function ensurePlatform(pos)
	local key = math.floor(pos.Y + 0.5)
	if platforms[key] and platforms[key].Parent then return end
	local p = Instance.new("Part")
	p.Name = "ChildEmperorPlatform"
	p.Size = Vector3.new(2048, 10, 2048)
	p.Position = Vector3.new(pos.X, pos.Y - 3 - p.Size.Y / 2, pos.Z)
	p.Anchored = true
	p.CanCollide = true
	p.Material = Enum.Material.Glass
	p.Color = Color3.fromRGB(210, 235, 255)
	p.Transparency = 0.55
	p.Parent = workspace
	platforms[key] = p
end

-- slot press that works on PC (keyboard) and mobile (on-screen hotbar button)
local function pressSlot3()
	pcall(function()
		VIM:SendKeyEvent(true, Enum.KeyCode.Three, false, game)
		task.wait(0.05)
		VIM:SendKeyEvent(false, Enum.KeyCode.Three, false, game)
	end)
	pcall(function()
		local btn = me.PlayerGui.Hotbar.Backpack.Hotbar["3"]
		for _, g in ipairs({btn, btn:FindFirstChild("Base")}) do
			if g and g:IsA("GuiButton") then
				for _, sig in ipairs({"MouseButton1Down", "MouseButton1Click", "Activated", "MouseButton1Up"}) do
					if firesignal then pcall(firesignal, g[sig]) end
				end
			end
		end
	end)
end

-- a hotbar slot shows a "Cooldown" child under Base while it is cooling down
local function slot3Ready()
	local ok, ready = pcall(function()
		return me.PlayerGui.Hotbar.Backpack.Hotbar["3"].Base:FindFirstChild("Cooldown") == nil
	end)
	if ok then return ready end
	return true
end

local busy = false
local setStatus = function() end

local function childEmperorVoid()
	if busy then return end
	busy = true
	setAntivoid(true)                      -- auto antivoid when the function starts

	local ok, err = pcall(function()
		local char = me.Character
		local h, r = hum(char), root(char)
		if not h or not r then setStatus("No character") return end

		-- wait for slot 3 to be off cooldown (max 10s)
		local give = tick() + 10
		while not slot3Ready() and tick() < give do
			setStatus("Waiting for slot 3 cooldown ...")
			task.wait(0.05)
		end
		if not slot3Ready() then setStatus("Slot 3 is still on cooldown") return end

		setStatus("Pressing 3 ...")
		pressSlot3()
		task.wait(DUEL_WAIT)

		-- selected players, shuffled
		local queue = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= me and Selected[p.UserId] and root(p.Character) and hum(p.Character) then table.insert(queue, p) end
		end
		for i = #queue, 2, -1 do
			local j = math.random(i)
			queue[i], queue[j] = queue[j], queue[i]
		end
		setStatus("Duel: " .. #queue .. " target(s)")

		local keepVel = true
		task.spawn(function()
			while keepVel do
				local rr = root(me.Character)
				if rr then zero(rr) end
				RunService.Heartbeat:Wait()
			end
		end)

		local beat
		local function unlink()
			if beat then beat:Disconnect() beat = nil end
			setRep(r, nil)
			if r.Parent then
				r.CFrame = CFrame.new(r.Position)
				zero(r)
				pcall(function() h.AutoRotate = true end)
			end
		end

		-- glue: EXACTLY DUEL_TIME seconds in total, the time left is always shared evenly
		local hardEnd = tick() + DUEL_TIME
		for i, target in ipairs(queue) do
			if tick() >= hardEnd then break end
			local tRoot = root(target.Character)
			r = root(me.Character)
			if tRoot and hum(target.Character) and r then
				local slotEnd = tick() + (hardEnd - tick()) / (#queue - i + 1)

				if beat then beat:Disconnect() end
				pcall(function() h.AutoRotate = false end)
				r.CFrame = CFrame.new(0, 0, 5)
				zero(r)
				setRep(r, r)
				setRep(r, tRoot)
				beat = RunService.Heartbeat:Connect(function()
					if not r.Parent or not tRoot.Parent then return end
					r.CFrame = CFrame.new(0, 0, 5)
					zero(r)
					setRep(r, tRoot)
				end)
				while tick() < slotEnd do RunService.Heartbeat:Wait() end
			end
		end
		unlink()
		keepVel = false

		-- stage 1: anchored at -501y for HOLD_TIME, stage 2: at -10000y for VOID_TIME
		local anchorPos = HOLD_POS
		local function pose()
			local rr = root(me.Character)
			if not rr then return end
			zero(rr)
			rr.CFrame = CFrame.new(anchorPos)
		end
		setStatus("Anchored at " .. math.floor(HOLD_POS.Y + 0.5) .. "y")
		ensurePlatform(HOLD_POS)
		pose()
		local poseConn = RunService.Heartbeat:Connect(pose)
		task.wait(HOLD_TIME)

		anchorPos = VOID_POS
		setStatus("Anchored at " .. math.floor(VOID_POS.Y + 0.5) .. "y")
		pose()
		task.wait(VOID_TIME)
		poseConn:Disconnect()

		-- come back at -500y (glass floor there so you don't fall)
		ensurePlatform(RETURN_POS)
		local rr = root(me.Character)
		if rr then
			rr.CFrame = CFrame.new(RETURN_POS)
			zero(rr)
		end
		setStatus("Done")
	end)

	if not ok then setStatus("Error: " .. tostring(err)) end
	busy = false
end

