glueBtn.MouseButton1Click:Connect(function()
	local p = findPlayer(box.Text)
	if not p then
		setStatus("No player found for \"" .. box.Text .. "\"")
		return
	end

	for k in pairs(Selected) do Selected[k] = nil end   -- one target at a time
	Selected[p.UserId] = true
	updateSelected()

	start(p)   -- runs until Stop is pressed
	paintGlue(true)
end)

