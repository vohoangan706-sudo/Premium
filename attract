-- Attractor panel (black + gold): type a name, press Glue, it stays glued until you press Stop.
-- The camera follows the glued player (Spectate toggle); Stop puts it back on you.
-- Survives respawns (yours or the target's), waits if the target leaves and
-- resumes if they rejoin. Safe to re-run: it removes its previous copy first.

if getgenv().GlueStop then pcall(getgenv().GlueStop) end

local Players             = game:GetService("Players")
local RunService          = game:GetService("RunService")
local UserInputService    = game:GetService("UserInputService")
local GuiService          = game:GetService("GuiService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local localPlayer = Players.LocalPlayer

getgenv().SelectedPlayers = getgenv().SelectedPlayers or {}   -- [UserId] = true
local Selected = getgenv().SelectedPlayers

------------------------------------------------------------------
-- whitelist: anyone you are friends with is never targeted
-- (cached, so the glue loop never waits on a web call)
------------------------------------------------------------------
local friendCache = getgenv().WhitelistCache or {}   -- [UserId] = true / false
getgenv().WhitelistCache = friendCache

local function lookupFriend(p)          -- yields (web call): use outside hot loops
	local ok, res = pcall(function() return localPlayer:IsFriendsWith(p.UserId) end)
	if ok then friendCache[p.UserId] = res and true or false end
	return friendCache[p.UserId]         -- nil if the lookup failed
end

local function isWhitelisted(p)         -- never yields
	local v = friendCache[p.UserId]
	if v == nil then
		task.spawn(lookupFriend, p)      -- not known yet: look it up in the background
		return true                      -- and stay safe until we know
	end
	return v
end

for _, p in ipairs(Players:GetPlayers()) do
	if p ~= localPlayer then task.spawn(lookupFriend, p) end
end
local whitelistConn = Players.PlayerAdded:Connect(function(p)
	task.spawn(lookupFriend, p)
end)

------------------------------------------------------------------
-- glue core
------------------------------------------------------------------
local function zero(part)
	part.AssemblyLinearVelocity  = Vector3.zero
	part.AssemblyAngularVelocity = Vector3.zero
	pcall(function() part.Velocity    = Vector3.zero end)
	pcall(function() part.RotVelocity = Vector3.zero end)
end

local function setRep(part, value)
	if sethiddenproperty and part and part.Parent then
		pcall(function() sethiddenproperty(part, "PhysicsRepRootPart", value) end)
	end
end

local active = false
local targetId, targetName = nil, ""
local attachedMy, attachedTheir
local heartbeatConn, rotConn
local lastState
local onState = function() end
local spectateOn = true   -- camera follows the glued player

local function setState(s)
	if s ~= lastState then
		lastState = s
		onState(s)
	end
end

-- detach the physics link only (does not end the session)
local function release()
	if rotConn then rotConn:Disconnect() rotConn = nil end

	setRep(attachedMy, nil)
	setRep(attachedTheir, nil)

	if attachedMy and attachedMy.Parent then
		attachedMy.CFrame = CFrame.new(attachedMy.Position)
		zero(attachedMy)
		local hum = attachedMy.Parent:FindFirstChildOfClass("Humanoid")
		if hum then pcall(function() hum.AutoRotate = true end) end
	end

	attachedMy, attachedTheir = nil, nil
end

-- link your root part to the target's root part
local function attach(a, b, hum)
	release()
	attachedMy, attachedTheir = a, b

	if hum then
		rotConn = RunService.RenderStepped:Connect(function()
			if hum.Parent then pcall(function() hum.AutoRotate = false end) end
		end)
	end

	a.CFrame = CFrame.new(0, 0, 5)
	zero(a)
	setRep(a, a)
	setRep(a, b)
end

-- spectate: we drive the camera CFrame ourselves (Scriptable), re-applied every frame after the
-- game's camera script, because changing CameraSubject alone does not move the camera in this game.
local SPECTATE_DIST = 12
local specPlayer, specBeat, specRender

local function specApply()
	local cam = workspace.CurrentCamera
	if not cam then return end

	local tChar = specPlayer and specPlayer.Character
	local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
	if not tRoot or not tRoot.Parent then
		-- target gone: give the camera back to your own character
		local own = localPlayer.Character and localPlayer.Character:FindFirstChildOfClass("Humanoid")
		if own then
			if cam.CameraType ~= Enum.CameraType.Custom then cam.CameraType = Enum.CameraType.Custom end
			if cam.CameraSubject ~= own then cam.CameraSubject = own end
		end
		return
	end

	local tHum = tChar:FindFirstChildOfClass("Humanoid")
	if tHum and cam.CameraSubject ~= tHum then cam.CameraSubject = tHum end
	if cam.CameraType ~= Enum.CameraType.Scriptable then cam.CameraType = Enum.CameraType.Scriptable end

	local focus = tRoot.Position + Vector3.new(0, 2, 0)
	local pos = focus - tRoot.CFrame.LookVector * SPECTATE_DIST + Vector3.new(0, 5, 0)
	cam.CFrame = CFrame.lookAt(pos, focus)
end

local function unbindSpec()
	pcall(function() RunService:UnbindFromRenderStep("AttractorSpectate") end)
	if specBeat then specBeat:Disconnect() specBeat = nil end
	if specRender then specRender:Disconnect() specRender = nil end
end

local function setSpectate(player)
	if not player or player == localPlayer then return end
	if specPlayer == player and specBeat then return end
	specPlayer = player
	unbindSpec()

	local okBind = pcall(function()
		RunService:BindToRenderStep("AttractorSpectate", 99999, specApply)   -- after everything else
	end)
	if not okBind then specRender = RunService.RenderStepped:Connect(specApply) end
	specBeat = RunService.Heartbeat:Connect(specApply)
	specApply()
end

-- put the camera back on your own character
local function restoreCamera()
	specPlayer = nil
	unbindSpec()

	local cam = workspace.CurrentCamera
	local char = localPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if cam and hum then
		pcall(function()
			cam.CameraSubject = hum
			cam.CameraType = Enum.CameraType.Custom
		end)
	end
end

-- end the session completely (this is what the Stop button does)
local function stop()
	active = false
	targetId = nil
	if heartbeatConn then heartbeatConn:Disconnect() heartbeatConn = nil end
	release()
	restoreCamera()
	lastState = nil
end

-- start gluing to one player and keep going until stop()
local function start(player)
	if not Selected[player.UserId] then return false end   -- selected players only

	stop()
	targetId = player.UserId
	targetName = player.DisplayName .. " (@" .. player.Name .. ")"
	active = true

	heartbeatConn = RunService.Heartbeat:Connect(function()
		if not active then return end

		local target = Players:GetPlayerByUserId(targetId)
		if not target then
			if attachedMy then release() end
			setState("Waiting for " .. targetName .. " to rejoin...")
			return
		end

		local myChar    = localPlayer.Character
		local theirChar = target.Character
		local a   = myChar    and myChar:FindFirstChild("HumanoidRootPart")
		local b   = theirChar and theirChar:FindFirstChild("HumanoidRootPart")
		local hum = myChar    and myChar:FindFirstChildOfClass("Humanoid")

		if not a then
			if attachedMy then release() end
			setState("Waiting for your character...")
			return
		end

		if not b then
			if attachedMy then release() end
			setState("Waiting for " .. targetName .. " to respawn...")
			return
		end

		if a ~= attachedMy or b ~= attachedTheir then
			attach(a, b, hum)          -- first attach, or either of you respawned
		else
			a.CFrame = CFrame.new(0, 0, 5)
			zero(a)
			setRep(a, b)
		end

		if spectateOn then
			setSpectate(target)
		end

		setState("Glued to " .. targetName)
	end)

	return true
end

------------------------------------------------------------------
-- name lookup: exact -> starts with -> contains (username or display name)
------------------------------------------------------------------
local function findPlayer(text)
	text = text:match("^%s*(.-)%s*$"):lower()
	if text == "" then return nil end

	local function search(test)
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= localPlayer then
				if test(p.Name:lower()) or test(p.DisplayName:lower()) then
					return p
				end
			end
		end
	end

	return search(function(n) return n == text end)
		or search(function(n) return n:sub(1, #text) == text end)
		or search(function(n) return n:find(text, 1, true) ~= nil end)
end

------------------------------------------------------------------
-- invisible (taken from the original script)
-- every Heartbeat it plays a frozen animation (71181015443030 at 13.45s,
-- huge weight) and stops it again in RenderStepped; your own body shows at 50%
------------------------------------------------------------------
local invisOn   = false
local invisBusy = false
local invisTrack
local invisBeat, invisCharConn
local dimConns = {}

local function dimPart(part)
	if not part:IsA("BasePart") then return end
	if part.Name == "HumanoidRootPart" then return end
	if part.Transparency == 1 then return end
	if part.Name:lower():find("hitbox") then return end

	part.LocalTransparencyModifier = 0.5
	table.insert(dimConns, part:GetPropertyChangedSignal("LocalTransparencyModifier"):Connect(function()
		if invisOn and part.LocalTransparencyModifier ~= 0.5 then
			part.LocalTransparencyModifier = 0.5
		end
	end))
end

local function dimCharacter(char)
	for _, d in ipairs(char:GetDescendants()) do
		dimPart(d)
	end

	table.insert(dimConns, char.DescendantAdded:Connect(function(d)
		if invisOn then dimPart(d) end
	end))
end

local function stopInvisTrack()
	if invisTrack then
		pcall(function()
			if invisTrack.IsPlaying then invisTrack:Stop() end
			invisTrack:Destroy()
		end)
		invisTrack = nil
	end
end

local function invisStep()
	if not invisOn or invisBusy then return end

	local char = localPlayer.Character
	local hum  = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local animator = hum and hum:FindFirstChildOfClass("Animator")
	if not hum or not root or not animator then return end
	if hum.Health <= 0 then return end

	invisBusy = true

	pcall(function()
		local velocity = root.Velocity

		local anim = Instance.new("Animation")
		anim.AnimationId = "rbxassetid://71181015443030"
		invisTrack = animator:LoadAnimation(anim)
		invisTrack.Priority = Enum.AnimationPriority.Action4
		invisTrack:Play()
		invisTrack:AdjustSpeed(0)
		invisTrack:AdjustWeight(2e9)
		invisTrack.TimePosition = 13.45

		RunService.RenderStepped:Wait()

		stopInvisTrack()
		root.Velocity = velocity
	end)

	invisBusy = false
end

local function setInvisible(on)
	if on == invisOn then return end
	invisOn = on

	if on then
		if localPlayer.Character then dimCharacter(localPlayer.Character) end

		invisCharConn = localPlayer.CharacterAdded:Connect(function(char)
			task.wait(0.1)
			if invisOn then dimCharacter(char) end
		end)

		invisBeat = RunService.Heartbeat:Connect(invisStep)
	else
		if invisBeat then invisBeat:Disconnect() invisBeat = nil end
		if invisCharConn then invisCharConn:Disconnect() invisCharConn = nil end

		for _, c in ipairs(dimConns) do
			pcall(function() c:Disconnect() end)
		end
		dimConns = {}

		stopInvisTrack()

		local char = localPlayer.Character
		if char then
			for _, d in ipairs(char:GetDescendants()) do
				if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
					d.LocalTransparencyModifier = 0
				end
			end
		end
	end
end

------------------------------------------------------------------
-- antivoid (same as the farm panel): no void kill, and a platform under you far below the map
------------------------------------------------------------------
local voidOn = false
local voidPart, voidFollowConn, voidHealthConn, voidCharConn, voidFallenConn
local voidHealth = 100

local function hookVoid(char)
	if not char then return end
	local hum  = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 3)
	local root = char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 3)
	if not hum or not root or not voidOn then return end

	voidHealth = hum.Health

	if voidHealthConn then voidHealthConn:Disconnect() voidHealthConn = nil end
	if voidFollowConn then voidFollowConn:Disconnect() voidFollowConn = nil end

	voidFollowConn = RunService.RenderStepped:Connect(function()
		local r = char:FindFirstChild("HumanoidRootPart")
		if r and voidPart then
			voidHealth = hum.Health
			voidPart.CFrame = CFrame.new(r.Position.X, -10008, r.Position.Z)
		end
	end)

	voidHealthConn = hum.HealthChanged:Connect(function(h)
		local r = char:FindFirstChild("HumanoidRootPart")
		if h <= 0 and r and r.CFrame.Y <= 0 then
			hum.Health = voidHealth
		end
	end)
end

local function setAntivoid(on)
	if on == voidOn then return end
	voidOn = on

	if on then
		workspace.FallenPartsDestroyHeight = (0/0)
		voidFallenConn = workspace:GetPropertyChangedSignal("FallenPartsDestroyHeight"):Connect(function()
			local h = workspace.FallenPartsDestroyHeight
			if voidOn and h == h then
				workspace.FallenPartsDestroyHeight = (0/0)
			end
		end)

		voidPart = Instance.new("Part")
		voidPart.Name = game:GetService("HttpService"):GenerateGUID()
		voidPart.CFrame = CFrame.new(0, -10008, 0)
		voidPart.Anchored = true
		voidPart.Size = Vector3.new(2048, 10, 2048)
		voidPart.Transparency = 0.5
		voidPart.CanCollide = true
		voidPart.Parent = workspace

		task.spawn(hookVoid, localPlayer.Character)
		voidCharConn = localPlayer.CharacterAdded:Connect(function(char)
			task.wait(0.1)
			hookVoid(char)
		end)
	else
		if voidFallenConn then voidFallenConn:Disconnect() voidFallenConn = nil end
		if voidCharConn then voidCharConn:Disconnect() voidCharConn = nil end
		if voidHealthConn then voidHealthConn:Disconnect() voidHealthConn = nil end
		if voidFollowConn then voidFollowConn:Disconnect() voidFollowConn = nil end
		pcall(function() if voidPart then voidPart:Destroy() end end)
		voidPart = nil
		pcall(function() workspace.FallenPartsDestroyHeight = -500 end)
	end
end

------------------------------------------------------------------
-- voidkill: when YOU use an ability (a hotbar slot 1-4 starts its cooldown) while glued:
-- glue off at once > wait VK_WAIT s > anchored at -505y for VK_TIME s > glue again on the same player.
-- Needs antivoid (the void kills at -500y), so turning Voidkill on also turns Antivoid on.
------------------------------------------------------------------
local VK_Y     = -505
local VK_WAIT  = 0.4   -- seconds to wait (glue already off) before anchoring
local VK_TIME  = 2
local voidkillOn = false
local vkBusy = false
local vkPlatform
local vkPrev = {}

local function slotOnCooldown(slot)
	local ok, cd = pcall(function()
		return localPlayer.PlayerGui.Hotbar.Backpack.Hotbar[tostring(slot)].Base:FindFirstChild("Cooldown") ~= nil
	end)
	return ok and cd or false
end

local function ensureVkPlatform()
	if vkPlatform and vkPlatform.Parent then return end
	local pl = Instance.new("Part")
	pl.Name = "GlueVoidkillPlatform"
	pl.Size = Vector3.new(2048, 10, 2048)
	pl.Position = Vector3.new(0, VK_Y - 3 - pl.Size.Y / 2, 0)
	pl.Anchored = true
	pl.CanCollide = true
	pl.Material = Enum.Material.Glass
	pl.Color = Color3.fromRGB(210, 235, 255)
	pl.Transparency = 0.55
	pl.Parent = workspace
	vkPlatform = pl
end

local function voidkillCycle()
	if vkBusy or not active or not targetId then return end
	vkBusy = true

	local target = Players:GetPlayerByUserId(targetId)

	stop()                       -- glue off immediately
	ensureVkPlatform()

	local function pose()
		local r = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
		if not r then return end
		r.AssemblyLinearVelocity  = Vector3.zero
		r.AssemblyAngularVelocity = Vector3.zero
		r.CFrame = CFrame.new(0, VK_Y, 0)
	end
	setState("Voidkill: waiting " .. VK_WAIT .. "s")
	local tw = tick()
	while voidkillOn and tick() - tw < VK_WAIT do
		task.wait(0.02)
	end

	setState("Voidkill: anchored at " .. VK_Y .. "y")
	pose()
	local conn = RunService.Heartbeat:Connect(pose)

	local t0 = tick()
	while voidkillOn and tick() - t0 < VK_TIME do
		task.wait(0.05)
	end
	conn:Disconnect()

	if voidkillOn and target and target.Parent then
		Selected[target.UserId] = true
		start(target)            -- glue again
	end
	vkBusy = false
end

local vkLoopRunning = false
local function setVoidkill(on)
	if on == voidkillOn then return end
	voidkillOn = on

	if on then
		setAntivoid(true)
		for i = 1, 4 do vkPrev[i] = slotOnCooldown(i) end
		if vkLoopRunning then return end
		vkLoopRunning = true
		task.spawn(function()
			while voidkillOn do
				for i = 1, 4 do
					local now = slotOnCooldown(i)
					if now and not vkPrev[i] and active and not vkBusy then
						task.spawn(voidkillCycle)
					end
					vkPrev[i] = now
				end
				task.wait(0.03)
			end
			vkLoopRunning = false
		end)
	else
		pcall(function() if vkPlatform then vkPlatform:Destroy() end end)
		vkPlatform = nil
	end
end

------------------------------------------------------------------
-- Auto hit: non-stop M1 + dash + skills 1-4, same as the farm panel. Only does anything while
-- you are glued to someone (Glue pressed). Does not touch the target: just you attacking.
------------------------------------------------------------------
local AH_DASH_KEY   = Enum.KeyCode.Q
local AH_DASH_EVERY = 2.5
local AH_MOVE_EVERY = 0.6
local AH_SLOTS      = { 1, 2, 3, 4 }
local AH_M1_INTERVAL = 0.05
local AH_M1_EXEC     = true          -- also call the executor's mouse1click if it has one
local AH_FORCE_MOBILE = false
local AH_BUTTON_NAME  = ""           -- exact M1 button name, if auto-detect picks the wrong one

local SLOT_KEYS = { Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four }

local function ahPressKey(code)
	pcall(function()
		VirtualInputManager:SendKeyEvent(true, code, false, game)
		task.wait(0.05)
		VirtualInputManager:SendKeyEvent(false, code, false, game)
	end)
end

-- a hotbar slot shows a "Cooldown" child under Base while it is cooling down
local function ahMoveReady(slot)
	local ok, ready = pcall(function()
		local base = localPlayer.PlayerGui.Hotbar.Backpack.Hotbar[tostring(slot)].Base
		return base:FindFirstChild("Cooldown") == nil
	end)
	if ok then return ready end
	return true   -- hotbar not found: just try it
end

local AH_IS_MOBILE = (UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled) or AH_FORCE_MOBILE

local ahM1Button, ahM1LastScan, ahM1Warned, ahM1Logged = nil, 0, false, nil

local function ahLooksLikeM1(btn)
	local name = btn.Name:lower()
	local text = (btn:IsA("TextButton") and btn.Text or ""):lower()
	if AH_BUTTON_NAME ~= "" then return btn.Name == AH_BUTTON_NAME end
	return name == "m1" or text == "m1"
		or name:find("m1", 1, true) ~= nil
		or name:find("attack", 1, true) ~= nil
		or name:find("punch", 1, true) ~= nil
		or name:find("lmb", 1, true) ~= nil
		or name:find("click", 1, true) ~= nil
end

local function ahFindM1Button()
	if ahM1Button and ahM1Button.Parent then return ahM1Button end
	ahM1Button = nil
	if tick() - ahM1LastScan < 1 then return nil end   -- at most once a second
	ahM1LastScan = tick()

	local pg = localPlayer:FindFirstChild("PlayerGui")
	if not pg then return nil end

	local best, found = nil, 0
	for _, d in ipairs(pg:GetDescendants()) do
		if d:IsA("GuiButton") and ahLooksLikeM1(d) then
			found += 1
			if d.Name:lower() == "m1" then best = d end
			best = best or d
		end
	end

	if best then
		ahM1Button = best
		if ahM1Logged ~= best then
			ahM1Logged = best
			warn("[Attractor] Auto hit M1 button: " .. best:GetFullName() .. "  (" .. found .. " candidate(s))")
		end
	elseif not ahM1Warned then
		ahM1Warned = true
		warn("[Attractor] Auto hit: no M1 button found in PlayerGui - set AH_BUTTON_NAME")
	end
	return ahM1Button
end

local function ahActivateButton(btn)
	local fs = rawget(getgenv(), "firesignal")
	if type(fs) == "function" then
		for _, sig in ipairs({ "MouseButton1Down", "MouseButton1Click", "Activated", "MouseButton1Up" }) do
			pcall(function() fs(btn[sig]) end)
		end
	end
	local gc = rawget(getgenv(), "getconnections")
	if type(gc) == "function" then
		for _, sig in ipairs({ "Activated", "MouseButton1Click", "MouseButton1Down" }) do
			pcall(function()
				for _, c in ipairs(gc(btn[sig])) do pcall(function() c:Fire() end) end
			end)
		end
	end
	if not fs and not gc then
		pcall(function()
			local inset = GuiService:GetGuiInset()
			local sg = btn:FindFirstAncestorOfClass("ScreenGui")
			local dy = (sg and sg.IgnoreGuiInset) and 0 or inset.Y
			local c = btn.AbsolutePosition + btn.AbsoluteSize / 2
			VirtualInputManager:SendTouchEvent(1, 0, c.X, c.Y + dy)
			task.wait(0.03)
			VirtualInputManager:SendTouchEvent(1, 2, c.X, c.Y + dy)
		end)
	end
end

local function ahClick()
	if AH_IS_MOBILE then
		local btn = ahFindM1Button()
		if btn then ahActivateButton(btn) end
		return
	end

	local cam = workspace.CurrentCamera
	local size = cam and cam.ViewportSize or Vector2.new(800, 600)
	local x, y = size.X / 2, size.Y / 2

	pcall(function()
		VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
		task.wait(0.03)
		VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
	end)

	if AH_M1_EXEC then
		local fn = rawget(getgenv(), "mouse1click")
		if type(fn) == "function" then pcall(fn) end
	end
end

local autoHitOn = false
local autoHitRunning = false

local function autoHitLoop()
	if autoHitRunning then return end
	autoHitRunning = true
	local lastDash, lastMove, lastM1, moveIdx = 0, 0, 0, 1

	while autoHitOn do
		if active then   -- only while glued to someone
			if tick() - lastM1 >= AH_M1_INTERVAL then
				lastM1 = tick()
				task.spawn(ahClick)
			end
			if tick() - lastDash >= AH_DASH_EVERY then
				lastDash = tick()
				task.spawn(ahPressKey, AH_DASH_KEY)
			end
			if tick() - lastMove >= AH_MOVE_EVERY then
				lastMove = tick()
				for _ = 1, #AH_SLOTS do
					local slot = AH_SLOTS[moveIdx]
					moveIdx = moveIdx % #AH_SLOTS + 1
					if ahMoveReady(slot) then
						task.spawn(ahPressKey, SLOT_KEYS[slot])
						break
					end
				end
			end
		end
		task.wait(0.03)
	end
	autoHitRunning = false
end

local function setAutoHit(on)
	if on == autoHitOn then return end
	autoHitOn = on
	if on then task.spawn(autoHitLoop) end
end

