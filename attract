local function mkButton(text, right, y)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(0.5, -18, 0, 30)
	b.Position = right and UDim2.new(0.5, 6, 0, y) or UDim2.new(0, 12, 0, y)
	b.BackgroundColor3 = FILL
	b.BorderSizePixel = 0
	b.Font = FONT
	b.TextSize = 14
	b.TextColor3 = GOLD
	b.Text = text
	b.AutoButtonColor = true
	b.Parent = main
	round(b, 6)
	return b
end

local function paintToggle(btn, label, on)
	btn.Text = label .. (on and ": ON" or ": OFF")
	btn.TextSize = 13
	btn.BackgroundColor3 = on and FILL_ON or FILL
	btn.TextColor3 = on and BG or GOLD
end

